---
/*
 * Security. A dark hero, then light and dark sections that alternate (HERO-REVISION.md whole-page rule).
 * Section ids (other pages link to them): #data-flow, #outbound, #controls (#controls-access,
 * -oversight, -transport, -integrations), #hardening, #in-development, #not-claimed, #report.
 * No "On this page" rail or sticky table of contents (owner, 2026-09-27: it overlapped the sections).
 * Every section uses the full content width on the one site gutter, so the page reads as one column
 * structure with even padding.
 */
import Base from "../layouts/Base.astro";
import { PAGES } from "../data/site";
import SecurityHero from "../components/sections/security/SecurityHero.astro";
import DataFlow from "../components/sections/security/DataFlow.astro";
import OutboundConnections from "../components/sections/security/OutboundConnections.astro";
import ControlsToday from "../components/sections/security/ControlsToday.astro";
import Hardening from "../components/sections/security/Hardening.astro";
import InDevelopment from "../components/sections/security/InDevelopment.astro";
import NotClaimed from "../components/sections/security/NotClaimed.astro";
import ReportVulnerability from "../components/sections/security/ReportVulnerability.astro";
---

<Base title={PAGES.security.title} description={PAGES.security.description}>
  <SecurityHero />
  <DataFlow />
  <OutboundConnections />
  <ControlsToday />
  <Hardening />
  <InDevelopment />
  <NotClaimed />
  <ReportVulnerability />
</Base>

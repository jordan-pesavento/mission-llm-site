---
/*
 * Download. Owned by package C. Every Download button on the site points here.
 * Site v2 system (reference: anythingllm.com): a washed hero with the platform row (the reference's
 * step columns), then light sections separated by the reference's dotted rule. The code blocks are
 * the page's navy surfaces; there is no dark band.
 * Order: hero with the platform chooser (server today, desktop apps coming soon), install options
 * (#options; Build from source first, #p-source), system requirements (#requirements), after you
 * install (#after-install). Checksums and signatures are promised only "with the first release".
 */
import Base from "../layouts/Base.astro";
import { PAGES } from "../data/site";
import DownloadHero from "../components/sections/download/DownloadHero.astro";
import InstallOptions from "../components/sections/download/InstallOptions.astro";
import SystemRequirements from "../components/sections/download/SystemRequirements.astro";
import AfterInstall from "../components/sections/download/AfterInstall.astro";
---

<Base title={PAGES.download.title} description={PAGES.download.description}>
  <DownloadHero />
  <InstallOptions />
  <SystemRequirements />
  <AfterInstall />
</Base>

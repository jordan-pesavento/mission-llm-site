---
/*
 * Download. Owned by work package C (may reorder or wrap sections). The page stays light;
 * its code blocks are the navy surfaces. Every Download button on the site points here.
 * Order: hero with the platform chooser (server today, desktop apps coming soon), install
 * options (Build from source first), system requirements, after you install.
 * Verification (checksums, signatures) is promised in the chooser's footnote for the first release.
 */
import Base from "../layouts/Base.astro";
import { PAGES } from "../data/site";
import DownloadHero from "../components/sections/download/DownloadHero.astro";
import InstallOptions from "../components/sections/download/InstallOptions.astro";
import SystemRequirements from "../components/sections/download/SystemRequirements.astro";
import AfterInstall from "../components/sections/download/AfterInstall.astro";
---

<Base title={PAGES.download.title} description={PAGES.download.description}>
  <DownloadHero />
  <InstallOptions />
  <SystemRequirements />
  <AfterInstall />
</Base>

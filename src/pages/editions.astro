---
/*
 * Editions. Owned by package C. No prices: pricing is not decided.
 * Site v2 system (reference: anythingllm.com): a washed hero that runs straight into the two edition
 * cards, then the comparison (#compare) and questions (#questions) on the page's heading rail.
 * Card id: #plans.
 */
import Base from "../layouts/Base.astro";
import { PAGES } from "../data/site";
import EditionsHero from "../components/sections/editions/EditionsHero.astro";
import EditionCards from "../components/sections/editions/EditionCards.astro";
import Comparison from "../components/sections/editions/Comparison.astro";
import EditionsFaq from "../components/sections/editions/EditionsFaq.astro";
---

<Base title={PAGES.editions.title} description={PAGES.editions.description}>
  <EditionsHero />
  <EditionCards />
  <Comparison />
  <EditionsFaq />
</Base>

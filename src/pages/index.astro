---
/*
 * Home (redesign, DESIGN-SPEC revision 3 + HERO-REVISION.md). One component per section, in order.
 * Whole-page tone alternates so no two adjacent full-bleed sections share a tone and there is never a
 * white-on-white or navy-on-navy seam (HERO-REVISION.md, third pass):
 *   Hero DARK, FeaturesProduct LIGHT, GroundedBand DARK, FeaturesSecurity LIGHT, Steps DARK,
 *   DeployBand LIGHT, Resources DARK, OpenSource LIGHT, FinalCta DARK, then Footer LIGHT.
 * The hero fills the viewport (min-height 100svh - nav) so on desktop first load only the hero shows.
 * The centered four-number stats band is gone (HERO-REVISION.md 2b); the "Runs with" strip lives
 * inside the hero on its navy tone (2c), so the reference's proof row is folded into Hero and there is
 * no separate Works/Stats section.
 * The page closes on the dark Final CTA, so the footer is LIGHT (footerTone="light", HERO-REVISION.md
 * item 10): the dark mark-slab moment stays, and the seam below it is a clean dark-to-light edge, not
 * two adjacent darks.
 */
import Base from "../layouts/Base.astro";
import { PAGES } from "../data/site";
import Hero from "../components/sections/home/Hero.astro";
import FeaturesProduct from "../components/sections/home/FeaturesProduct.astro";
import GroundedBand from "../components/sections/home/GroundedBand.astro";
import FeaturesSecurity from "../components/sections/home/FeaturesSecurity.astro";
import Steps from "../components/sections/home/Steps.astro";
import DeployBand from "../components/sections/home/DeployBand.astro";
import Resources from "../components/sections/home/Resources.astro";
import OpenSource from "../components/sections/home/OpenSource.astro";
import FinalCta from "../components/sections/home/FinalCta.astro";
---

<Base title={PAGES.home.title} description={PAGES.home.description} footerTone="light">
  <Hero />
  <FeaturesProduct />
  <GroundedBand />
  <FeaturesSecurity />
  <Steps />
  <DeployBand />
  <Resources />
  <OpenSource />
  <FinalCta />
</Base>

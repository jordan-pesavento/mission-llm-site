---
/*
 * Home. Section order follows the design brief page flow. Frozen for section builders:
 * packages A (Hero, ProofStrip, ProductTour, GroundedAnswers) and B (DeployAnywhere,
 * SecurityControl, OpenSourceFoundation, FinalCta) edit only their own section files.
 * Tone sequence: light, light, light, DARK, light, silver, light, DARK + dark footer.
 */
import Base from "../layouts/Base.astro";
import { PAGES } from "../data/site";
import Hero from "../components/sections/home/Hero.astro";
import ProofStrip from "../components/sections/home/ProofStrip.astro";
import ProductTour from "../components/sections/home/ProductTour.astro";
import GroundedAnswers from "../components/sections/home/GroundedAnswers.astro";
import DeployAnywhere from "../components/sections/home/DeployAnywhere.astro";
import SecurityControl from "../components/sections/home/SecurityControl.astro";
import OpenSourceFoundation from "../components/sections/home/OpenSourceFoundation.astro";
import FinalCta from "../components/sections/home/FinalCta.astro";
---

<Base title={PAGES.home.title} description={PAGES.home.description}>
  <Hero />
  <ProofStrip />
  <ProductTour />
  <GroundedAnswers />
  <DeployAnywhere />
  <SecurityControl />
  <OpenSourceFoundation />
  <FinalCta />
</Base>

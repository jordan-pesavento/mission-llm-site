---
/*
 * Container: the one content width (.wrap): the window less the fluid gutter on each side, capped at
 * 1920 (120rem). Every section, the header row and the footer use it, so everything shares one left
 * edge. Backgrounds stay full-bleed on the element around it.
 * Usage: <Container> ... </Container>  or  <Container as="nav" class="split split--band"> ... </Container>
 */
interface Props {
  as?: "div" | "nav" | "header" | "footer" | "article" | "aside";
  class?: string;
  [key: string]: unknown;
}
const { as: Tag = "div", class: className, ...rest } = Astro.props;
---

<Tag class:list={["wrap", className]} {...rest}><slot /></Tag>

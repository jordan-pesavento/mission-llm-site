---
/*
 * SectionIntro: eyebrow, heading and paragraph (.intro in global.css: 12px apart; whatever follows
 * the intro sits --gap-intro below it).
 * - eyebrow: the accent line above the heading.
 * - title, id: the heading and its id (pass the id to <Section labelledby>).
 * - level: 2 (default, .h2 at --fs-h2, 40ch max), 1 (inner-page H1, .h1-page) or 3.
 * - lead: one paragraph under the heading (--fs-body in the secondary color, --measure wide; with
 *   level 1 it is a .lead). More content can go in the default slot.
 * - srOnly: keep the heading for screen readers and the outline, hide it visually.
 * - size, align: v2 props. size is ignored (one H2 size); align "center" still centers, but the
 *   redesign is left-aligned everywhere.
 * Usage: <SectionIntro eyebrow="Who it's for" title="Built for classrooms. Ready for teams." id="product-title" />
 */
interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
  id?: string;
  level?: 1 | 2 | 3;
  size?: "h2" | "lg" | "cta";
  align?: "left" | "center";
  srOnly?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { title, eyebrow, lead, id, level = 2, align = "left", srOnly = false, size: _size, class: className, ...rest } = Astro.props;
const Heading = `h${level}` as "h1" | "h2" | "h3";
const headingClass = level === 1 ? "h1-page" : level === 3 ? "h3" : "h2";
---

{
  srOnly ? (
    <Heading id={id} class="sr-only">
      {title}
    </Heading>
  ) : (
    <div class:list={["intro", { "intro--center": align === "center" }, className]} {...rest}>
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <Heading id={id} class:list={[headingClass, "intro__title"]}>
        {title}
      </Heading>
      {lead && <p class:list={[level === 1 ? "lead" : "body-muted", "intro__lead"]}>{lead}</p>}
      <slot />
    </div>
  )
}

<style>
  .intro--center {
    justify-items: center;
    text-align: center;
  }
</style>

---
/*
 * Screenshot: a product image in the reference's frame. On light sections radius 16 with one soft,
 * centered navy-tinted shadow and no ring; in dark bands a flat radius-8 window with a 1px edge.
 * The image is ALWAYS shown whole: the frame takes the file's own aspect ratio, so nothing is
 * cropped, bled off an edge or covered.
 * Sources: public/images/product/<name>.png, listed in scripts/image-sources.mjs (placeholders until
 * the real captures replace them under the same names). AVIF and WebP variants are generated at build.
 *
 * - name: hero | feature-documents | feature-agents | feature-models | feature-workspaces |
 *         feature-users | grounded | security | deploy
 * - alt: what the image shows. Describe the real capture; never describe features the product lacks.
 * - sizes: the rendered width for srcset selection. Defaults to the reference width at 1440.
 * - priority: the hero image only (eager, high fetch priority, preloaded).
 * - caption: optional line under the frame (16px, muted).
 * - label: optional small uppercase label above the frame's right edge (the hero's
 *   "ON-DEVICE AI THAT WORKS" pattern). Rendered as text, 14px uppercase, right-aligned, 20px above.
 * Usage: <Screenshot name="hero" priority label="Private AI that runs on your network" alt="..." />
 */
import manifest from "../../data/images.generated.json";

type Variant = { width: number; avif: string; webp: string };
type Img = { width: number; height: number; variants: Variant[] };
type Name = keyof typeof manifest;

interface Props {
  name: Name;
  alt: string;
  sizes?: string;
  priority?: boolean;
  caption?: string;
  label?: string;
  class?: string;
}

const { name, alt, sizes, priority = false, caption, label, class: className } = Astro.props;
const img = (manifest as unknown as Record<string, Img>)[name];
if (!img) throw new Error(`Screenshot "${String(name)}" is not in src/data/images.generated.json. Run npm run images.`);
if (!img.variants.length) throw new Error(`Screenshot "${String(name)}" has no variants.`);

// At 1440 the reference shows the hero at 867px and feature images at 714px; they grow to 891 and
// 734 at 1920 and fill the content width (viewport minus 48px) below 1024.
const wide = name === "hero" ? 891 : 734;
const vw = name === "hero" ? 61 : 51;
const autoSizes = `(min-width: 1476px) ${wide}px, (min-width: 1024px) ${vw}vw, calc(100vw - 48px)`;
const srcSizes = sizes ?? autoSizes;
const srcset = (fmt: "avif" | "webp") => img.variants.map((v) => `${v[fmt]} ${v.width}w`).join(", ");
const fallback = img.variants.find((v) => v.width >= img.width * 2) ?? img.variants[img.variants.length - 1];
---

{priority && <link rel="preload" as="image" type="image/avif" imagesrcset={srcset("avif")} imagesizes={srcSizes} fetchpriority="high" />}
<figure class:list={["shot", className]}>
  {label && <p class="label shot__label">{label}</p>}
  <div class="shot__frame" style={`aspect-ratio: ${img.width} / ${img.height}`}>
    <picture>
      <source type="image/avif" srcset={srcset("avif")} sizes={srcSizes} />
      <source type="image/webp" srcset={srcset("webp")} sizes={srcSizes} />
      <img
        src={fallback.webp}
        width={img.width}
        height={img.height}
        alt={alt}
        loading={priority ? "eager" : "lazy"}
        decoding={priority ? "sync" : "async"}
        fetchpriority={priority ? "high" : undefined}
      />
    </picture>
  </div>
  {caption && <figcaption class="shot__caption">{caption}</figcaption>}
</figure>

<style>
  .shot {
    min-width: 0;
    margin: 0;
  }
  .shot__label {
    margin-bottom: var(--space-5);
    text-align: right;
  }
  :global([data-tone="dark"]) .shot__label {
    color: var(--band-text-muted);
  }
  .shot__frame {
    position: relative;
    width: 100%;
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-shot);
    overflow: hidden;
  }
  /* In dark bands the capture is a flat window, as the reference's Meeting band image: radius 8, a
     1px edge (--shadow-shot-dark) and no drop shadow, on the band's own tone. The capture carries
     its own window chrome. */
  :global([data-tone="dark"]) .shot__frame {
    border-radius: var(--radius-sm);
    background: var(--color-bg);
  }
  .shot__frame picture,
  .shot__frame img {
    display: block;
    width: 100%;
    height: 100%;
  }
  .shot__caption {
    margin-top: var(--space-4);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-quiet);
  }
</style>

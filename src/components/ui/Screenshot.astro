---
/*
 * Screenshot: a product capture shown WHOLE inside a frame (HERO-REVISION.md item E, which overrides
 * DESIGN-SPEC section 7's crop tiers). The entire captured screen is visible at every size, never
 * cropped so UI is cut off, never distorted, never letterboxed: the frame takes the capture's own
 * aspect ratio and the image is object-fit: contain inside it, so its aspect is always preserved and
 * the whole screen reads. Captures are 16:9.43-ish app windows (~1.712 aspect); all captures share it,
 * so a set that swaps in one box (the audience accordion) never changes height.
 *
 * - name: hero | feature-documents | feature-agents | feature-models | feature-workspaces |
 *         feature-users | grounded | security | security-offline | security-roles |
 *         security-history | security-telemetry (public/images/product, scripts/image-sources.mjs)
 * - alt: what the capture shows. Describe the real capture; never features the product lacks.
 * - frame / frameBelow: the frame's rendered width as CSS lengths for srcset selection, from 1024 and
 *   below 1024 (defaults "50vw" and "100vw - 32px"). Give the real rendered width so the browser picks
 *   a sharp variant; it only affects which file is fetched, not the fit.
 * - crop / cropSm / cropMid: accepted for source compatibility but no longer change what is shown (the
 *   whole capture is always shown). Kept so existing callers do not break; safe to drop.
 * - priority: the first screenful only (eager, high fetch priority, preloaded).
 * - caption: a 16px line under the frame. label: a 15px uppercase label above it.
 * - frameClass: extra classes on the frame (for example to cap its width).
 * The frame exposes --w and --h (the capture's natural pixels), so a section can size the frame by its
 * aspect, e.g. max-width: calc(availableHeight * var(--w) / var(--h)).
 * Usage: <Screenshot name="feature-users" alt="..." frame="45vw" />
 */
import manifest from "../../data/images.generated.json";

type Variant = { width: number; avif: string; webp: string };
type Img = { width: number; height: number; variants: Variant[] };
type Name = keyof typeof manifest;
export type Crop = { x: number; y: number; w: number; h: number };

interface Props {
  name: Name;
  alt: string;
  crop?: Crop;
  cropSm?: Crop;
  cropMid?: Crop;
  frame?: string;
  frameBelow?: string;
  priority?: boolean;
  caption?: string;
  label?: string;
  class?: string;
  frameClass?: string;
  [key: string]: unknown;
}

const {
  name,
  alt,
  crop: _crop,
  cropSm: _cropSm,
  cropMid: _cropMid,
  frame = "50vw",
  frameBelow = "100vw - 32px",
  priority = false,
  caption,
  label,
  class: className,
  frameClass,
  ...rest
} = Astro.props;
const img = (manifest as unknown as Record<string, Img>)[name];
if (!img) throw new Error(`Screenshot "${String(name)}" is not in src/data/images.generated.json. Run npm run images.`);
if (!img.variants.length) throw new Error(`Screenshot "${String(name)}" has no variants.`);

// The whole capture is shown, so the frame width is the rendered frame length directly (no crop scale).
const sizes = [`(max-width: 1023px) calc(${frameBelow})`, `calc(${frame})`].join(", ");

const srcset = (fmt: "avif" | "webp") => img.variants.map((v) => `${v[fmt]} ${v.width}w`).join(", ");
const largest = img.variants[img.variants.length - 1];
// The capture's natural pixels: the frame takes this aspect, and sections can size by it (--w / --h).
const fileW = largest.width;
const fileH = Math.round((img.height / img.width) * fileW);
const style = `--w: ${fileW}; --h: ${fileH}`;
---

{priority && <link rel="preload" as="image" type="image/avif" imagesrcset={srcset("avif")} imagesizes={sizes} fetchpriority="high" />}
<figure class:list={["shot", className]} {...rest}>
  {label && <p class="label shot__label">{label}</p>}
  <div class:list={["frame", frameClass]} style={style}>
    <picture>
      <source type="image/avif" srcset={srcset("avif")} sizes={sizes} />
      <source type="image/webp" srcset={srcset("webp")} sizes={sizes} />
      <img
        src={largest.webp}
        width={fileW}
        height={fileH}
        alt={alt}
        loading={priority ? "eager" : "lazy"}
        decoding={priority ? "sync" : "async"}
        fetchpriority={priority ? "high" : undefined}
      />
    </picture>
  </div>
  {caption && <figcaption class="shot__caption">{caption}</figcaption>}
</figure>

<style>
  .shot {
    min-width: 0;
    margin: 0;
  }
  .shot__label {
    margin-bottom: var(--space-4);
  }
  .shot__caption {
    margin-top: var(--space-4);
    font-size: 1rem;
    line-height: 1.5;
    color: var(--color-text-quiet);
  }
</style>

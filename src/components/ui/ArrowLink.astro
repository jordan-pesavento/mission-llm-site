---
/*
 * ArrowLink: a text link with a trailing arrow ("How your data flows ->"). 600 weight in the heading
 * color (navy on light, white in dark bands); the words underline and the arrow nudges 3px on hover.
 * Renders the global .arrow class, so plain markup may use it too:
 *   <a class="arrow" href="..."><span>Label</span><svg .../></a>
 * - icon: "arrow" (default) or "arrow-up-right" for links that leave the site (rel="noopener").
 * - variant: v2 prop ("strong" | "underline"); both render the same now.
 * Usage: <ArrowLink href="/security#data-flow">How your data flows</ArrowLink>
 */
import Icon from "./Icon.astro";

interface Props {
  href: string;
  variant?: "strong" | "underline";
  icon?: "arrow" | "arrow-right" | "arrow-up-right";
  class?: string;
  [key: string]: unknown;
}
const { href, icon = "arrow", variant: _variant, class: className, ...rest } = Astro.props;
const external = /^https?:\/\//.test(href);
const glyph = icon === "arrow-up-right" ? "arrow-up-right" : "arrow";
---

<a href={href} class:list={["arrow", className]} rel={external ? "noopener" : undefined} {...rest}
  ><span><slot /></span><Icon set="line" name={glyph} size={18} /></a
>

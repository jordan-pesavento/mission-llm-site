---
/*
 * Section: one full-bleed band of a page. Content sits in .wrap (Container) unless contain={false}.
 * - tone: "light" (default, the mist-50 page) or "dark" (navy-950; every semantic token is remapped,
 *   so the primitives adapt, and the nav switches to its light skin over it). Never place two dark
 *   bands next to each other.
 * - pad: "y" (default: --pad-y top and bottom, 48 to 128px with the viewport's width and height),
 *   "hero" (inner-page heroes and the contact page: --pad-hero-top above, --pad-y below),
 *   "flush-top" (no top padding), "none". The v2 names (section, feature, band, band-sm, stats, cta,
 *   strip) all mean "y".
 * - rule: a 1px hairline across the top (full bleed). divider: a hairline at the bottom, content width.
 * - labelledby: id of the section heading. label: aria-label when there is no visible heading.
 * - wash, hairline: v2 props. wash is ignored (plain ground everywhere); hairline is rule.
 * Usage: <Section id="product" labelledby="product-title"> ... </Section>
 */
import Container from "./Container.astro";

interface Props {
  id?: string;
  tone?: "light" | "dark" | "silver";
  pad?: "y" | "hero" | "flush-top" | "none" | "section" | "feature" | "band" | "band-sm" | "stats" | "cta" | "strip";
  rule?: boolean;
  divider?: boolean;
  wash?: boolean;
  hairline?: boolean;
  contain?: boolean;
  labelledby?: string;
  label?: string;
  as?: "section" | "div" | "aside";
  class?: string;
  [key: string]: unknown;
}

const {
  id,
  tone = "light",
  pad = "y",
  rule = false,
  divider = false,
  wash: _wash,
  hairline = false,
  contain = true,
  labelledby,
  label,
  as: Tag = "section",
  class: className,
  ...rest
} = Astro.props;
const padClass = pad === "hero" || pad === "flush-top" || pad === "none" ? pad : "y";
---

<Tag
  id={id}
  data-tone={tone === "dark" ? "dark" : "light"}
  aria-labelledby={labelledby}
  aria-label={label}
  class:list={[
    "section",
    padClass !== "none" && `section--pad-${padClass}`,
    { "section--rule": rule || hairline, "section--divider": divider },
    className,
  ]}
  {...rest}
>
  {contain ? <Container><slot /></Container> : <slot />}
</Tag>

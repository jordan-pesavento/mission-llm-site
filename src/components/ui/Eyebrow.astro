---
/*
 * Eyebrow: the short sentence-case line above a heading, in the accent (#2B63E0 on light, #5B95FF in
 * dark bands), Plus Jakarta Sans 600 at --fs-eyebrow (16 to 19px). SectionIntro renders it for you.
 * - quiet: v2 prop, ignored (every eyebrow is accent).
 * Usage: <Eyebrow>Grounded answers</Eyebrow>
 */
interface Props {
  quiet?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { quiet: _quiet, class: className, ...rest } = Astro.props;
---

<p class:list={["eyebrow", className]} {...rest}><slot /></p>

---
/*
 * FeatureAccordion: the reference's feature block. A product screenshot on the left and an
 * accordion on the right (11fr | 9fr, 94px gap from 1024, vertically centered); opening an item
 * swaps the screenshot with a short crossfade. One item is open at a time and one is always open,
 * so the picture always matches the text. Below 1024 the screenshot sits above the list (reference
 * phone layout). Place it after a SectionIntro; it carries the H2-to-content gap (48 to 58px).
 *
 * Rows: Clash Display 500 18/24 titles, 60px tall, 1px mist-300 separators, a 12px mist-700 chevron
 * that flips when open. The open item shows 16/24 body text (max 448px; keep it to two lines at 1440
 * so the section holds the reference's 800px) and an optional underlined 14px "Learn more" link with
 * its arrow 10px after the words.
 *
 * - id: unique prefix for this instance (element ids and aria wiring).
 * - items: { id, title, body, html?, link?: { href, label }, image: { name, alt } }[]. Each item needs
 *   its own image (a real capture of that feature). Keep 3 to 5 items. body is plain text; set html
 *   (trusted, build-time markup such as a <code> chip) to render the body as markup instead.
 * - label: accessible name for the list (for example "Product features").
 * - reverse: accordion on the left, screenshot on the right (from 1024 only).
 * - initial: index of the item open on load (default 0).
 * - flush: drop the top margin (when nothing sits above it).
 *
 * Accessibility: each title is an <h3> holding a <button aria-expanded aria-controls>; closed panels
 * are inert. Without JS every panel is open and the first screenshot shows.
 * Usage:
 *   <FeatureAccordion id="product-acc" label="Product features" items={[
 *     { id: "documents", title: "Document knowledge", body: "...", link: { href: "/security", label: "Learn more about ..." },
 *       image: { name: "feature-documents", alt: "..." } }, ...]} />
 */
import Screenshot from "./Screenshot.astro";
import ArrowLink from "./ArrowLink.astro";
import Icon from "./Icon.astro";
import type manifest from "../../data/images.generated.json";

type ImageName = keyof typeof manifest;
export type AccordionItem = {
  id: string;
  title: string;
  body: string;
  html?: string;
  link?: { href: string; label: string };
  image: { name: ImageName; alt: string };
};

interface Props {
  id: string;
  items: AccordionItem[];
  label: string;
  reverse?: boolean;
  initial?: number;
  flush?: boolean;
  class?: string;
}

const { id, items, label, reverse = false, initial = 0, flush = false, class: className } = Astro.props;
if (!items.length) throw new Error("FeatureAccordion: items is empty");
const open = Math.min(Math.max(initial, 0), items.length - 1);
---

<div
  class:list={["facc", "split", "split--feature", { "facc--reverse": reverse, "facc--flush": flush }, className]}
  data-facc
  data-initial={open}
>
  <div class="facc__media">
    {
      items.map((item, i) => (
        <div class="facc__shot" data-facc-media={item.id} data-active={i === open ? "" : undefined} aria-hidden={i === open ? undefined : "true"}>
          <Screenshot name={item.image.name} alt={item.image.alt} />
        </div>
      ))
    }
  </div>
  <div class="facc__list" role="group" aria-label={label}>
    {
      items.map((item, i) => (
        <div class="facc__item">
          <h3 class="facc__heading">
            <button
              type="button"
              class="facc__trigger"
              id={`${id}-${item.id}-t`}
              aria-expanded={i === open ? "true" : "false"}
              aria-controls={`${id}-${item.id}-p`}
              data-facc-trigger={item.id}
            >
              <span class="facc__title">{item.title}</span>
              <Icon name="caret-down" size={17} weight="bold" class="facc__chevron" />
            </button>
          </h3>
          <div
            class="facc__panel"
            id={`${id}-${item.id}-p`}
            role="region"
            aria-labelledby={`${id}-${item.id}-t`}
            data-open={i === open ? "" : undefined}
          >
            <div class="facc__panel-inner">
              <div class="facc__panel-body">
                {item.html ? <p class="facc__text" set:html={item.html} /> : <p class="facc__text">{item.body}</p>}
                {item.link && (
                  <p class="facc__link">
                    <ArrowLink href={item.link.href} variant="underline">
                      {item.link.label}
                    </ArrowLink>
                  </p>
                )}
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>("[data-facc]")) {
    const triggers = [...root.querySelectorAll<HTMLButtonElement>("[data-facc-trigger]")];
    const shots = [...root.querySelectorAll<HTMLElement>("[data-facc-media]")];
    const panels = triggers.map((t) => document.getElementById(t.getAttribute("aria-controls") || ""));
    const set = (index: number) => {
      triggers.forEach((t, j) => {
        const on = j === index;
        t.setAttribute("aria-expanded", String(on));
        const panel = panels[j];
        if (panel) {
          panel.toggleAttribute("data-open", on);
          panel.inert = !on;
        }
      });
      shots.forEach((s, j) => {
        const on = j === index;
        s.toggleAttribute("data-active", on);
        if (on) s.removeAttribute("aria-hidden");
        else s.setAttribute("aria-hidden", "true");
      });
    };
    triggers.forEach((t, i) => t.addEventListener("click", () => set(i)));
    set(Number(root.dataset.initial) || 0);
  }
</script>

<style>
  .facc {
    --split-stack-gap: 3.5rem;
    margin-top: var(--gap-h2-content);
  }
  .facc--flush {
    margin-top: 0;
  }
  @media (min-width: 1024px) {
    .facc--reverse {
      grid-template-columns: minmax(0, 9fr) minmax(0, 11fr);
    }
    .facc--reverse .facc__media {
      order: 2;
    }
  }

  /* Screenshots stack in one cell; only the active one shows. */
  .facc__media {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
  }
  .facc__shot {
    grid-area: 1 / 1;
    min-width: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--dur-swap) var(--ease-out),
      visibility 0s linear var(--dur-swap);
  }
  .facc__shot[data-active] {
    opacity: 1;
    visibility: visible;
    transition:
      opacity var(--dur-swap) var(--ease-out),
      visibility 0s;
  }

  .facc__list {
    min-width: 0;
  }
  .facc__item {
    border-bottom: 1px solid var(--color-line);
  }
  .facc__heading {
    font: inherit;
  }
  .facc__trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    width: 100%;
    min-height: 60px;
    padding-block: 18px;
    text-align: left;
    color: var(--color-heading);
  }
  .facc__title {
    font-family: var(--font-display);
    font-size: var(--fs-acc);
    line-height: var(--lh-acc);
    font-weight: var(--fw-acc);
  }
  .facc__trigger :global(.facc__chevron) {
    flex: none;
    color: var(--mist-700);
    transition: transform var(--dur-swap) var(--ease-out);
  }
  :global([data-tone="dark"]) .facc__trigger :global(.facc__chevron) {
    color: var(--color-heading);
  }
  .facc__trigger[aria-expanded="true"] :global(.facc__chevron) {
    transform: rotate(180deg);
  }
  .facc__trigger:hover .facc__title {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .facc__trigger:focus-visible {
    outline-offset: 4px;
  }

  /* Panels: open without JS; with JS closed panels collapse (grid rows 0fr to 1fr). */
  .facc__panel {
    display: grid;
    grid-template-rows: 1fr;
  }
  :global(.js) .facc__panel {
    grid-template-rows: 0fr;
    transition: grid-template-rows var(--dur-swap) var(--ease-out);
  }
  :global(.js) .facc__panel[data-open] {
    grid-template-rows: 1fr;
  }
  .facc__panel-inner {
    min-height: 0;
    overflow: hidden;
  }
  .facc__panel-body {
    padding-bottom: var(--space-6);
  }
  .facc__text {
    max-width: 28rem;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text);
  }
  .facc__link {
    margin-top: var(--space-4);
  }
  /* Reference: "Learn more about ..." is 14/20 500 in ink, underlined, the arrow 10px after it. */
  .facc__link :global(.arrow-link) {
    gap: 10px;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
  }
  .facc__link :global(.arrow-link__icon) {
    width: 14px;
    height: 14px;
  }
</style>

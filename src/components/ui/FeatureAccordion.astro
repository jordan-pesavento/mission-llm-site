---
/*
 * FeatureAccordion: product frames beside an accordion (DESIGN-SPEC sections 2, 6 and 7). One item
 * is always open; opening another crossfades the frame (220ms opacity) and swaps the panel.
 *
 * Layout: below 1024 the frame sits above the list. From 1024 it is a two-track layout, not fixed
 * spans: the frame takes 7 columns or the width whose height fits under the nav (the viewport less
 * the nav and the section padding, times the crops' aspect), whichever is smaller, and the list starts
 * two column gaps after the frame's right edge, so a narrowed frame never leaves a dead gap. The two
 * are centered on each other.
 * Rows: at least 60px, Clash Display 500 at --fs-h4, a plus that turns into a minus (accent when open).
 *
 * - id: unique prefix for this instance (element ids and aria wiring).
 * - items: { id, title, body, html?, link?: { href, label }, image: { name, alt, crop?, cropSm? } }[].
 *   Each item shows its own capture. Give every crop in one accordion the same aspect (the audience
 *   crops share 1.9), so the frame box never changes height.
 * - label: accessible name of the list ("What it's for").
 * - anchors: an id prefix. Renders one empty jump target per item (<prefix><item id>) at the top of
 *   the block, so a link to "#for-students" scrolls the whole pair under the nav (not the section
 *   heading) and opens that item: on load, on hashchange and on a click of the same hash. The header's
 *   audience menu links to /#for-<id> (src/data/site.ts AUDIENCES).
 * - aspect: the crops' width over height, for the fit rule (default: the first item's crop).
 * - frame: the frame's width from 1024 as a CSS length, for srcset (default "45vw").
 * - reverse: the list on the left, the frame on the right (from 1024).
 * - initial: index of the item open on load (default 0). flush: no top margin.
 *
 * Accessibility: each title is an <h3> holding a <button aria-expanded aria-controls>; closed panels
 * are hidden. Without JS every panel is open and the first frame shows (src/scripts/accordion.ts).
 * Usage: <FeatureAccordion id="product-acc" label="What it's for" anchors="for-" items={[...]} />
 */
import Screenshot, { type Crop } from "./Screenshot.astro";
import ArrowLink from "./ArrowLink.astro";
import Icon from "./Icon.astro";
import type manifest from "../../data/images.generated.json";

type ImageName = keyof typeof manifest;
export type AccordionItem = {
  id: string;
  title: string;
  body: string;
  html?: string;
  link?: { href: string; label: string };
  image: { name: ImageName; alt: string; crop?: Crop; cropSm?: Crop };
};

interface Props {
  id: string;
  items: AccordionItem[];
  label: string;
  anchors?: string;
  aspect?: number;
  frame?: string;
  reverse?: boolean;
  initial?: number;
  flush?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { id, items, label, anchors, aspect, frame = "45vw", reverse = false, initial = 0, flush = false, class: className, ...rest } = Astro.props;
if (!items.length) throw new Error("FeatureAccordion: items is empty");
const open = Math.min(Math.max(initial, 0), items.length - 1);
// The whole capture is shown (HERO-REVISION.md item E), so the frame box takes the capture's own
// aspect (all captures share ~1.713); the fit rule sizes the frame column by that height.
const ratio = aspect ?? +(2880 / 1681).toFixed(4);
---

<div
  class:list={["facc", { "facc--reverse": reverse, "facc--flush": flush }, className]}
  style={`--facc-aspect: ${ratio}`}
  data-facc
  data-initial={open}
  data-anchor-prefix={anchors}
  {...rest}
>
  {
    anchors && (
      <div class="facc__anchors" aria-hidden="true">
        {items.map((item) => (
          <span id={`${anchors}${item.id}`} />
        ))}
      </div>
    )
  }
  <div class="facc__media">
    {
      items.map((item, i) => (
        <div class="facc__shot" data-facc-media={item.id} data-active={i === open ? "" : undefined} aria-hidden={i === open ? undefined : "true"}>
          <Screenshot name={item.image.name} alt={item.image.alt} crop={item.image.crop} cropSm={item.image.cropSm} frame={frame} />
        </div>
      ))
    }
  </div>
  <div class="facc__list" role="group" aria-label={label}>
    {
      items.map((item, i) => (
        <div class="facc__item">
          <h3 class="facc__heading">
            <button
              type="button"
              class="facc__btn"
              id={`${id}-${item.id}-t`}
              aria-expanded={i === open ? "true" : "false"}
              aria-controls={`${id}-${item.id}-p`}
              data-facc-btn={item.id}
            >
              <span>{item.title}</span>
              <Icon set="line" name="pm" size={20} />
            </button>
          </h3>
          <div class="facc__panel" id={`${id}-${item.id}-p`} role="region" aria-labelledby={`${id}-${item.id}-t`} data-open={i === open ? "" : undefined}>
            {item.html ? <p set:html={item.html} /> : <p>{item.body}</p>}
            {item.link && <ArrowLink href={item.link.href}>{item.link.label}</ArrowLink>}
          </div>
        </div>
      ))
    }
  </div>
</div>

<script>
  import "../../scripts/accordion.ts";
</script>

<style>
  .facc {
    position: relative;
    display: grid;
    gap: clamp(1.5rem, 1rem + 2vw, 2.5rem);
    margin-top: var(--gap-intro);
  }
  .facc--flush {
    margin-top: 0;
  }
  .facc__anchors,
  .facc__anchors span {
    position: absolute;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
  }
  /* The frames stack in one cell; only the active one shows. */
  .facc__media {
    position: relative;
    display: grid;
    min-width: 0;
  }
  .facc__shot {
    grid-area: 1 / 1;
    min-width: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity var(--t-swap) var(--ease),
      visibility 0s linear var(--t-swap);
  }
  .facc__shot[data-active] {
    opacity: 1;
    visibility: visible;
    transition:
      opacity var(--t-swap) var(--ease),
      visibility 0s;
  }
  .facc__list {
    min-width: 0;
    border-top: 1px solid var(--color-line);
  }
  .facc__item {
    border-bottom: 1px solid var(--color-line);
  }
  .facc__heading {
    font: inherit;
  }
  .facc__btn {
    display: flex;
    width: 100%;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 60px;
    padding-block: 14px;
    text-align: left;
    font: var(--fw-medium) var(--fs-h4) / var(--lh-h4) var(--font-display);
    color: var(--color-text-muted);
    transition: color var(--t-fast) var(--ease);
  }
  .facc__btn:hover,
  .facc__btn[aria-expanded="true"] {
    color: var(--color-heading);
  }
  .facc__btn :global(svg) {
    flex: none;
    color: var(--color-text-muted);
  }
  .facc__btn[aria-expanded="true"] :global(svg) {
    color: var(--color-accent);
  }
  .facc__btn :global(.pm-v) {
    transform-origin: 12px 12px;
    transition: transform var(--t-ui) var(--ease);
  }
  .facc__btn[aria-expanded="true"] :global(.pm-v) {
    transform: scaleY(0);
  }
  .facc__btn:focus-visible {
    outline-offset: 4px;
  }
  .facc__panel {
    padding-bottom: 20px;
  }
  /* Without JS every panel is open. With JS only the open one shows (the .js class is set in <head>,
     so closed panels never flash). */
  :global(.js) .facc__panel:not([data-open]) {
    display: none;
  }
  .facc__panel p {
    max-width: 34rem;
    color: var(--color-text-muted);
  }
  .facc__panel :global(.arrow) {
    margin-top: 10px;
  }
  @media (min-width: 1024px) {
    .facc {
      --span7: calc((100% - 11 * var(--col-gap)) * 7 / 12 + 6 * var(--col-gap));
      --fit: calc((var(--view-h) - 2 * var(--pad-y)) * var(--facc-aspect));
      grid-template-columns: minmax(0, min(var(--span7), var(--fit))) minmax(0, 1fr);
      column-gap: calc(2 * var(--col-gap));
      align-items: center;
    }
    .facc--reverse {
      grid-template-columns: minmax(0, 1fr) minmax(0, min(var(--span7), var(--fit)));
    }
    .facc--reverse .facc__media {
      order: 2;
    }
  }
</style>

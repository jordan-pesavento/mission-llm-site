---
/*
 * Button: renders the .btn classes from global.css (plain markup may use the classes directly).
 * - variant "primary" (default): ink. Navy with a white label on light (hover navy-700); white with a
 *   navy label in dark bands (hover mist-200).
 * - variant "secondary": a 1px ring, heading-colored label.
 * - variant "accent": a solid blue fill. The nav Download button is a solid accent-blue button on every
 *   skin (HERO-REVISION.md, F1), styled by .nav__cta in Header.astro (not this class). This class is not
 *   used by any shipping control (the sheet Download is the primary treatment on the white sheet); the
 *   accent otherwise stays reserved for eyebrows, links, the focus ring, the node and numerals. Kept for
 *   the /kit swatch. Do not use it for a new button.
 * - variant "quiet": v2 name, rendered as secondary. Do not use in new code.
 * - size "md" (default, --btn-h: 48, 52 from 1920), "lg" (4px taller: the form submit and the closing
 *   section), "nav" (44: the nav's controls), "sm" (40: the code block's Copy).
 * - iconStart / iconEnd: a line icon name (Icon.astro set "line", 20px). A name outside the line set
 *   falls back to Phosphor (v2 buttons); iconSet forces a set. block: full width.
 * Rules: adjacent controls share one height (same size); one primary action per view; every Download
 * button points to /download.
 * Renders <a> when `href` is set, otherwise <button> (type "button" unless given).
 * Usage: <Button href="#steps">See how it works</Button>
 *        <Button href="/security" variant="secondary">Security overview</Button>
 */
import type { HTMLAttributes } from "astro/types";
import Icon from "./Icon.astro";
import { LINE_ICONS } from "./line-icons";

type Props = {
  href?: string;
  variant?: "primary" | "secondary" | "accent" | "quiet";
  size?: "md" | "lg" | "nav" | "sm";
  type?: "button" | "submit";
  iconEnd?: string;
  iconStart?: string;
  iconSet?: "line" | "phosphor";
  iconSize?: number;
  iconWeight?: "regular" | "bold" | "fill";
  block?: boolean;
  class?: string;
} & Omit<HTMLAttributes<"a">, "href" | "class" | "type">;

const {
  href,
  variant = "primary",
  size = "md",
  type = "button",
  iconEnd,
  iconStart,
  iconSet,
  iconSize = 20,
  iconWeight = "regular",
  block = false,
  class: className,
  ...rest
} = Astro.props;
const Tag = href ? "a" : "button";
const v = variant === "quiet" ? "secondary" : variant;
const setFor = (n: string) => iconSet ?? (n in LINE_ICONS ? "line" : "phosphor");
---

<Tag
  href={href}
  type={href ? undefined : type}
  class:list={["btn", `btn--${v}`, size !== "md" && `btn--${size}`, { "btn--block": block }, className]}
  {...rest}
>
  {iconStart && <Icon set={setFor(iconStart)} name={iconStart} size={iconSize} weight={iconWeight} class="btn__icon" />}
  <span class="btn__label"><slot /></span>
  {iconEnd && <Icon set={setFor(iconEnd)} name={iconEnd} size={iconSize} weight={iconWeight} class="btn__icon" />}
</Tag>

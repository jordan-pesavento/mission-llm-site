---
/*
 * Icon, inlined as SVG at build time (no icon font, no client JS). Two sets:
 * - set "line" (use this in new code): the redesign's 24px stroke icons, 1.75 stroke, round caps, drawn
 *   to match the isometric art. Names: arrow, arrow-down, arrow-up-right, caret, plus, pm (plus that
 *   turns into minus: its vertical bar has class pm-v), minus, menu, close, shield, chat, warning,
 *   check, mail, download, copy, browser, cpu, database, cloud.
 * - set "phosphor" (default, v2): any Phosphor icon, regular weight, or weight="bold" | "fill".
 *   Browse names at https://phosphoricons.com (node_modules/@phosphor-icons/core/assets/regular).
 * Icons inherit currentColor. Decorative by default (aria-hidden); pass `label` when the icon is the
 * only content of a control and there is no other accessible name.
 * Usage: <Icon set="line" name="arrow" size={18} />   <Icon name="copy" size={16} label="Copy" />
 */
import fs from "node:fs";
import path from "node:path";
import { LINE_ICONS as LINE } from "./line-icons";

interface Props {
  name: string;
  set?: "phosphor" | "line";
  size?: number | string;
  weight?: "regular" | "bold" | "fill";
  label?: string;
  class?: string;
  [key: string]: unknown;
}

const { name, set = "phosphor", size = 20, weight = "regular", label, class: className, ...rest } = Astro.props;
const dim = typeof size === "number" ? `${size}` : size;
let inner: string;
if (set === "line") {
  if (!LINE[name]) throw new Error(`Icon "${name}" is not in the line set (${Object.keys(LINE).join(", ")})`);
  inner = LINE[name];
} else {
  const file = path.join(
    process.cwd(),
    "node_modules/@phosphor-icons/core/assets",
    weight,
    weight === "regular" ? `${name}.svg` : `${name}-${weight}.svg`,
  );
  if (!fs.existsSync(file)) throw new Error(`Icon "${name}" not found in @phosphor-icons/core (${weight})`);
  inner = fs.readFileSync(file, "utf8").replace(/^[\s\S]*?<svg[^>]*>/, "").replace(/<\/svg>\s*$/, "");
}
const attrs = { ...rest, ...(label ? { role: "img", "aria-label": label } : { "aria-hidden": "true" }) };
---

{
  set === "line" ? (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      width={dim}
      height={dim}
      class:list={["icon", className]}
      focusable="false"
      {...attrs}
      set:html={inner}
    />
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 256 256"
      fill="currentColor"
      width={dim}
      height={dim}
      class:list={["icon", className]}
      focusable="false"
      {...attrs}
      set:html={inner}
    />
  )
}

<style>
  .icon {
    flex: none;
    display: inline-block;
    vertical-align: middle;
  }
</style>

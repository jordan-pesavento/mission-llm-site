---
/*
 * DarkBand: a full-bleed navy-950 section (data-tone="dark"): white headings, #C9D2E3 body, the
 * raised surface #1E2B52 for code blocks and diagram nodes, the accent #5B95FF. Every primitive
 * adapts through the tone tokens. The nav turns to its light skin over it.
 * Same props as Section (size is the v2 name; both sizes pad with --pad-y now).
 * Inside, use <div class="split split--band"> for text 1-5 | media 6-12 (1-4 | 5-12 from 1536).
 * Usage: <DarkBand id="grounded" labelledby="grounded-title"> ... </DarkBand>
 */
import Section from "./Section.astro";

interface Props {
  id?: string;
  size?: "lg" | "sm";
  labelledby?: string;
  label?: string;
  contain?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { size: _size, ...rest } = Astro.props;
---

<Section tone="dark" {...rest}><slot /></Section>

---
/*
 * DarkBand: the reference's full-bleed dark section (Meeting Assistant, Also on Android), in the
 * Mission navy #070F26 with white headings and mist-300 body. A Section with tone="dark".
 * - size: "lg" (default, 64 to 192 padding: the 800px grounded band) or "sm" (80 to 96: deploy band).
 * - Inside, use <div class="split split--band"> for text left, visual right (9fr | 11fr, 94 gap).
 * Usage:
 *   <DarkBand id="grounded" labelledby="grounded-title">
 *     <div class="split split--band"> <div>...</div> <Screenshot name="grounded" alt="..." /> </div>
 *   </DarkBand>
 */
import Section from "./Section.astro";

interface Props {
  id?: string;
  size?: "lg" | "sm";
  labelledby?: string;
  label?: string;
  contain?: boolean;
  class?: string;
  [key: string]: unknown;
}
const { size = "lg", ...rest } = Astro.props;
---

<Section tone="dark" pad={size === "sm" ? "band-sm" : "band"} {...rest}><slot /></Section>

---
/*
 * Contact (/contact): the whole page body (DESIGN-SPEC revision 3, sections 7 and 11; the prototype's
 * contact.html is the source of truth for the look). Two-track layout from 1024:
 * - Left (columns 1 to 5): the intro (eyebrow, H1, lead) with the contact drawing (a message card on a
 *   dotted floor route to the ML server), then "What happens next" with rhombus numerals and the notes.
 * - Right (columns 7 to 12, both rows): the form card.
 * Below 1024 it stacks: intro, form, then "What happens next" and the notes.
 *
 * The form is unchanged in behaviour from revision 2 (do not change its logic): it works without
 * JavaScript by posting to /api/contact (api/contact.js), which answers a plain form post with a 303 to
 * /contact/sent or back to /contact?error=<code>#error-<code>. Each code has a notice below
 * (ERROR_MESSAGES); CSS :target shows it with no script. For field errors the redirect is
 * /contact?error=invalid&fields=email,message#error-invalid-email-message: one empty jump target per
 * combination of fields sits before the notices and the fields, and sibling selectors show the invalid
 * notice, its matching lines and a note under each field named. With JavaScript
 * (src/scripts/contact-form.ts, a bundled module so the CSP needs no new hash) the form validates inline,
 * posts JSON with fetch and shows success or errors in place, keeping what was typed.
 * Rules (limits, roles, backend labels, messages) come from src/lib/contact-rules.js, shared with the
 * function; the email body and the error notices use those labels, so they are left as the source of
 * truth. The visible field labels are the spec's short forms.
 * Section 7 styling: no visible heading inside the card (the form is labelled "Send us a message" for
 * assistive tech); fields pair up and share rows from 640; fields 52px, message box 11rem (7rem on the
 * short tier); "All fields are required unless marked optional." sits beside the submit.
 */
import Section from "../../ui/Section.astro";
import Button from "../../ui/Button.astro";
import Icon from "../../ui/Icon.astro";
import Art from "../../ui/Art.astro";
import { CONTACT_HREF, PLACEHOLDER } from "../../../data/site";
import {
  ERROR_MESSAGES,
  FIELDS,
  FIELD_HELP,
  FIELD_LABELS,
  HONEYPOT,
  LIMITS,
  OFFER_ALTERNATIVE,
  ROLES,
} from "../../../lib/contact-rules.js";

// Codes the function can send back in ?error= (plus server_error for anything unexpected).
const NOTICE_CODES = [
  "invalid",
  "too_fast",
  "expired",
  "too_large",
  "timeout",
  "rate_limited",
  "unavailable",
  "send_failed",
  "forbidden",
  "bad_request",
  "server_error",
] as const;
// Every non-empty combination of fields, in FIELDS order: the jump targets of ?error=invalid&fields=.
const INVALID_COMBOS: string[][] = [];
for (let mask = 1; mask < 1 << FIELDS.length; mask++) INVALID_COMBOS.push(FIELDS.filter((_, i) => mask & (1 << i)));
const joiner = (field: (typeof FIELDS)[number]) => (/[?!.]$/.test(FIELD_LABELS[field]) ? " " : ": ");
const messageMax = LIMITS.messageMax.toLocaleString("en-US");
const ISSUES_URL = `${PLACEHOLDER.repositoryUrl}/issues`;
const ALTERNATIVE = new Set<string>(OFFER_ALTERNATIVE);

// The three steps in "What happens next" (rhombus numerals).
const NEXT_STEPS = [
  "Your message goes to the Mission LLM team by email.",
  "We reply to the address you give. If we need more detail about your course or setup, we ask there.",
  "We use your details only to reply. Nothing is added to a mailing list.",
];
---

<Section tone="dark" pad="hero" labelledby="contact-title" class="contact-hero">
  <div class="contact-hero__grid split split--page">
    <div class="contact-hero__intro">
      <p class="eyebrow" data-align="edge:left">Contact</p>
      <h1 id="contact-title" class="h1-page contact-hero__title">Tell us what you are teaching, learning or building.</h1>
      <p class="lead contact-hero__lead">
        Instructors, students, independent learners, school IT teams and companies are all welcome. A person on the
        Mission LLM team reads every message.
      </p>
    </div>
    <div class="contact-hero__aside">
      <Art src="images/scenes/contact-route.svg" draw class="contact-hero__scene" />
    </div>
  </div>
</Section>

<Section pad="y" label="Contact form and what to expect" class="contact-body">
  <div class="contact-body__grid">
    <div class="contact-card card">
      <form
        class="contact-form"
        method="post"
        action="/api/contact"
        accept-charset="UTF-8"
        aria-label="Send us a message"
        data-contact-form
      >
        <!-- Jump targets for ?error=invalid&fields=... (no JavaScript): see the header comment. -->
        {INVALID_COMBOS.map((fields) => <span class="nojs-target" id={`error-invalid-${fields.join("-")}`} data-fields={fields.join(" ")} />)}

        <div class="contact-form__notices">
          {
            NOTICE_CODES.map((code) => (
              <div class="form-alert form-notice" id={`error-${code}`} tabindex="-1" data-notice={code}>
                <Icon set="line" name="warning" size={22} class="form-alert__icon" />
                <div>
                  <p class="form-alert__title">{ERROR_MESSAGES[code]}</p>
                  {code === "invalid" && (
                    <ul class="form-alert__list">
                      {FIELDS.map((field) => (
                        <li data-notice-field={field}>
                          <strong>{FIELD_LABELS[field]}</strong>
                          {joiner(field)}
                          {FIELD_HELP[field]}
                        </li>
                      ))}
                    </ul>
                  )}
                  {ALTERNATIVE.has(code) && (
                    <p class="form-alert__text">
                      For a question about the app, you can also <a href={ISSUES_URL}>open an issue on GitHub</a> (issues
                      are public).
                    </p>
                  )}
                  <p class="form-alert__text">
                    {code === "invalid"
                      ? "Your browser's Back button usually brings back what you typed. Change these fields there, then send again."
                      : "Going back in your browser usually keeps what you typed."}
                  </p>
                </div>
              </div>
            ))
          }
          <div class="form-summary" tabindex="-1" data-summary></div>
          <template data-alert-icon><Icon set="line" name="warning" size={22} class="form-alert__icon" /></template>
          <template data-alternative>
            <p class="form-alert__text">
              For a question about the app, you can also <a href={ISSUES_URL}>open an issue on GitHub</a> (issues are public).
            </p>
          </template>
        </div>

        <div class="contact-form__grid">
          <div class="field" data-field="name">
            <label class="field__label" for="contact-name">Name</label>
            <input
              class="field__control"
              id="contact-name"
              name="name"
              type="text"
              autocomplete="name"
              maxlength={LIMITS.name}
              pattern=".*[\p{L}\p{N}].*"
              title="Enter your name."
              required
            />
            <p class="field__error" id="contact-name-error" hidden></p>
            <p class="field__error field__error--nojs">{FIELD_HELP.name}</p>
          </div>

          <div class="field" data-field="email">
            <label class="field__label" for="contact-email">Email</label>
            <input
              class="field__control"
              id="contact-email"
              name="email"
              type="email"
              autocomplete="email"
              inputmode="email"
              spellcheck="false"
              maxlength={LIMITS.email}
              pattern="[^@\s]+@[^@\s]+\.[A-Za-z]{2,63}"
              title="Enter your full email address, like name@school.edu."
              required
            />
            <p class="field__error" id="contact-email-error" hidden></p>
            <p class="field__error field__error--nojs">{FIELD_HELP.email}</p>
          </div>

          <div class="field" data-field="organization">
            <label class="field__label" for="contact-organization">
              Organization <span class="field__optional">(optional)</span>
            </label>
            <input
              class="field__control"
              id="contact-organization"
              name="organization"
              type="text"
              autocomplete="organization"
              maxlength={LIMITS.organization}
            />
            <p class="field__error" id="contact-organization-error" hidden></p>
            <p class="field__error field__error--nojs">{FIELD_HELP.organization}</p>
          </div>

          <div class="field" data-field="role">
            <label class="field__label" for="contact-role">I am a</label>
            <div class="field__select">
              <select class="field__control" id="contact-role" name="role" required>
                <option value="">Choose one</option>
                {ROLES.map((r) => <option value={r.value}>{r.label}</option>)}
              </select>
              <Icon set="line" name="caret" size={20} class="field__caret" />
            </div>
            <p class="field__error" id="contact-role-error" hidden></p>
            <p class="field__error field__error--nojs">{FIELD_HELP.role}</p>
          </div>

          <div class="field field--wide" data-field="message">
            <label class="field__label" for="contact-message">Message</label>
            <textarea
              class="field__control field__control--area"
              id="contact-message"
              name="message"
              rows="8"
              minlength={LIMITS.messageMin}
              maxlength={LIMITS.messageMax}
              aria-describedby="contact-message-hint"
              required></textarea>
            <div class="field__meta">
              <p class="field__hint" id="contact-message-hint">At least {LIMITS.messageMin} characters.</p>
              <p class="field__count tnum" id="contact-message-count" data-count>
                <span aria-hidden="true"><span data-count-value>0</span> / {messageMax}</span>
                <span class="sr-only"><span data-count-sr>0</span> of {messageMax} characters</span>
              </p>
            </div>
            <p class="sr-only" aria-live="polite" data-count-status></p>
            <p class="field__error" id="contact-message-error" hidden></p>
            <p class="field__error field__error--nojs">{FIELD_HELP.message}</p>
          </div>
        </div>

        <!-- Left empty by people; bots that fill every field reveal themselves here. Off screen, out of
             the tab order and the accessibility tree, with a name autofill tools do not recognize. -->
        <div class="hp" aria-hidden="true">
          <label for="contact-hp">Leave this field empty</label>
          <input
            id="contact-hp"
            name={HONEYPOT}
            type="text"
            value=""
            tabindex="-1"
            autocomplete="off"
            data-1p-ignore
            data-lpignore="true"
            data-bwignore
            data-form-type="other"
          />
        </div>
        <!-- Render time, set by the page's script (empty without JavaScript). -->
        <input type="hidden" name="ts" value="" data-contact-ts />

        <div class="contact-form__actions">
          <Button type="submit" size="lg" class="contact-form__submit" data-submit>
            <span data-submit-label>Send message</span>
          </Button>
          <p class="contact-form__required">All fields are required unless marked optional.</p>
        </div>
        <p class="contact-form__privacy">
          We use these details only to reply to you. Your message is delivered by email through our email provider, with
          your country and browser type to help us reply.
        </p>
      </form>

      <!-- Polite status for the script: "Sending your message." and the one summary announcement. -->
      <p class="sr-only" role="status" data-status></p>

      <div class="contact-success" data-contact-success hidden>
        <span class="contact-success__mark" aria-hidden="true">
          <Icon set="line" name="check" size={24} />
        </span>
        <h2 class="h3 contact-success__title" tabindex="-1" data-success-title>Message sent.</h2>
        <p class="contact-success__text">
          Thank you. Your message is with the Mission LLM team. We will reply to <strong
            class="contact-success__email"
            data-success-email></strong>.
        </p>
        <p class="contact-success__note">If that address is wrong, send another message with the right one.</p>
        <div class="contact-success__actions" data-row="success-actions">
          <Button href="/">Back to home</Button>
          <Button href={CONTACT_HREF} variant="secondary" data-send-another>Send another message</Button>
        </div>
      </div>
    </div>

    <div class="contact__more">
      <div class="contact__next">
        <h2 class="contact__next-title">What happens next</h2>
        <ol class="contact__steps" role="list">
          {
            NEXT_STEPS.map((text, i) => (
              <li>
                <span class="num num--sm" aria-hidden="true">
                  {i + 1}
                </span>
                <span>{text}</span>
              </li>
            ))
          }
        </ol>
      </div>
      <div class="contact__notes">
        <p>
          <Icon set="line" name="shield" size={22} class="contact__note-icon" />
          <span>Found a security issue? Please <a href="/security#report">report it privately</a> instead of using this form.</span>
        </p>
        <p>
          <Icon set="line" name="chat" size={22} class="contact__note-icon" />
          <span>A question about the app? You can also <a href={ISSUES_URL}>open an issue on GitHub</a>. Issues are public.</span>
        </p>
      </div>
    </div>
  </div>
</Section>

<script>
  import "../../../scripts/contact-form.ts";
</script>

<style>
  /* ---------- Layout (F2): the page's top section is a DARK navy hero (intro), then a LIGHT section with
     the form card beside "what happens next" and the notes. So the page alternates dark -> light ->
     dark(footer) per the whole-page rule, with no white-on-white seam. The form markup and behaviour are
     unchanged; only the section wrapping and layout changed. ---------- */
  .contact-hero__intro {
    min-width: 0;
  }
  .contact-hero__title {
    margin-top: 12px;
    max-width: 18ch;
  }
  .contact-hero__lead {
    margin-top: 20px;
    max-width: var(--measure);
  }
  .contact-hero__aside {
    display: none;
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .contact-hero__aside {
      display: block;
      align-self: center;
    }
    .contact-hero__scene {
      width: 100%;
      max-width: 26rem;
      margin-inline: auto;
    }
  }

  /* Light form section: the form card and, beside it, "what happens next" and the notes. */
  .contact-body__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "card" "more";
    gap: clamp(2rem, 1rem + 3vw, 3rem);
    align-items: start;
  }
  .contact-card {
    grid-area: card;
  }
  .contact__more {
    grid-area: more;
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .contact-body__grid {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-areas: "more more more more more . card card card card card card";
      column-gap: var(--col-gap);
    }
  }
  @media (min-width: 1280px) {
    .contact-body__grid {
      grid-template-areas: "more more more more more card card card card card card card";
    }
  }

  /* ---------- "What happens next" and the notes ---------- */
  .contact__next {
    display: grid;
    gap: var(--space-4);
  }
  .contact__next-title {
    font-family: var(--font-sans);
    font-size: var(--fs-h4);
    line-height: var(--lh-h4);
    font-weight: var(--fw-semibold);
    color: var(--color-heading);
  }
  .contact__steps {
    display: grid;
    gap: 14px;
  }
  .contact__steps li {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr);
    gap: 14px;
    align-items: start;
    color: var(--color-text-muted);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }
  .contact__steps .num {
    margin-top: -2px;
  }
  .contact__notes {
    display: grid;
    gap: 10px;
    margin-top: clamp(1.75rem, 1rem + 2vw, 2.5rem);
    padding-top: 20px;
    border-top: 1px solid var(--color-line);
  }
  .contact__notes p {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 12px;
    color: var(--color-text-muted);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }
  .contact__notes :global(.contact__note-icon) {
    margin-top: 0.15em;
    color: var(--color-text-quiet);
  }
  .contact__notes a {
    color: var(--color-link);
    text-underline-offset: 0.2em;
  }

  /* ---------- Card ---------- */
  .contact-card {
    min-width: 0;
    padding: clamp(1.25rem, 0.8rem + 2vw, 3rem);
  }
  .contact-form {
    position: relative;
  }

  /* ---------- Notices (?error= after a plain form post) and the summary ---------- */
  .nojs-target {
    display: block;
  }
  .contact-form__notices {
    display: grid;
  }
  .form-alert,
  .form-summary:not(:empty) {
    display: grid;
    grid-template-columns: 22px minmax(0, 1fr);
    gap: 12px;
    margin-bottom: var(--space-6);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-danger-line);
    border-radius: var(--r-control);
    background: var(--color-danger-bg);
    color: var(--color-text);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
  }
  .form-alert:focus,
  .form-summary:focus {
    outline: none;
  }
  .form-alert:focus-visible,
  .form-summary:focus-visible {
    outline: 2px solid var(--color-danger);
    outline-offset: 2px;
    border-radius: var(--r-control);
  }
  .form-alert :global(.form-alert__icon),
  .form-summary :global(.form-alert__icon) {
    color: var(--color-danger);
  }
  .form-alert__title,
  .form-summary :global(.form-alert__title) {
    font-weight: var(--fw-semibold);
    color: var(--color-heading);
  }
  .form-alert__text,
  .form-summary :global(.form-alert__text) {
    margin-top: var(--space-2);
    color: var(--color-text-muted);
  }
  .form-alert__list {
    margin-top: var(--space-1);
    padding-left: 1.25rem;
  }
  .form-summary :global(ul) {
    margin-top: var(--space-2);
    padding-left: 1.25rem;
  }
  .form-alert__list li,
  .form-summary :global(li + li) {
    margin-top: var(--space-1);
  }
  .form-alert__list strong,
  .form-summary :global(strong) {
    font-weight: var(--fw-semibold);
    color: var(--color-heading);
  }
  .form-summary :global(ul a) {
    color: var(--color-danger);
    font-weight: var(--fw-medium);
    text-decoration-color: currentColor;
  }
  .form-alert a,
  .form-summary :global(.form-alert__text a) {
    color: var(--color-heading);
  }

  /* Hidden until asked for: by the script (.is-shown), or without JavaScript by the URL fragment. */
  .form-notice,
  .form-alert__list li,
  .field__error--nojs {
    display: none;
  }
  .form-notice.is-shown,
  :global(html:not(.js)) .form-notice:target,
  :global(html:not(.js)) .nojs-target:target ~ .contact-form__notices #error-invalid {
    display: grid;
  }
  .form-alert__list li.is-shown,
  :global(html:not(.js)) #error-invalid:target .form-alert__list li,
  :global(html:not(.js)) .nojs-target:target[data-fields~="name"] ~ .contact-form__notices [data-notice-field="name"],
  :global(html:not(.js)) .nojs-target:target[data-fields~="email"] ~ .contact-form__notices [data-notice-field="email"],
  :global(html:not(.js)) .nojs-target:target[data-fields~="organization"] ~ .contact-form__notices [data-notice-field="organization"],
  :global(html:not(.js)) .nojs-target:target[data-fields~="role"] ~ .contact-form__notices [data-notice-field="role"],
  :global(html:not(.js)) .nojs-target:target[data-fields~="message"] ~ .contact-form__notices [data-notice-field="message"] {
    display: list-item;
  }
  :global(html:not(.js)) .nojs-target:target[data-fields~="name"] ~ .contact-form__grid [data-field="name"] .field__error--nojs,
  :global(html:not(.js)) .nojs-target:target[data-fields~="email"] ~ .contact-form__grid [data-field="email"] .field__error--nojs,
  :global(html:not(.js)) .nojs-target:target[data-fields~="organization"] ~ .contact-form__grid [data-field="organization"] .field__error--nojs,
  :global(html:not(.js)) .nojs-target:target[data-fields~="role"] ~ .contact-form__grid [data-field="role"] .field__error--nojs,
  :global(html:not(.js)) .nojs-target:target[data-fields~="message"] ~ .contact-form__grid [data-field="message"] .field__error--nojs {
    display: flex;
  }
  :global(html:not(.js)) .nojs-target:target[data-fields~="name"] ~ .contact-form__grid [data-field="name"] .field__control,
  :global(html:not(.js)) .nojs-target:target[data-fields~="email"] ~ .contact-form__grid [data-field="email"] .field__control,
  :global(html:not(.js)) .nojs-target:target[data-fields~="organization"] ~ .contact-form__grid [data-field="organization"] .field__control,
  :global(html:not(.js)) .nojs-target:target[data-fields~="role"] ~ .contact-form__grid [data-field="role"] .field__control,
  :global(html:not(.js)) .nojs-target:target[data-fields~="message"] ~ .contact-form__grid [data-field="message"] .field__control {
    border-color: var(--color-danger);
    box-shadow: inset 0 0 0 1px var(--color-danger);
  }

  /* ---------- Fields: pair up from 640 (viewport), matching the prototype and spec section 7; each
     field is a small stack (label, control, error). align-items:start keeps paired controls level even
     when one field shows an error below. ---------- */
  .contact-form__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }
  @media (min-width: 640px) {
    .contact-form__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-5);
      row-gap: var(--space-5);
    }
    .field--wide {
      grid-column: 1 / -1;
    }
  }
  .field {
    display: grid;
    gap: var(--space-2);
    align-content: start;
    min-width: 0;
  }
  .field__label {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-semibold);
    color: var(--color-heading);
  }
  .field__optional {
    font-weight: var(--fw-regular);
    color: var(--color-text-quiet);
  }
  .field__control {
    display: block;
    width: 100%;
    min-height: 52px;
    padding: 13px var(--space-4);
    border: 1px solid var(--color-field-line);
    border-radius: var(--r-control);
    background: var(--color-field);
    color: var(--color-heading);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    line-height: 1.5rem;
    transition:
      border-color var(--t-fast) var(--ease),
      box-shadow var(--t-fast) var(--ease);
  }
  .field__control::placeholder {
    color: var(--color-text-quiet);
  }
  .field__control:hover {
    border-color: var(--color-field-line-hover);
  }
  .field__control:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-color: var(--color-focus);
    border-radius: var(--r-control);
  }
  .field__control[aria-invalid="true"] {
    border-color: var(--color-danger);
    box-shadow: inset 0 0 0 1px var(--color-danger);
  }
  .field__control--area {
    min-height: 11rem;
    max-height: 24rem;
    resize: vertical;
  }
  /* Short desktop screens: tighten the card and message box so the Send button stays above the fold. */
  @media (min-width: 1024px) and (max-height: 800px) {
    .contact-card {
      padding: 2rem;
    }
    .field__control--area {
      min-height: 7rem;
    }
    .contact-form__actions {
      margin-top: var(--space-5);
    }
  }
  .field__select {
    position: relative;
  }

---
/*
 * Security > Hero (copy.md, verbatim): eyebrow, H1, summary, last-updated date, the
 * no-certification callout, and the page's table of contents. Package C.
 * Visual system (reference, anythingllm.com): the hero's mist wash under the header, an eyebrow and a
 * 60/63 H1, an 18/28 subhead. From 1024 the text and the contents list sit side by side (7fr | 5fr,
 * the 94px split gap); the list reads like the reference's accordion: 60px rows, Clash Display 400
 * 18/24, mist-300 separators, an arrow on the right. Below 1024 the list follows the text.
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import Icon from "../../ui/Icon.astro";
import { PAGES } from "../../../data/site";

// Section ids are set by each section component on this page. Labels are the section headings.
const TOC = [
  { id: "data-flow", label: "Data flow in plain language" },
  { id: "outbound", label: "Other outbound connections" },
  { id: "controls", label: "Controls available today" },
  { id: "hardening", label: "Hardening an install today" },
  { id: "in-development", label: "In development" },
  { id: "not-claimed", label: "What we do not claim" },
  { id: "report", label: "Reporting a vulnerability" },
];

const updated = PAGES.security.lastUpdated;
const updatedLabel = new Date(`${updated}T00:00:00Z`).toLocaleDateString("en-US", {
  timeZone: "UTC",
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Section pad="hero" wash labelledby="security-title" class="sec-hero">
  <div class="sec-hero__grid">
    <div class="sec-hero__main" data-reveal>
      <SectionIntro level={1} eyebrow="Security" title="Security and deployment overview." id="security-title" />
      <p class="lead sec-hero__lead">
        Mission LLM runs inside your school's or organization's boundary. This page covers where data goes, including student
        questions and course files, which controls ship today, which are in development, and how to harden an install.
      </p>
      <p class="small sec-hero__updated">Last updated <time datetime={updated}>{updatedLabel}</time></p>
      <div class="note sec-hero__note" role="note">
        <p>
          <strong>Mission LLM does not hold any government certification or authorization today.</strong>{" "}
          Because it runs on your infrastructure, you assess it as part of your own system.
        </p>
      </div>
    </div>

    <nav class="sec-toc" aria-labelledby="sec-toc-title" data-reveal="2">
      <p class="label sec-toc__title" id="sec-toc-title">On this page</p>
      <ol class="sec-toc__list" role="list">
        {
          TOC.map((item) => (
            <li>
              <a class="sec-toc__link" href={`#${item.id}`}>
                <span class="sec-toc__text">{item.label}</span>
                <Icon name="arrow-down" size={20} class="sec-toc__icon" />
              </a>
            </li>
          ))
        }
      </ol>
    </nav>
  </div>
</Section>

<style>
  .sec-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--gap-h2-content);
  }
  @media (min-width: 1024px) {
    .sec-hero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--split-gap);
      align-items: start;
    }
  }
  .sec-hero__main {
    min-width: 0;
  }
  .sec-hero__lead {
    max-width: var(--measure);
    margin-top: var(--gap-h2-text);
  }
  /* mist-550: quiet text on the wash (4.7:1 on mist-200). */
  .sec-hero__updated {
    margin-top: var(--space-4);
    color: var(--mist-550);
  }
  .sec-hero__updated time {
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    color: var(--mist-700);
  }
  .sec-hero__note {
    max-width: var(--measure);
    margin-top: var(--gap-text-action);
  }

  /* ---------- Contents: accordion-style rows ---------- */
  .sec-toc {
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .sec-toc {
      padding-top: var(--space-2);
    }
  }
  .sec-toc__title {
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-line);
    color: var(--color-text-muted);
  }
  .sec-toc__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 60px;
    padding-block: 18px;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-display);
    font-size: var(--fs-acc);
    line-height: var(--lh-acc);
    font-weight: var(--fw-acc);
    color: var(--color-heading);
    text-decoration: none;
  }
  .sec-toc__link:hover .sec-toc__text {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  .sec-toc__link :global(.sec-toc__icon) {
    color: var(--color-heading);
    transition: transform var(--dur-hover) var(--ease-standard);
  }
  .sec-toc__link:hover :global(.sec-toc__icon) {
    transform: translateY(2px);
  }
  .sec-toc__link:focus-visible {
    outline-offset: 4px;
  }
</style>

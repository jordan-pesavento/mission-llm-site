---
/*
 * Security > Hero (copy.md, verbatim): eyebrow, inner-page H1, summary, last-updated date, and the
 * no-certification callout. Package C.
 * The page's top section, so it is DARK (HERO-REVISION.md: each inner page's hero-equivalent top
 * section is navy, and the sections alternate below it).
 * The page's "On this page" table of contents lives in the page (security.astro), not in this hero, so
 * it can stay sticky under the nav for the WHOLE page rather than only while the hero is in view (F3).
 */
import Section from "../../ui/Section.astro";
import Icon from "../../ui/Icon.astro";
import { PAGES } from "../../../data/site";

const updated = PAGES.security.lastUpdated;
const updatedLabel = new Date(`${updated}T00:00:00Z`).toLocaleDateString("en-US", {
  timeZone: "UTC",
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Section tone="dark" pad="hero" labelledby="security-title" class="sec-hero">
  <div class="sec-hero__main" data-reveal>
    <p class="eyebrow">Security</p>
    <h1 id="security-title" class="h1-page sec-hero__title">Security and deployment overview.</h1>
    <p class="lead sec-hero__lead">
      Mission LLM runs inside your own network boundary, on hardware you control. This page covers where data goes, including
      student questions, course files and team documents, which controls ship today, which are in development, and how to
      harden an install.
    </p>
    <p class="small sec-hero__updated">Last updated <time datetime={updated}>{updatedLabel}</time></p>
    <div class="note sec-hero__note" role="note">
      <Icon set="line" name="shield" size={22} />
      <p>
        <strong>Mission LLM does not hold any government certification or authorization today.</strong>{" "}
        Because it runs on your infrastructure, you assess it as part of your own system.
      </p>
    </div>
  </div>
</Section>

<style>
  .sec-hero__main {
    min-width: 0;
  }
  .sec-hero__lead {
    max-width: var(--measure);
    margin-top: var(--space-6);
  }
  .sec-hero__updated {
    margin-top: var(--space-5);
  }
  .sec-hero__updated time {
    font-weight: var(--fw-medium);
    font-variant-numeric: tabular-nums;
    color: var(--color-text-muted);
  }
  .sec-hero__note {
    max-width: var(--measure);
    margin-top: var(--space-8);
  }
</style>

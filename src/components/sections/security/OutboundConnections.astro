---
/*
 * Security > Data flow > Other outbound connections (copy.md): an 8-row, 4-column table and its
 * footnote. Text is verbatim. Host names stay in the text face and may only wrap where marked
 * with "|" below (never mid-label); settings and paths are set in code type and never break.
 * - below 640: .data-table--stack (each row a block, column names from data-label).
 * - 640 to 959: each row is a block: the connection on top, When and What is sent side by side,
 *   then How to avoid it at full width.
 * - 960 and wider: a real 4-column table with fixed column widths.
 * The footnote names a roadmap item, so it carries the In development badge.
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import Badge from "../../ui/Badge.astro";
import { TELEMETRY_ENV } from "../../../data/site";

const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;");
/** A host name; "|" marks the one place it may wrap (browsers do not break at dots otherwise). */
const host = (s: string) => esc(s).replace("|", "<wbr>");
/** A setting or path in code type (kept on one line by the table styles). */
const c = (s: string) => `<code>${esc(s)}</code>`;

// [connection name, connection detail (optional), when, what is sent, how to avoid it] as HTML.
const ROWS: { name: string; detail?: string; when: string; sent: string; avoid: string }[] = [
  {
    name: "Telemetry",
    detail: "(the upstream project's analytics account)",
    when: "On boot and during use, unless disabled",
    sent: "Anonymous usage events, such as which provider types are selected",
    avoid: `Set ${c(TELEMETRY_ENV)} before the first start`,
  },
  {
    name: host("models.dev"),
    when: "At boot, when the pricing cache is missing or older than three days",
    sent: "A request for public model pricing data",
    avoid: "Block it. The server logs the failure and keeps running.",
  },
  {
    name: host("raw.|githubusercontent.com"),
    when: "At boot, when the context-window cache is missing or stale",
    sent: "A request for public model context-window data",
    avoid: "Block it, and set token limits for local models in their provider settings",
  },
  {
    name: `Hugging Face, then ${host("cdn.anythingllm.com")}`,
    when: "First use of the built-in embedder or reranker",
    sent: "A model file download",
    avoid: `Stage the models under ${c("storage/models")}`,
  },
  {
    name: "Hugging Face",
    when: "First local audio transcription",
    sent: "A Whisper model download",
    avoid: `Stage the model under ${c("storage/models")}`,
  },
  {
    name: "OCR language data",
    when: "First OCR of an image or scanned PDF",
    sent: "A language data download by the OCR library",
    avoid: `Stage the data under ${c("storage/models/tesseract")}`,
  },
  {
    name: "Community Hub",
    detail: `(${host("hub.external.|anythingllm.com")})`,
    when: "Only when an admin browses or imports items",
    sent: "Browse and import requests",
    avoid: "Do not open the Community Hub pages",
  },
  {
    name: "Onboarding survey",
    detail: `(${host("onboarding.|anythingllm.com")})`,
    when: "Only if someone fills it in and submits it, from their browser",
    sent: "The email, use case and comment entered",
    avoid: "Leave the survey blank",
  },
];
---

<Section id="outbound" tone="light" labelledby="outbound-title">
  <SectionIntro title="Other outbound connections" id="outbound-title" />

  <div class="ob">
    <table class="data-table data-table--stack ob-table" aria-labelledby="outbound-title">
      <colgroup>
        <col class="ob-col ob-col--name" />
        <col class="ob-col ob-col--when" />
        <col class="ob-col ob-col--sent" />
        <col class="ob-col ob-col--avoid" />
      </colgroup>
      <thead>
        <tr>
          <th scope="col">Connection</th>
          <th scope="col">When</th>
          <th scope="col">What is sent</th>
          <th scope="col">How to avoid it</th>
        </tr>
      </thead>
      <tbody>
        {
          ROWS.map((row) => (
            <tr>
              <th scope="row">
                <span class="ob-name" set:html={row.name} />
                {row.detail && (
                  <>
                    {" "}
                    <span class="ob-detail" set:html={row.detail} />
                  </>
                )}
              </th>
              <td data-label="When" set:html={row.when} />
              <td data-label="What is sent" set:html={row.sent} />
              <td data-label="How to avoid it" set:html={row.avoid} />
            </tr>
          ))
        }
      </tbody>
    </table>

    <p class="ob-foot">
      <Badge />
      <span>An offline mode switch that turns all of these off at once is in development.</span>
    </p>
  </div>
</Section>

<style>
  .ob {
    margin-top: var(--gap-visual);
  }
  .ob-name {
    color: var(--color-text);
  }
  .ob-detail {
    display: block;
    margin-top: 2px;
    font-weight: 400;
    color: var(--color-text-3);
  }
  /* Settings and paths never split across lines; the widest (24 characters) fits every column. */
  .ob-table :global(code) {
    font-size: 0.9375em;
    white-space: nowrap;
    overflow-wrap: normal;
  }
  .ob-table td[data-label="How to avoid it"] {
    color: var(--color-text);
  }

  /* 640 to 959: a block per row; the remedy gets the full width. */
  @media (min-width: 640px) and (max-width: 959.98px) {
    .ob-table thead {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }
    .ob-table,
    .ob-table tbody {
      display: block;
      width: 100%;
    }
    .ob-table colgroup {
      display: none;
    }
    .ob-table tr {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--space-4) var(--grid-gap);
      padding-block: var(--space-5);
      border-bottom: 1px solid var(--color-hairline);
    }
    .ob-table tr:first-child {
      border-top: 1px solid var(--color-hairline-strong);
    }
    .ob-table th,
    .ob-table td {
      display: block;
      padding: 0;
      border: 0;
    }
    .ob-table tbody th {
      grid-column: 1 / -1;
      font-size: var(--fs-body);
      line-height: 1.4;
    }
    .ob-table td[data-label="How to avoid it"] {
      grid-column: 1 / -1;
    }
    .ob-table td::before {
      content: attr(data-label);
      display: block;
      margin-bottom: var(--space-1);
      font-weight: 600;
      color: var(--color-text-3);
    }
  }

  /* 960 and wider: a real table; the header row reads as a strong rule. */
  @media (min-width: 960px) {
    .ob-table {
      table-layout: fixed;
    }
    /* The remedy column holds the longest unbreakable settings (24 characters of code at 18px). */
    .ob-col--name {
      width: 24%;
    }
    .ob-col--when {
      width: 23%;
    }
    .ob-col--sent {
      width: 23%;
    }
    .ob-col--avoid {
      width: 30%;
    }
    .ob-table th,
    .ob-table td {
      padding-top: var(--space-5);
      padding-bottom: var(--space-5);
    }
    .ob-table thead th {
      padding-top: 0;
      padding-bottom: var(--space-4);
      font-size: var(--fs-eyebrow);
      line-height: var(--lh-eyebrow);
      letter-spacing: var(--ls-eyebrow);
      text-transform: uppercase;
      color: var(--color-eyebrow);
    }
  }

  .ob-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-4);
    margin-top: var(--space-6);
    font-size: var(--fs-ui);
    line-height: var(--lh-ui);
    color: var(--color-text-2);
  }
</style>

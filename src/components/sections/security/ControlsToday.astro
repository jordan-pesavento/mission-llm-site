---
/*
 * Security > Controls available today (copy.md): four groups (Access, Oversight, Transport and
 * runtime, Integrations), verbatim. Package C.
 * Each term runs into its definition so the copy reads exactly as written. From 1024 the group title
 * (Clash 24/32) sits in the left column of the page rail (5fr | 12fr, 94px gap) beside its list, on
 * mist-300 hairlines. The telemetry row reuses copy.md Home > Security and control verbatim so this
 * list names DISABLE_TELEMETRY. Only shipped controls belong here; roadmap items live in
 * InDevelopment.astro. Group ids: #controls-access, -oversight, -transport, -integrations (the home
 * security accordion links to the first two).
 * Evidence (mission-llm, copy.md evidence table): the manager role is server-wide (Workspace.getWithUser
 * returns every workspace for admins and managers); admins and managers read and export workspace
 * chats with the sender (server/endpoints/system.js:1178-1235); DISABLE_VIEW_CHAT_HISTORY hides the
 * app's history pages and export; the chat widget is admin-only (server/endpoints/embedManagement.js)
 * with allowed domains and per-day and per-session limits (server/prisma/schema.prisma:235-254), and
 * its visitors chat without signing in (frontend/public/embed).
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import { TELEMETRY_ENV } from "../../../data/site";

const code = (s: string) => `<code>${s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;")}</code>`;

// term is the bold lead-in; text is HTML (inline code only).
const GROUPS: { id: string; title: string; items: { term: string; text: string }[] }[] = [
  {
    id: "controls-access",
    title: "Access",
    items: [
      {
        term: "Authentication:",
        text: "a single password, or multi-user mode with individual accounts. You choose during onboarding.",
      },
      {
        term: "Roles:",
        text: "admin, manager and default. Admins and managers can open every workspace on the server; default users chat only in the workspaces they are assigned to.",
      },
      { term: "Account controls:", text: "invitations, suspension and per-user daily message limits." },
      {
        term: "Password complexity:",
        text: `minimum and maximum length and required character types, set with ${code("PASSWORDMINCHAR")}, ${code("PASSWORDREQUIREMENTS")} and related variables.`,
      },
      {
        term: "Simple SSO passthrough:",
        text: `sign users in with temporary tokens issued through your own identity bridge (${code("SIMPLE_SSO_ENABLED")}).`,
      },
    ],
  },
  {
    id: "controls-oversight",
    title: "Oversight",
    items: [
      {
        term: "Admin event log:",
        text: "sign-ins, failed sign-ins, attempts on suspended accounts, changes to users, invites and API keys, workspace and document changes, and chat exports.",
      },
      {
        term: "Chat history review and export:",
        text: "admins and managers can read workspace chats with the user who sent each one, and export them as CSV, JSON or JSONL.",
      },
      { term: "Hide chat history", text: `from the interface: ${code("DISABLE_VIEW_CHAT_HISTORY")}.` },
      { term: "Workspace deletion protection:", text: `${code("WORKSPACE_DELETION_PROTECTION")}.` },
    ],
  },
  {
    id: "controls-transport",
    title: "Transport and runtime",
    items: [
      {
        term: "Built-in HTTPS",
        text: `with your certificate and key (${code("ENABLE_HTTPS")}, ${code("HTTPS_CERT_PATH")}, ${code("HTTPS_KEY_PATH")}), or TLS at your own reverse proxy.`,
      },
      { term: "The container runs as a non-root user", text: "(UID 1000 by default) and has a health check." },
      { term: "The Helm chart", text: "keeps credentials in Kubernetes Secrets and ships with telemetry off." },
      { term: "Telemetry off with one setting.", text: `Set ${code(TELEMETRY_ENV)} and no usage events are sent.` },
    ],
  },
  {
    id: "controls-integrations",
    title: "Integrations",
    items: [
      {
        term: "Developer API:",
        text: `admin-issued API keys, OpenAPI documentation at ${code("/api/docs")}, and OpenAI-compatible endpoints.`,
      },
      { term: "Agent tools:", text: "admins turn each agent skill and MCP server on or off." },
      {
        term: "Chat widget:",
        text: "admins can embed a workspace chat on web pages from the domains they allow, with per-day and per-session chat limits. Visitors chat without signing in.",
      },
    ],
  },
];
---

<Section id="controls" labelledby="controls-title">
  <div data-reveal>
    <SectionIntro title="Controls available today" id="controls-title" />
  </div>

  <div class="ct" data-reveal="2">
    {
      GROUPS.map((group) => (
        <div class="ct-group">
          <h3 class="h3 ct-group__title" id={group.id}>
            {group.title}
          </h3>
          <dl class="ct-dl" aria-labelledby={group.id}>
            {group.items.map((item) => (
              <div>
                <dt>{item.term}</dt>{" "}<dd set:html={item.text} />
              </div>
            ))}
          </dl>
        </div>
      ))
    }
  </div>
</Section>

<style>
  /* No closing rule: the section's dotted divider is the only separator after the last group. */
  .ct {
    margin-top: var(--gap-h2-content);
  }
  .ct-group {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-2);
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-line);
  }
  @media (min-width: 1024px) {
    .ct-group {
      grid-template-columns: minmax(0, 5fr) minmax(0, 12fr);
      column-gap: var(--split-gap);
      padding-block: var(--space-4);
    }
    .ct-group__title {
      padding-top: var(--space-4);
    }
  }
  /* Run-in terms: the definition continues the sentence, as the copy is written. */
  /* Row hairlines run the full column, as the group rules do; the text keeps a 44rem measure. */
  .ct-dl > div {
    padding-block: var(--space-4);
    padding-right: max(0px, 100% - 44rem);
    font-size: var(--fs-body);
    line-height: var(--lh-body-relaxed);
  }
  .ct-dl > div + div {
    border-top: 1px solid var(--color-line);
  }
  .ct-dl dt,
  .ct-dl dd {
    display: inline;
  }
  .ct-dl dt {
    font-weight: var(--fw-semibold);
    color: var(--color-heading);
  }
  .ct-dl dd {
    margin: 0;
    color: var(--color-text-muted);
  }
</style>

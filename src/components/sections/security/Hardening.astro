---
/*
 * Security > Hardening an install today (copy.md): seven numbered steps, verbatim, plus step 8,
 * loopback-only access in Docker (standard Docker port binding, so it works with every release; the
 * home page's "Loopback-only binding" item links here). Package C.
 * Visual system: the reference's "Up and running in a few clicks." row. H2 48/48 (SectionIntro
 * size="lg"), 56 to 96px, then one column per step with a 1px mist-300 left rule and a 25px inset:
 * the number (Jakarta 32/40, mist-500) and 16/24 text 20px below it. Four columns from 1280 (4 + 4),
 * two from 640 (4 rows of 2), stacked on phones.
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import { TELEMETRY_ENV } from "../../../data/site";

const code = (s: string) => `<code>${s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;")}</code>`;

const STEPS = [
  `Set ${code(TELEMETRY_ENV)} before the first start.`,
  "Set a password or turn on multi-user mode before anyone else can reach the server. Without either, anyone who can reach the address can use the instance.",
  `Publish port 3001 only on the interface you intend. Put TLS in front of it with ${code("ENABLE_HTTPS")} or your reverse proxy.`,
  `For disconnected use, choose local providers for chat, embeddings and vector storage, and stage the built-in models under ${code("storage/models")}.`,
  "Set password complexity rules.",
  "Keep provider keys and secrets out of shared configuration. In Kubernetes, use Secrets.",
  "Mount storage on a volume that your backup and encryption controls already cover.",
  `To accept connections from the host machine only, bind the published port to loopback in Docker: ${code("-p 127.0.0.1:3001:3001")}.`,
];
---

<Section id="hardening" divider labelledby="hardening-title">
  <div data-reveal>
    <SectionIntro title="Hardening an install today" size="lg" id="hardening-title" />
  </div>

  <ol class="hd" role="list" data-reveal="2">
    {
      STEPS.map((step, i) => (
        <li class="hd__step">
          <span class="hd__num" aria-hidden="true">
            {i + 1}
          </span>
          <p class="hd__text" set:html={step} />
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .hd {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-10) 0;
    margin-top: var(--gap-h2-grid);
  }
  @media (min-width: 640px) {
    .hd {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--space-12);
    }
  }
  /* Four columns from 1280; at 1024 a quarter column is narrower than DISABLE_TELEMETRY="true". */
  @media (min-width: 1280px) {
    .hd {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .hd__step {
    min-width: 0;
    padding: var(--space-3) var(--space-6) 0 25px;
    border-left: 1px solid var(--color-line);
  }
  .hd__num {
    display: block;
    font-size: var(--fs-step-num);
    line-height: var(--lh-step-num);
    color: var(--mist-500);
  }
  .hd__text {
    max-width: 18rem;
    margin-top: var(--space-5);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--mist-600);
  }
</style>

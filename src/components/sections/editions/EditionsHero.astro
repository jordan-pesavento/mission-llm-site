---
/*
 * Editions > Hero (copy.md, verbatim). Package C.
 * Visual system (reference, anythingllm.com): the hero's mist wash under the header, an eyebrow, a
 * 60/63 H1 and an 18/28 subhead. The edition cards follow inside the same wash-to-page flow
 * (EditionCards starts with no top padding), so the hero keeps only the text-to-cards gap below.
 * No prices anywhere: pricing is not decided.
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
---

<Section pad="hero" wash labelledby="editions-title" class="editions-hero">
  <div class="editions-hero__intro" data-reveal>
    <SectionIntro level={1} eyebrow="Editions" title="Start free. Add governance and support when you need them." id="editions-title" />
    <p class="lead editions-hero__lead">
      Mission LLM Community is the full application you can run today. Mission LLM Enterprise is for organizations that
      need support, help deploying on their networks, and the governance features on our roadmap. Pricing is not
      published yet.
    </p>
  </div>
</Section>

<style>
  :global(.section.editions-hero) {
    padding-bottom: var(--gap-h2-grid);
  }
  .editions-hero__intro {
    max-width: 56rem;
  }
  .editions-hero__lead {
    max-width: 40rem;
    margin-top: var(--gap-h2-text);
  }
</style>

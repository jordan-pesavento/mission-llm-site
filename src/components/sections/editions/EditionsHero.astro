---
/*
 * Editions > Hero (copy.md, verbatim). Package C.
 * The page's top section, so it is DARK (HERO-REVISION.md: each inner page's hero-equivalent top
 * section is navy, and the sections alternate below it; the edition cards that follow are light).
 * From 1024 the text sits beside the lecture-hall illustration, inlined with <Art> so it recolors to
 * the dark tone (light strokes on navy). Below 1024 the art is hidden, so the phone hero stays text
 * only. The H1 names classes and teams: this page also sells Enterprise to organizations.
 * No prices anywhere: pricing is not decided.
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import Art from "../../ui/Art.astro";
---

<Section tone="dark" pad="hero" labelledby="editions-title" class="editions-hero">
  <div class="editions-hero__grid">
    <div class="editions-hero__intro" data-reveal>
      <SectionIntro level={1} eyebrow="Editions" title="Free for every class and team." id="editions-title" />
      <p class="lead editions-hero__lead">
        Mission LLM Community is the full system, free to self-host for one course, a training cohort, a department or a whole
        school. Mission LLM Enterprise is for schools and organizations that need support, help deploying on their networks, and
        the governance features on our roadmap. Pricing is not published yet.
      </p>
    </div>
    <div class="editions-hero__art" data-reveal="2">
      <Art src="images/scenes/lecture-hall.svg" draw />
    </div>
  </div>
</Section>

<style>
  .editions-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    row-gap: var(--space-10);
  }
  .editions-hero__intro {
    min-width: 0;
    max-width: 56rem;
  }
  .editions-hero__lead {
    max-width: 40rem;
    margin-top: var(--space-6);
  }
  .editions-hero__art {
    display: none;
  }
  @media (min-width: 1024px) {
    .editions-hero__grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--split-gap);
    }
    .editions-hero__art {
      display: block;
      min-width: 0;
      margin-inline: auto;
      width: 100%;
      max-width: 400px;
    }
  }
</style>

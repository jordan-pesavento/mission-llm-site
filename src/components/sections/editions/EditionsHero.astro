---
/*
 * Editions > Hero (copy.md). Work package B. Level 1 intro across columns 1 to 9 from 960px.
 * The bottom padding is the text-to-visual gap, because the edition cards follow directly
 * (EditionCards uses pad="flush-top"). No actions here: the page's two CTAs live on the cards.
 * No prices anywhere: pricing is not decided.
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
---

<Section tone="light" labelledby="editions-title" class="editions-hero">
  <div class="layout-grid">
    <div class="editions-hero__intro" data-reveal>
      <SectionIntro
        level={1}
        eyebrow="Editions"
        title="Start free. Add governance and support when you need them."
        id="editions-title"
        lead="Mission LLM Community is the full application you can run today. Mission LLM Enterprise is for organizations that need support, help deploying on their networks, and the governance features on our roadmap. Pricing is not published yet."
      />
    </div>
  </div>
</Section>

<style>
  :global(.section.editions-hero) {
    padding-bottom: var(--gap-visual);
  }
  .editions-hero__intro :global(.intro__lead) {
    max-width: 58ch;
  }
  @media (min-width: 960px) {
    .editions-hero__intro {
      grid-column: 1 / span 10;
    }
  }
  @media (min-width: 1680px) {
    .editions-hero__intro {
      grid-column: 1 / span 9;
    }
  }
</style>

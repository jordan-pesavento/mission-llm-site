---
/*
 * Editions > Community and Enterprise cards (copy.md, verbatim). Package C.
 * Two equal-height cards (stacked below 1024, side by side from 1024 with the 32px card gap). Each
 * card is a white surface with the site's radius 16 and hairline ring: name (Clash 36/40), price line
 * (no prices: pricing is not decided), summary (18/28), what it includes, then its one action at the
 * bottom so both 44px buttons share a baseline. From 1024 the cards share row tracks (CSS subgrid),
 * so heads, rules and buttons line up; Community's Support group follows its list at the normal
 * rhythm and the slack left by the taller Enterprise card sits above the Download button. Support
 * links the app repository's GitHub issues (public, Issues on); vulnerabilities go through private
 * reporting (/security#report). From 1280 the lists run in two columns (eight Community
 * items, six planned items, so both columns stay even). The two chat items are real today: admins
 * and managers read and export workspace chats (server/endpoints/system.js:1178-1235), and admins
 * embed a workspace as a chat widget (server/endpoints/embedManagement.js, frontend/public/embed).
 * Enterprise lists its planned features only under the <Badge /> "In development" label, each with the
 * amber in-development mark (StatusMark), followed by its fine print.
 * Its service offerings (deployment assistance, support by agreement) are not confirmed yet
 * (copy.md: TODO confirm offering), so they sit under a "Planned" label with the blue planned mark
 * instead of a check. The action is "Contact us", a secondary button to the contact form
 * (CONTACT_HREF, /contact). The price line says pricing is not published yet (copy.md has "Contact
 * us" there; the button already says it, so the line states the fact instead).
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import Button from "../../ui/Button.astro";
import Badge from "../../ui/Badge.astro";
import StatusMark from "../../ui/StatusMark.astro";
import { CONTACT_HREF, COUNTS, DOWNLOAD_HREF, PLACEHOLDER } from "../../../data/site";

const communityIncludes = [
  "Workspaces, threads and document retrieval with sources.",
  `${COUNTS.llmProviders} model providers, ${COUNTS.vectorDatabases} vector databases and ${COUNTS.embeddingEngines} embedding engines.`,
  "Agents, custom skills, MCP servers and the agent flow builder.",
  "Multi-user mode with admin, manager and default roles.",
  "Chat history review and export for admins and managers.",
  "An embeddable chat widget for any workspace.",
  "Event log, API keys and the developer API.",
  "Docker, Compose, Kubernetes, Helm and OpenShift deployment.",
];

const enterpriseIncludes = ["Everything in Community."];

// TODO: confirm offering (copy.md). Shown as planned until the owner confirms both.
const enterpriseServices = [
  "Deployment assistance, including disconnected and restricted networks.",
  "Support on terms set in your agreement.",
];

const enterprisePlanned = [
  "Single sign-on with OIDC, SAML and smart card sign-in, plus SCIM provisioning.",
  "Multi-factor authentication and revocable sessions.",
  "Workspace roles, custom roles and groups.",
  "A tamper-evident audit trail with SIEM forwarding.",
  "Model and tool policy, retention and legal hold.",
  "An offline distribution kit with signed release bundles.",
];
---

<Section id="plans" labelledby="plans-title" class="plans">
  <SectionIntro srOnly title="Community and Enterprise" id="plans-title" />
  <div class="editions">
    <article class="edition" aria-labelledby="edition-community" data-reveal>
      <header class="edition__head">
        <h3 id="edition-community" class="h2 edition__name">Community</h3>
        <p class="edition__price">Free to self-host</p>
        <p class="edition__summary">Everything Mission LLM does today, on hardware you control.</p>
      </header>

      <div class="edition__body">
        <div class="edition__group">
          <h4 class="edition__group-title">Includes</h4>
          <ul class="includes includes--cols" role="list">
            {
              communityIncludes.map((text) => (
                <li>
                  <StatusMark kind="yes" label={false} size="sm" class="includes__mark" />
                  <span>{text}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="edition__group">
          <h4 class="edition__group-title">Support</h4>
          <!-- TODO: link the documentation once it exists (PLACEHOLDER.docsUrl). -->
          <p class="edition__text">
            Self-supported. Report problems in the <a href={`${PLACEHOLDER.repositoryUrl}/issues`}>GitHub repository’s issues</a>. Full
            documentation will be published with the first release.
          </p>
        </div>
      </div>

      <div class="edition__foot">
        <Button href={DOWNLOAD_HREF}>Download</Button>
      </div>
    </article>

    <article class="edition" aria-labelledby="edition-enterprise" data-reveal="2">
      <header class="edition__head">
        <h3 id="edition-enterprise" class="h2 edition__name">Enterprise</h3>
        <p class="edition__price">Pricing not published yet</p>
        <p class="edition__summary">
          Community, plus planned support and deployment help, and our roadmap’s governance features as they ship.
        </p>
      </header>

      <div class="edition__body">
        <div class="edition__group">
          <h4 class="edition__group-title">Includes</h4>
          <ul class="includes" role="list">
            {
              enterpriseIncludes.map((text) => (
                <li>
                  <StatusMark kind="yes" label={false} size="sm" class="includes__mark" />
                  <span>{text}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="edition__group edition__group--planned">
          <!-- TODO: confirm offering for "Deployment assistance" and "Support on terms set in your agreement". -->
          <h4 class="edition__group-title edition__group-title--planned">
            <span>Services</span>
            <Badge kind="planned" />
          </h4>
          <ul class="planned" role="list">
            {
              enterpriseServices.map((text) => (
                <li>
                  <StatusMark kind="planned" label={false} size="sm" class="planned__mark" />
                  <span>{text}</span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="edition__group edition__group--planned">
          <h4 class="edition__group-title edition__group-title--planned">
            <span>Planned for Enterprise</span>
            <Badge />
          </h4>
          <ul class="planned" role="list">
            {
              enterprisePlanned.map((text) => (
                <li>
                  <StatusMark kind="dev" label={false} size="sm" class="planned__mark" />
                  <span>{text}</span>
                </li>
              ))
            }
          </ul>
          <p class="edition__fine">
            Planned features are in development. Which features land in which edition may change before release.
          </p>
        </div>
      </div>

      <div class="edition__foot">
        <Button href={CONTACT_HREF} variant="secondary">Contact us</Button>
      </div>
    </article>
  </div>
</Section>

<style>
  :global(.section.plans) {
    padding-bottom: var(--pad-section);
  }
  .editions {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--card-gap);
  }
  @media (min-width: 1024px) {
    .editions {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .edition {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(1.5rem, 1.2rem + 1.2vw, 2.5rem);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }

  /* Head: name, price line, summary. */
  .edition__head {
    padding-bottom: var(--space-8);
  }
  .edition__price {
    margin-top: var(--space-3);
    font-size: var(--fs-h4);
    line-height: var(--lh-h4);
    font-weight: var(--fw-medium);
    color: var(--mist-700);
  }
  .edition__summary {
    margin-top: var(--space-5);
    max-width: 30rem;
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--color-text-muted);
  }

  /* Body: the groups. It grows to fill the card, so the action always sits at the bottom. */
  .edition__body {
    flex: 1 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .edition__group {
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-line);
  }
  .edition__group-title {
    margin-bottom: var(--space-3);
    font-family: var(--font-sans);
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    font-weight: var(--fw-medium);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--color-text-muted);
  }
  .edition__group-title--planned {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
  }
  .edition__group-title--planned :global(.badge) {
    letter-spacing: 0;
    text-transform: none;
  }

  .includes li,
  .planned li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding-block: var(--space-2);
    break-inside: avoid;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--mist-700);
  }
  .includes li :global(.includes__mark),
  .planned li :global(.planned__mark) {
    min-height: 0;
    margin-top: 2px;
  }
  .planned li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding-block: var(--space-2);
    break-inside: avoid;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--mist-700);
  }
  .includes__mark {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    margin-top: 2px;
    border-radius: var(--radius-full);
    color: #ffffff;
    background: var(--navy-950);
  }
  .planned li {
    color: var(--color-text-muted);
  }
  .edition__group--planned {
    border-top-style: dashed;
    border-top-color: var(--mist-400);
  }
  .edition__fine {
    margin-top: var(--space-4);
    max-width: 60ch;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-quiet);
  }
  .edition__text {
    padding-block: var(--space-2);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--mist-700);
  }

  .edition__foot {
    display: flex;
    align-items: flex-start;
    padding-top: var(--space-8);
  }

  /*
   * Side by side (1024 and up): each card is a subgrid of the three shared rows (head, body, foot),
   * so the rules under the heads and the two buttons line up across the cards whatever the text
   * lengths. Without subgrid support the flex column above still works.
   */
  @supports (grid-template-rows: subgrid) {
    @media (min-width: 1024px) {
      .edition {
        display: grid;
        grid-row: span 3;
        grid-template-rows: subgrid;
        row-gap: 0;
      }
    }
  }

  /* Wide cards (1280 and up): the lists run in two columns. */
  @media (min-width: 1280px) {
    .includes--cols,
    .planned {
      columns: 2;
      column-gap: var(--space-8);
    }
  }
</style>

---
/*
 * Editions > Comparison (copy.md, verbatim). Package C.
 * A real table with text labels (Included, Not included, In development, Planned, Self-supported), each
 * with its StatusMark (green check, red X, amber wrench, blue clock, slate person). "Planned" is for the
 * Enterprise services the owner has not confirmed yet (copy.md: TODO confirm offering). Rows are
 * grouped (shipping today, service, planned).
 * - Heading rail (../download/_Rail.astro): from 1024 the title sits in the left column beside the
 *   table. Nothing on the page is sticky (owner, 2026-09-27: no page chrome that overlaps sections).
 * - From 640: a table with an uppercase label header row.
 * - Below 640: .data-table--stack blocks; each capability shows its two values side by side.
 */
import Section from "../../ui/Section.astro";
import StatusMark from "../../ui/StatusMark.astro";
import Rail from "../download/_Rail.astro";

type Value = "Included" | "Not included" | "In development" | "Planned" | "Self-supported";
type Row = { capability: string; community: Value; enterprise: Value };

const groups: Row[][] = [
  [
    { capability: "Self-hosted deployment", community: "Included", enterprise: "Included" },
    { capability: "Local and cloud models, per workspace", community: "Included", enterprise: "Included" },
    { capability: "Document retrieval with sources", community: "Included", enterprise: "Included" },
    { capability: "Agents, skills, MCP and flows", community: "Included", enterprise: "Included" },
    { capability: "Multi-user roles and event log", community: "Included", enterprise: "Included" },
    { capability: "Chat history review and export", community: "Included", enterprise: "Included" },
    { capability: "Embeddable chat widget", community: "Included", enterprise: "Included" },
    { capability: "Developer API and API keys", community: "Included", enterprise: "Included" },
  ],
  [
    // TODO: confirm offering. copy.md: Enterprise "By agreement" and "Included".
    { capability: "Support", community: "Self-supported", enterprise: "Planned" },
    { capability: "Deployment assistance", community: "Not included", enterprise: "Planned" },
  ],
  [
    { capability: "SSO, SCIM and smart card sign-in", community: "Not included", enterprise: "In development" },
    { capability: "MFA and session controls", community: "Not included", enterprise: "In development" },
    { capability: "Tamper-evident audit trail", community: "Not included", enterprise: "In development" },
    { capability: "Model and tool policy", community: "Not included", enterprise: "In development" },
    { capability: "Retention and legal hold", community: "Not included", enterprise: "In development" },
  ],
];

// Every value carries its mark: a green check, a red X, an amber wrench (in development), a blue clock
// (planned) or a slate person (self-supported), always beside its word (StatusMark.astro).
const KIND: Record<Value, "yes" | "no" | "dev" | "planned" | "self"> = {
  Included: "yes",
  "Not included": "no",
  "In development": "dev",
  Planned: "planned",
  "Self-supported": "self",
};
---

<Section id="compare" tone="dark" labelledby="compare-title">
  <Rail title="Comparison" id="compare-title">
    <table class="data-table data-table--stack cmp">
      <caption class="sr-only">Community and Enterprise capabilities</caption>
      <thead>
        <tr>
          <th scope="col">Capability</th>
          <th scope="col">Community</th>
          <th scope="col">Enterprise</th>
        </tr>
      </thead>
      {
        groups.map((rows) => (
          <tbody>
            {rows.map((row) => (
              <tr>
                <th scope="row">{row.capability}</th>
                {(["community", "enterprise"] as const).map((col) => {
                  const value = row[col];
                  return (
                    <td data-label={col === "community" ? "Community" : "Enterprise"}>
                      <StatusMark kind={KIND[value]} label={value} />
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        ))
      }
    </table>
  </Rail>
</Section>

<style>
  /* Separate borders: with collapsed borders Chrome let row text paint over the stuck header row. */
  .cmp {
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
  }
  .cmp th,
  .cmp td {
    vertical-align: middle;
  }
  .cmp thead th:first-child {
    width: 44%;
  }
  .cmp tbody th {
    font-weight: var(--fw-medium);
  }
  /* A stronger rule between groups (shipping today, service, planned). */
  .cmp tbody:not(:last-child) tr:last-child > * {
    border-bottom-color: var(--mist-400);
  }

  /* Table form (640 and up). */
  @media (min-width: 640px) {
    .cmp thead th {
      padding-top: var(--space-4);
      padding-bottom: var(--space-3);
      background: var(--color-bg);
      border-bottom: 0;
      box-shadow: inset 0 -1px 0 var(--mist-400);
      font-size: var(--fs-small);
      line-height: var(--lh-small);
      font-weight: var(--fw-medium);
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      color: var(--color-text-muted);
    }
    .cmp th,
    .cmp td {
      padding-block: var(--space-4);
    }
  }

  /* Phones: each capability is a block, with its two values side by side. */
  @media (max-width: 639.98px) {
    .cmp tbody tr {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-4);
    }
    .cmp tbody th {
      grid-column: 1 / -1;
      font-weight: var(--fw-semibold);
    }
    .cmp tbody td {
      margin-top: var(--space-2);
    }
    .cmp tbody td[data-label]::before {
      margin-bottom: var(--space-1);
    }
    .cmp tbody:not(:last-child) tr:last-child {
      border-bottom-color: var(--mist-400);
    }
  }
</style>

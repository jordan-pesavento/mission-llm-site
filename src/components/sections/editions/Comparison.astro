---
/*
 * Editions > Comparison (copy.md, verbatim). Package C.
 * A real table with text labels (Included, Not included, In development, Planned, Self-supported); a
 * check only reinforces "Included", and "Not included" is muted text. "In development" uses <Badge />,
 * the site's one roadmap marker; "Planned" uses the same badge with its own word, for the Enterprise
 * services the owner has not confirmed yet (copy.md: TODO confirm offering; copy.md has "By
 * agreement" and "Included" there). Rows are grouped (shipping today, service, planned).
 * - Heading rail (../download/_Rail.astro): from 1024 the title sticks in the left column
 *   (5fr | 12fr, 94px gap) beside the table.
 * - From 640: a table; the header row (the reference's 14/20 uppercase label) sticks under the site
 *   header while you scroll.
 * - Below 640: .data-table--stack blocks; each capability shows its two values side by side.
 */
import Section from "../../ui/Section.astro";
import Badge from "../../ui/Badge.astro";
import Icon from "../../ui/Icon.astro";
import Rail from "../download/_Rail.astro";

type Value = "Included" | "Not included" | "In development" | "Planned" | "Self-supported";
type Row = { capability: string; community: Value; enterprise: Value };

const groups: Row[][] = [
  [
    { capability: "Self-hosted deployment", community: "Included", enterprise: "Included" },
    { capability: "Local and cloud models, per workspace", community: "Included", enterprise: "Included" },
    { capability: "Document retrieval with sources", community: "Included", enterprise: "Included" },
    { capability: "Agents, skills, MCP and flows", community: "Included", enterprise: "Included" },
    { capability: "Multi-user roles and event log", community: "Included", enterprise: "Included" },
    { capability: "Chat history review and export", community: "Included", enterprise: "Included" },
    { capability: "Embeddable chat widget", community: "Included", enterprise: "Included" },
    { capability: "Developer API and API keys", community: "Included", enterprise: "Included" },
  ],
  [
    // TODO: confirm offering. copy.md: Enterprise "By agreement" and "Included".
    { capability: "Support", community: "Self-supported", enterprise: "Planned" },
    { capability: "Deployment assistance", community: "Not included", enterprise: "Planned" },
  ],
  [
    { capability: "SSO, SCIM and smart card sign-in", community: "Not included", enterprise: "In development" },
    { capability: "MFA and session controls", community: "Not included", enterprise: "In development" },
    { capability: "Tamper-evident audit trail", community: "Not included", enterprise: "In development" },
    { capability: "Model and tool policy", community: "Not included", enterprise: "In development" },
    { capability: "Retention and legal hold", community: "Not included", enterprise: "In development" },
  ],
];

// Only "Included" carries a mark. "Not included" is muted text with no glyph (a minus reads as a dash).
const KIND: Record<Value, string> = {
  Included: "yes",
  "Not included": "no",
  "In development": "dev",
  Planned: "dev",
  "Self-supported": "text",
};
---

<Section id="compare" tone="dark" labelledby="compare-title">
  <Rail title="Comparison" id="compare-title" sticky>
    <table class="data-table data-table--stack cmp">
      <caption class="sr-only">Community and Enterprise capabilities</caption>
      <thead>
        <tr>
          <th scope="col">Capability</th>
          <th scope="col">Community</th>
          <th scope="col">Enterprise</th>
        </tr>
      </thead>
      {
        groups.map((rows) => (
          <tbody>
            {rows.map((row) => (
              <tr>
                <th scope="row">{row.capability}</th>
                {(["community", "enterprise"] as const).map((col) => {
                  const value = row[col];
                  return (
                    <td data-label={col === "community" ? "Community" : "Enterprise"}>
                      {value === "In development" ? (
                        <Badge />
                      ) : value === "Planned" ? (
                        <Badge>Planned</Badge>
                      ) : (
                        <span class:list={["status", `status--${KIND[value]}`]}>
                          <span class="status__icon" aria-hidden="true">
                            {value === "Included" && <Icon name="check" size={14} />}
                          </span>
                          <span>{value}</span>
                        </span>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))}
          </tbody>
        ))
      }
    </table>
  </Rail>
</Section>

<style>
  /* Separate borders: with collapsed borders Chrome let row text paint over the stuck header row. */
  .cmp {
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 0;
  }
  .cmp th,
  .cmp td {
    vertical-align: middle;
  }
  .cmp thead th:first-child {
    width: 44%;
  }
  .cmp tbody th {
    font-weight: var(--fw-medium);
  }
  /* A stronger rule between groups (shipping today, service, planned). */
  .cmp tbody:not(:last-child) tr:last-child > * {
    border-bottom-color: var(--mist-400);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 28px;
    white-space: nowrap;
    font-weight: var(--fw-medium);
  }
  .status__icon {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    border-radius: var(--radius-full);
  }
  .status--yes {
    color: var(--color-heading);
  }
  .status--yes .status__icon {
    color: var(--color-bg);
    background: var(--color-heading);
  }
  .status--no {
    color: var(--color-text-quiet);
  }
  .status--text {
    color: var(--color-heading);
  }

  /* Table form (640 and up): the header row sticks under the site header. */
  @media (min-width: 640px) {
    .cmp thead th {
      position: sticky;
      top: calc(var(--header-h) + 1px);
      z-index: 2;
      padding-top: var(--space-4);
      padding-bottom: var(--space-3);
      background: var(--color-bg);
      border-bottom: 0;
      box-shadow: inset 0 -1px 0 var(--mist-400);
      font-size: var(--fs-small);
      line-height: var(--lh-small);
      font-weight: var(--fw-medium);
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      color: var(--color-text-muted);
    }
    .cmp th,
    .cmp td {
      padding-block: var(--space-4);
    }
  }

  /* Phones: each capability is a block, with its two values side by side. */
  @media (max-width: 639.98px) {
    .cmp tbody tr {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-4);
    }
    .cmp tbody th {
      grid-column: 1 / -1;
      font-weight: var(--fw-semibold);
    }
    .cmp tbody td {
      margin-top: var(--space-2);
    }
    .cmp tbody td[data-label]::before {
      margin-bottom: var(--space-1);
    }
    .cmp tbody:not(:last-child) tr:last-child {
      border-bottom-color: var(--mist-400);
    }
    /* Values without a mark start at the label's edge, like the rest. */
    .status--no .status__icon,
    .status--text .status__icon {
      display: none;
    }
  }
</style>

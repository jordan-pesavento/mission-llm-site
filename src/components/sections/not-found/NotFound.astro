---
/*
 * 404. Package C.
 * Copy: src/content/copy.md > 404 (display code, heading, body, links verbatim).
 * Visual system: the reference's final CTA composition on the hero's mist wash. Centered: the code
 * as the eyebrow line, a 60/63 H1, an 18/28 line, and the three links as 44px, radius-8 buttons in
 * one row (Home is the primary action). Above the code, centered, a small isometric line
 * illustration in the steps style (public/images/scenes/not-found.svg: a course binder with a
 * missing page), decorative, 24px above the "404" line, 200px from 640 and 160px below. It is
 * above the fold, so it loads eagerly. The block fills most of the first screen so the footer
 * does not float mid-page (width-based on purpose: a height-based minimum grows with full-page
 * captures).
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import Button from "../../ui/Button.astro";
import Art from "../../ui/Art.astro";
import { DOWNLOAD_HREF } from "../../../data/site";
---

<Section tone="dark" pad="cta" divider labelledby="not-found-title" class="nf-section">
  <div class="nf" data-reveal>
    <Art src="images/scenes/not-found.svg" draw class="nf__art" />
    <SectionIntro level={1} align="center" eyebrow="404" title="Page not found." id="not-found-title" />
    <p class="lead nf__lead">The page you asked for does not exist or has moved.</p>
    <nav class="nf__nav" aria-label="Suggested pages" data-row="nf-actions">
      <Button href="/">Home</Button>
      <Button href={DOWNLOAD_HREF} variant="secondary">Download</Button>
      <Button href="/security" variant="secondary">Security overview</Button>
    </nav>
  </div>
</Section>

<style>
  .nf {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  @media (min-width: 1024px) {
    .nf {
      min-height: min(28rem, 34vw);
    }
  }
  .nf__art {
    display: block;
    width: 160px;
    height: auto;
    aspect-ratio: 1;
    /* The binder is centred in its square (about 38/250 empty below it), so 12px reads as the
       intended gap to the 404 code. */
    margin-bottom: var(--space-3);
  }
  @media (min-width: 640px) {
    .nf__art {
      width: 200px;
    }
  }
  .nf__lead {
    max-width: var(--measure);
    margin-top: var(--gap-h2-text);
  }
  .nf__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--gap-text-action);
  }
</style>

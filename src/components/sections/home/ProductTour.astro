---
/*
 * Home > Product tour (copy.md: Home > Product tour). Work package A. Anchor #product (nav).
 * Real tabs from src/scripts/tabs.ts (vertical tablist, arrow keys, 200ms crossfade, no
 * auto-advance, deep links through data-tabs-hash):
 * - 960px and up: the tablist sits in columns 1 to 4 (sticky) and the open panel in 5 to 12.
 * - Below 960px: an accordion. The tablist becomes `display: contents` and CSS `order` places
 *   each open panel, image included, right under its own tab. DOM order stays tab list, then
 *   panels, so the tabs pattern and roving focus are unchanged.
 * - Without JS: the tablist stays hidden and all five panels render in order, each with a kicker
 *   label and its own heading.
 * Each panel shows its own screen: a 16:10 view of a concept render (every one different, none of
 * them the hero frame) and, below 640px, a phone detail at its own size so UI text stays legible.
 * Each keeps the concept caption (Screenshot default).
 * Below 960px the accordion is a disclosure list (every row is a Tab stop with aria-expanded);
 * from 960px it is a tablist with a roving tabindex (src/scripts/tabs.ts, data-tabs-disclosure).
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import Screenshot from "../../ui/Screenshot.astro";
import Icon from "../../ui/Icon.astro";
import { COUNTS } from "../../../data/site";

type Item = {
  id: string;
  label: string;
  title: string;
  /** Trusted HTML from this file only (used for the @agent code span). */
  body: string;
  facts: string[];
  shot: { name: ShotName; view?: string; phone: string; alt: string; phoneAlt?: string };
};
type ShotName = "chat-sources" | "chat-frame" | "agent-run" | "workspace-model" | "admin-users";

const items: Item[] = [
  {
    id: "documents",
    label: "Document knowledge",
    title: "Answers drawn from your documents, with the sources listed.",
    body: "Add files to a workspace and Mission LLM parses, embeds and indexes them on your server. For each question it finds the most relevant passages, gives them to the model, and lists the documents it used under the answer.",
    facts: [
      "PDF, Word, PowerPoint, Excel, OpenDocument, text, Markdown, CSV, HTML, EPUB and mailbox files.",
      "OCR for images and scanned PDFs. Local transcription for audio and video.",
      "Connectors for GitHub, GitLab, Gitea, Confluence, websites, YouTube transcripts, Obsidian, Drupal Wiki and Paperless-ngx.",
    ],
    shot: {
      name: "chat-sources",
      view: "documents",
      phone: "chat-sources-phone",
      alt: "The Sources panel of an answer listing three documents, beside a viewer that shows the cited passage of a configuration management plan.",
      phoneAlt: "A document viewer showing the cited passage of a configuration management plan.",
    },
  },
  {
    id: "agents",
    label: "Agents and tools",
    title: "Agents that work with the tools you turn on.",
    body: "Type <code>@agent</code> to hand a task to an agent, or use Automatic mode with models that support native tool calling. Admins decide which skills are on. Built-in skills search your documents, summarize files, scrape and search the web, build charts and query SQL databases.",
    facts: [
      "Connect Model Context Protocol (MCP) servers over stdio, SSE or streamable HTTP.",
      "Add custom agent skills, and chain steps in the no-code agent flow builder.",
      "Web search through a provider you choose, including self-hosted SearXNG.",
      "The SQL skill connects to PostgreSQL, MySQL and SQL Server.",
    ],
    shot: {
      name: "agent-run",
      phone: "agent-run-phone",
      alt: "An agent run in Mission LLM: the agent searched the workspace documents, called a GitLab MCP server tool and summarized attachments, then listed two change requests that block a release.",
      phoneAlt: "The steps of an agent run: a document search, a GitLab MCP server tool call and a summary of attachments.",
    },
  },
  {
    id: "workspaces",
    label: "Workspaces and threads",
    title: "Workspaces keep teams and subjects apart.",
    body: "Each workspace has its own documents, system prompt, model, chat mode and retrieval settings. Threads keep separate lines of work inside a workspace. In multi-user mode, people see only the workspaces they have been added to.",
    facts: [
      "Choose Automatic, Chat or Query mode for each workspace.",
      "Pin a document so the model sees its full text on every question.",
      "Fork a thread to explore a different direction without losing the original.",
      "Suggested prompts help new users start.",
    ],
    shot: {
      name: "chat-frame",
      view: "workspaces",
      phone: "chat-frame/rail",
      alt: "The workspace list in Mission LLM with the threads of an Engineering Specs workspace, beside an answered question.",
      phoneAlt: "The workspace list in Mission LLM with the threads of an Engineering Specs workspace.",
    },
  },
  {
    id: "models",
    label: "Model choice",
    title: "Local or cloud models, chosen per workspace.",
    body: `Pick from ${COUNTS.llmProviders} model providers. Run models on your own hardware with Ollama, LM Studio, LocalAI, KoboldCPP, NVIDIA NIM or any OpenAI-compatible server. Or connect cloud services you have approved, such as Azure OpenAI, AWS Bedrock, Google Vertex AI, OpenAI or Anthropic.`,
    facts: [
      "Set a system default, then override it for any workspace and for that workspace's agents.",
      "Route messages between models with rules in the Model Router.",
      `${COUNTS.embeddingEngines} embedding engines, including a built-in embedder that runs on the server's CPU.`,
    ],
    shot: {
      name: "workspace-model",
      phone: "workspace-model-phone",
      alt: "Workspace chat settings with the provider list open, separating local runtimes such as Ollama and LM Studio from cloud services such as Azure OpenAI and AWS Bedrock.",
      phoneAlt: "The workspace provider list, separating local runtimes such as Ollama from cloud services such as Azure OpenAI.",
    },
  },
  {
    id: "users",
    label: "Multi-user and roles",
    title: "Accounts and roles for a whole team.",
    body: "Turn on multi-user mode and each person signs in with their own account. Admins control the whole system. Managers run workspaces and users but cannot change model, vector database or embedding connections. Default users chat only in the workspaces they are assigned to.",
    facts: [
      "Invitations, account suspension and per-user daily message limits.",
      "An admin event log of sign-ins, failed sign-ins, and changes to users, API keys, workspaces and documents.",
      "Admins can export chat history as CSV, JSON or JSONL.",
    ],
    shot: {
      name: "admin-users",
      phone: "admin-users-phone",
      alt: "The Users page in Mission LLM settings, listing accounts with admin, manager and default roles, daily message limits and one suspended account.",
      phoneAlt: "A list of Mission LLM accounts with their admin, manager and default roles.",
    },
  },
];

const pad = (n: number) => String(n).padStart(2, "0");
---

<Section id="product" tone="light" hairline labelledby="product-title">
  <div class="layout-grid">
    <div class="tour-intro" data-reveal>
      <SectionIntro
        eyebrow="Product"
        title="One workspace for your documents, models and agents."
        id="product-title"
        lead="Every capability described here ships today. The screens show the next interface, which is in development."
      />
    </div>
  </div>

  <div class="tour" data-tabs data-tabs-hash data-tabs-disclosure="(max-width: 959.98px)" data-tour data-reveal="2">
    <div class="tour__list" role="tablist" aria-label="Product tour" aria-orientation="vertical" hidden>
      {
        items.map((item, i) => (
          <button
            type="button"
            role="tab"
            class="tour__tab"
            id={`tour-tab-${item.id}`}
            aria-controls={`tour-${item.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? 0 : -1}
            style={`--order: ${i * 2}`}
          >
            <span class="tour__idx tnum" aria-hidden="true">
              {pad(i + 1)}
            </span>
            <span class="tour__label">{item.label}</span>
            <Icon name="caret-down" size={20} class="tour__chev" />
            <Icon name="arrow-right" size={20} class="tour__arrow" />
          </button>
        ))
      }
    </div>

    {
      items.map((item, i) => (
        <div
          class="tour__panel"
          role="tabpanel"
          id={`tour-${item.id}`}
          aria-labelledby={`tour-tab-${item.id}`}
          style={`--order: ${i * 2 + 1}`}
        >
          <p class="tour__kicker eyebrow">
            <span class="tnum">{pad(i + 1)}</span> {item.label}
          </p>
          <div class="tour__body">
            <h3 class="h3 tour__title">{item.title}</h3>
            <p class="tour__copy" set:html={item.body} />
            <ul class="tour__facts" role="list">
              {item.facts.map((f) => (
                <li>{f}</li>
              ))}
            </ul>
            <div class="tour__shot">
              <Screenshot
                name={item.shot.name}
                view={item.shot.view}
                phone={item.shot.phone}
                ratio="16 / 10"
                alt={item.shot.alt}
                phoneAlt={item.shot.phoneAlt}
                sizes="(min-width: 2200px) 1180px, (min-width: 1880px) 1040px, (min-width: 960px) 56vw, calc(100vw - 64px)"
              />
            </div>
          </div>
        </div>
      ))
    }
  </div>
</Section>

<script>
  import "../../../scripts/tabs.ts";

  // Accordion (below 960px): opening an item collapses the one above it, which can move the tab
  // the reader just chose above the sticky header. Bring it back into view; no smooth scrolling.
  const tour = document.querySelector<HTMLElement>("[data-tour]");
  const accordion = window.matchMedia("(max-width: 959.98px)");
  tour?.addEventListener("tabs:change", (event) => {
    if (!accordion.matches) return;
    const tab = (event as CustomEvent<{ tab: HTMLElement }>).detail.tab;
    const headerH = parseFloat(getComputedStyle(document.documentElement).getPropertyValue("--header-h")) || 72;
    const top = tab.getBoundingClientRect().top;
    if (top < headerH) window.scrollBy(0, top - headerH - 8);
  });
</script>

<style>
  .tour-intro {
    grid-column: 1 / -1;
  }
  @media (min-width: 960px) {
    .tour-intro {
      grid-column: 1 / span 8;
    }
  }
  .tour {
    margin-top: var(--gap-visual);
  }

  /* ---------- Tabs ---------- */
  .tour__tab {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-4);
    width: 100%;
    min-height: 64px;
    padding: var(--space-3) var(--space-4) var(--space-3) var(--space-5);
    border-top: 1px solid var(--color-hairline);
    text-align: left;
    font-size: var(--fs-body);
    line-height: 1.3;
    font-weight: 500;
    color: var(--color-text-2);
    transition:
      color var(--dur-hover) var(--ease-standard),
      background-color var(--dur-hover) var(--ease-standard);
  }
  /* Active marker: a 2px accent bar on the leading edge. */
  .tour__tab::before {
    content: "";
    position: absolute;
    left: 0;
    top: -1px;
    bottom: 0;
    width: 2px;
    background: transparent;
    transition: background-color var(--dur-hover) var(--ease-standard);
  }
  .tour__tab:hover {
    color: var(--color-text);
    background-color: rgb(23 48 99 / 0.04);
  }
  .tour__tab:is([aria-selected="true"], [aria-expanded="true"]) {
    color: var(--color-text);
    background-color: var(--silver-50);
  }
  .tour__tab:is([aria-selected="true"], [aria-expanded="true"])::before {
    background: var(--color-accent);
  }
  .tour__tab:focus-visible {
    outline-offset: -2px;
    border-radius: 0;
  }
  .tour__idx {
    flex: none;
    min-width: 2ch;
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-text-3);
    transition: color var(--dur-hover) var(--ease-standard);
  }
  .tour__tab:is([aria-selected="true"], [aria-expanded="true"]) .tour__idx {
    color: var(--color-accent);
  }
  .tour__label {
    flex: 1 1 auto;
    min-width: 0;
    white-space: nowrap;
  }
  .tour__tab :global(.tour__chev),
  .tour__tab :global(.tour__arrow) {
    flex: none;
    color: var(--color-text-3);
  }
  .tour__tab :global(.tour__arrow) {
    display: none;
  }

  /* ---------- Panels ---------- */
  .tour__panel:focus-visible {
    outline-offset: 4px;
    border-radius: var(--radius-lg);
  }
  .tour__kicker {
    margin-bottom: var(--space-4);
  }
  .tour__kicker .tnum {
    color: var(--color-accent);
    margin-right: var(--space-2);
  }
  .tour[data-tabs-ready] .tour__kicker {
    display: none;
  }
  /*
   * Panel body. DOM order is heading, body, facts, image (reading order for assistive tech).
   * Below 960: heading, body, image, facts. From 960: image first, then heading, body and facts;
   * from 1280 the heading spans the panel and body and facts sit side by side.
   */
  .tour__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: "title" "copy" "shot" "facts";
    column-gap: var(--grid-gap);
  }
  .tour__title {
    grid-area: title;
  }
  .tour__copy {
    grid-area: copy;
    margin-top: var(--space-4);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-2);
    max-width: var(--measure);
  }
  .tour__shot {
    grid-area: shot;
    margin-top: var(--space-6);
  }
  .tour__facts {
    grid-area: facts;
    margin-top: var(--space-6);
  }
  .tour__facts li {
    padding-block: var(--space-3);
    border-top: 1px solid var(--color-hairline);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  /* Without JS: every panel shows, separated by hairlines. */
  .tour:not([data-tabs-ready]) .tour__panel + .tour__panel {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-hairline);
  }

  /* ---------- Accordion, below 960px (JS) ---------- */
  @media (max-width: 959.98px) {
    .tour[data-tabs-ready] {
      display: flex;
      flex-direction: column;
      border-bottom: 1px solid var(--color-hairline);
    }
    .tour[data-tabs-ready] .tour__list {
      display: contents;
    }
    .tour[data-tabs-ready] .tour__tab,
    .tour[data-tabs-ready] .tour__panel {
      order: var(--order);
    }
    .tour[data-tabs-ready] .tour__panel {
      padding-block: var(--space-2) var(--space-7);
    }
    /* Accordion rows align with the panel text: no inset, no fill, no bar. */
    .tour__tab {
      padding-inline: 0;
    }
    .tour__tab::before {
      display: none;
    }
    .tour__tab:hover,
    .tour__tab:is([aria-selected="true"], [aria-expanded="true"]) {
      background-color: transparent;
    }
    .tour__tab :global(.tour__chev) {
      transition: transform var(--dur-fade) var(--ease-out);
    }
    .tour__tab:is([aria-selected="true"], [aria-expanded="true"]) :global(.tour__chev) {
      transform: rotate(180deg);
      color: var(--color-accent);
    }
  }

  /* ---------- Tabs beside the panel, from 960px ---------- */
  @media (min-width: 960px) {
    .tour__tab :global(.tour__chev) {
      display: none;
    }
    .tour__tab:is([aria-selected="true"], [aria-expanded="true"]) :global(.tour__arrow) {
      display: inline-block;
      color: var(--color-accent);
    }
    .tour[data-tabs-ready] {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      align-items: start;
    }
    .tour[data-tabs-ready] .tour__list {
      grid-column: 1 / span 4;
      grid-row: 1;
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
      border-bottom: 1px solid var(--color-hairline);
    }
    .tour[data-tabs-ready] .tour__panel {
      grid-column: 5 / -1;
      grid-row: 1;
    }
    .tour__body {
      grid-template-areas: "shot" "title" "copy" "facts";
    }
    .tour__shot {
      margin-top: 0;
      margin-bottom: var(--space-7);
    }

    /* Without JS: a label column on the left, the panel on the right, as with the tabs. */
    .tour:not([data-tabs-ready]) .tour__panel {
      display: grid;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--grid-gap);
      align-items: start;
    }
    .tour:not([data-tabs-ready]) .tour__kicker {
      grid-column: 1 / span 4;
      margin: 0;
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }
    .tour:not([data-tabs-ready]) .tour__body {
      grid-column: 5 / -1;
    }
  }
  /* The tab labels stay on one line in the 4-column rail at 960 to 1279. */
  @media (min-width: 960px) and (max-width: 1279.98px) {
    .tour__tab {
      gap: var(--space-3);
      padding-left: var(--space-4);
      padding-right: var(--space-3);
      font-size: var(--fs-ui);
    }
  }

  /* From 1280px: text and facts side by side under the image. */
  @media (min-width: 1280px) {
    .tour__body {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas: "shot shot" "title title" "copy facts";
    }
    .tour__title {
      max-width: 36ch;
    }
    .tour__copy,
    .tour__facts {
      margin-top: var(--space-5);
    }
    .tour__facts li:first-child {
      padding-top: 0;
      border-top: 0;
    }
  }
</style>

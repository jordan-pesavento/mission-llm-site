---
/*
 * Home > Security and control (copy.md). Work package B. Silver tone.
 * Two panels with one visual rule the whole site follows:
 * - "Available today" is a solid white surface with check marks (8 items, 2 columns from 640px).
 * - "In development" is a dashed, transparent panel with dashed markers and muted text, under
 *   the <Badge /> label. Roadmap items never appear in the Available list.
 * Stacked below 1680px (the two-column Available list needs the full width); side by side
 * (7 / 5 columns) from 1680px. In development items stay at the capability level: precise gaps
 * belong in the hardening guide, not on a public page.
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import ArrowLink from "../../ui/ArrowLink.astro";
import Badge from "../../ui/Badge.astro";
import Icon from "../../ui/Icon.astro";
import { TELEMETRY_ENV } from "../../../data/site";

const today: { title: string; text?: string; html?: string }[] = [
  {
    title: "Your data is stored on your server.",
    text: "Documents, embeddings, chat history and accounts live in the storage volume you mount.",
  },
  { title: "Local models only, if you choose.", text: "No cloud provider is required for chat, embeddings or search." },
  { title: "Multi-user roles.", text: "Admin, manager and default roles, with workspace membership." },
  {
    title: "Event log.",
    text: "Sign-ins, failed sign-ins, and changes to users, API keys, invites, workspaces and documents.",
  },
  { title: "API keys.", text: "Admins issue and revoke keys for the developer API." },
  {
    title: "Telemetry off with one setting.",
    html: `Set <code>${TELEMETRY_ENV.replace(/"/g, "&quot;")}</code> and no usage events are sent.`,
  },
  { title: "HTTPS and password rules.", text: "Built-in TLS with your certificate, and configurable password complexity." },
  { title: "Your network boundary.", text: "One port, published only where you choose." },
];

const inDevelopment = [
  "Single sign-on with OIDC and SAML, SCIM provisioning, and smart card (PIV and CAC) sign-in.",
  "Multi-factor authentication and sessions that can be revoked.",
  "Workspace-level roles, custom roles and groups.",
  "A complete, tamper-evident audit trail with forwarding to your SIEM.",
  "An offline mode switch with a report of every outbound connection.",
  "API key scopes and expiry.",
  "An encrypted secrets store.",
  "Model and tool policies for each workspace.",
  "Retention rules, legal hold and scoped eDiscovery export.",
];
---

<Section id="security-control" tone="silver" labelledby="security-control-title">
  <div class="layout-grid">
    <div class="sc__intro" data-reveal>
      <SectionIntro
        eyebrow="Security and control"
        title="Controls that exist today, and the ones we are building."
        id="security-control-title"
        lead="“Available today” lists only what ships in the current release. Everything else is labeled “In development”."
      />
    </div>
  </div>

  <div class="sc__panels">
    <section class="panel panel--today" aria-labelledby="sc-today" data-reveal="2">
      <h3 id="sc-today" class="panel__label"><Badge kind="today" /></h3>
      <ul class="today-list" role="list">
        {
          today.map((item) => (
            <li class="today-item">
              <span class="today-item__mark" aria-hidden="true">
                <Icon name="check" size={18} />
              </span>
              <p class="today-item__text">
                <strong>{item.title}</strong>{" "}
                {item.html ? <Fragment set:html={item.html} /> : item.text}
              </p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="panel panel--dev" aria-labelledby="sc-dev" data-reveal="3">
      <h3 id="sc-dev" class="panel__label"><Badge /></h3>
      <ul class="dev-list" role="list">
        {
          inDevelopment.map((text) => (
            <li class="dev-item">
              <span class="dev-item__mark" aria-hidden="true" />
              <p>{text}</p>
            </li>
          ))
        }
      </ul>
    </section>
  </div>

  <p class="sc__link"><ArrowLink href="/security">Read the security overview</ArrowLink></p>
</Section>

<style>
  @media (min-width: 960px) {
    .sc__intro {
      grid-column: 1 / span 9;
    }
  }
  @media (min-width: 1680px) {
    .sc__intro {
      grid-column: 1 / span 8;
    }
  }
  .sc__intro :global(.intro__title) {
    max-width: 24ch;
  }

  .sc__panels {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--grid-gap);
    margin-top: var(--gap-visual);
  }
  @media (min-width: 1680px) {
    .sc__panels {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: stretch;
    }
  }

  .panel {
    min-width: 0;
    padding: var(--card-pad);
    border-radius: var(--radius-lg);
  }
  .panel__label {
    display: flex;
    margin-bottom: var(--space-5);
    font-size: var(--fs-eyebrow);
    line-height: 1;
  }

  /* Available today: solid surface. */
  .panel--today {
    background: var(--color-surface);
    box-shadow:
      0 0 0 1px var(--color-hairline),
      var(--shadow-card);
  }
  .today-list {
    --cols: 1;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    column-gap: var(--space-7);
    margin: 0;
  }
  @media (min-width: 640px) {
    .today-list {
      --cols: 2;
      column-gap: var(--space-6);
    }
  }
  .today-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-hairline);
  }
  .today-item__mark {
    flex: none;
    display: inline-grid;
    place-items: center;
    width: 26px;
    height: 26px;
    margin-top: 2px;
    border-radius: var(--radius-full);
    color: var(--color-accent);
    background: color-mix(in srgb, var(--color-accent) 9%, transparent);
  }
  .today-item__text {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }
  .today-item__text strong {
    display: block;
    color: var(--color-text);
  }

  /* In development: dashed, transparent, muted. */
  .panel--dev {
    background: transparent;
    border: 1px dashed var(--color-hairline-dashed);
  }
  .dev-list {
    margin: 0;
  }
  @media (min-width: 640px) and (max-width: 1679.98px) {
    .dev-list {
      columns: 2;
      column-gap: var(--space-6);
    }
  }
  .dev-item {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding-block: var(--space-3);
    border-top: 1px dashed var(--color-hairline-dashed);
    break-inside: avoid;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }
  .dev-item__mark {
    flex: none;
    width: 14px;
    height: 14px;
    margin: 7px 6px 0;
    border-radius: var(--radius-full);
    border: 1.5px dashed var(--color-text-3);
  }

  .sc__link {
    margin-top: var(--space-6);
  }
</style>

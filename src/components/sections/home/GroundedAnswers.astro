---
/*
 * Home > Grounded answers, dark band (copy.md: Home > Grounded answers). Work package A.
 * Anchor #grounded (footer). From 1280px the text and its three short steps sit in columns 1 to 5
 * beside chat-cite.png in 6 to 12; below that they stack. The three steps are the copy's body
 * sentence set as a list (what Sources shows today), not new claims.
 * Below: "Available today" and a separate, labeled "In development" list (<Badge />), muted with
 * dashed hairlines, never mixed. The screenshot is the chat pane of chat-cite.png (answer and
 * citation popover), capped at 1.2x its size; phones get the popover alone. It keeps the concept
 * caption. Title and body say "when a workspace has documents": answers without retrieved sources
 * (no documents, nothing above the similarity threshold, Chat mode general knowledge, agent runs)
 * list no sources (server/utils/chats/stream.js).
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import Screenshot from "../../ui/Screenshot.astro";
import Badge from "../../ui/Badge.astro";
import Icon from "../../ui/Icon.astro";

const steps = ["Each document it used", "The exact passages it retrieved", "How closely each passage matched the question"];

const today = [
  "A similarity threshold and passage count for each workspace.",
  "Document pinning for material the model must always see.",
  "Accuracy Optimized search, which reranks results on the built-in LanceDB store.",
  "Query mode, with a refusal message you write for questions your documents do not cover.",
];

const inDevelopment = [
  "Numbered inline citations tied to the Sources panel.",
  "Page and section references, with the original file opened at the cited passage.",
  "Strict grounding that holds Query mode to fresh sources on every turn of a conversation.",
  "Hybrid keyword and vector search on every supported vector database.",
];
---

<Section id="grounded" tone="dark" labelledby="grounded-title">
  <div class="layout-grid grounded">
    <div class="grounded__intro" data-reveal>
      <SectionIntro eyebrow="Grounded answers" title="See where each answer came from." id="grounded-title" />
      <p class="grounded__body">
        When a workspace has documents, Mission LLM searches them before the model answers. Open Sources on an
        answer to see:
      </p>
      <ol class="steps" role="list">
        {
          steps.map((s, i) => (
            <li class="step">
              <span class="step__num tnum" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="step__text">{s}</span>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="grounded__shot" data-reveal="2">
      <Screenshot
        name="chat-cite"
        view="answer"
        phone="chat-cite/popover"
        maxScale={1.2}
        sizes="(min-width: 2200px) 900px, (min-width: 1280px) 48vw, (min-width: 960px) 900px, calc(100vw - 64px)"
        alt="An answer about a change control process, with a popover showing the cited passage from a release checklist."
        phoneAlt="A popover showing the cited passage from a release checklist, with a link to show it in the Sources panel."
      />
    </div>

    <div class="grounded__lists" data-reveal="3">
      <section class="glist glist--today" aria-labelledby="grounded-today">
        <h3 class="glist__title" id="grounded-today"><Badge kind="today" /></h3>
        <ul class="glist__items" role="list">
          {
            today.map((t) => (
              <li>
                <Icon name="check" size={20} class="glist__icon" />
                <span>{t}</span>
              </li>
            ))
          }
        </ul>
      </section>
      <section class="glist glist--dev" aria-labelledby="grounded-dev">
        <h3 class="glist__title" id="grounded-dev"><Badge /></h3>
        <ul class="glist__items" role="list">
          {
            inDevelopment.map((t) => (
              <li>
                <Icon name="circle-dashed" size={20} class="glist__icon" />
                <span>{t}</span>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
  </div>
</Section>

<style>
  .grounded {
    row-gap: var(--gap-visual);
  }
  .grounded__intro,
  .grounded__shot,
  .grounded__lists {
    grid-column: 1 / -1;
    min-width: 0;
  }
  @media (min-width: 960px) {
    .grounded__intro {
      grid-column: 1 / span 8;
    }
  }
  @media (min-width: 1280px) {
    .grounded__intro {
      grid-column: 1 / span 5;
      align-self: center;
    }
    .grounded__shot {
      grid-column: 6 / -1;
    }
  }

  .grounded__body {
    margin-top: var(--gap-heading);
    font-size: var(--fs-lead);
    line-height: var(--lh-lead);
    color: var(--color-text-2);
    max-width: 52ch;
  }

  /* Three short steps: numbered rows on hairlines. */
  .steps {
    margin-top: var(--space-6);
    max-width: 52ch;
  }
  .step {
    display: flex;
    align-items: baseline;
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-hairline);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text);
  }
  .step:last-child {
    border-bottom: 1px solid var(--color-hairline);
  }
  .step__num {
    flex: none;
    min-width: 2ch;
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-link);
  }

  /* Available today beside In development. */
  .grounded__lists {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8) var(--grid-gap);
  }
  @media (min-width: 960px) {
    .grounded__lists {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .glist__title {
    margin-bottom: var(--space-4);
    line-height: 1;
  }
  .glist__items li {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-hairline);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }
  .glist__items li :global(.glist__icon) {
    flex: none;
    margin-top: 0.2em;
  }
  .glist--today .glist__items li :global(.glist__icon) {
    color: var(--color-accent);
  }
  .glist--dev .glist__items li {
    border-top-style: dashed;
    border-top-color: var(--color-hairline-dashed);
    color: var(--color-text-3);
  }
  .glist--dev .glist__items li :global(.glist__icon) {
    color: var(--color-text-3);
  }
</style>

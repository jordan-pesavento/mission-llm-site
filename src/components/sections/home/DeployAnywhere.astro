---
/*
 * Home > Deploy anywhere (copy.md). Work package B. Anchor #deploy is used by the nav and footer.
 * Layout:
 * - From 960px the intro (cols 1 to 6) sits beside the Docker run block (cols 8 to 12).
 * - Below it, the targets as one hairline-divided panel of eight equal tiles, each with its own
 *   icon: 1-up on phones, 2-up from 640px, 4-up from 1280px (the shared card-grid steps).
 * All text is verbatim from copy.md. REGISTRY stays a placeholder (CodeBlock underlines it).
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import CodeBlock from "../../ui/CodeBlock.astro";
import ArrowLink from "../../ui/ArrowLink.astro";
import Icon from "../../ui/Icon.astro";
import { PLACEHOLDER, DOWNLOAD_HREF } from "../../../data/site";

// copy.md: Home > Deploy anywhere > Code block. Image name is the REGISTRY placeholder (TODO: registry).
const dockerRun = `export STORAGE_LOCATION=$HOME/missionllm && \\
mkdir -p $STORAGE_LOCATION && \\
touch "$STORAGE_LOCATION/.env" && \\
docker run -d --rm -p 3001:3001 \\
--cap-add SYS_ADMIN \\
-v \${STORAGE_LOCATION}:/app/server/storage \\
-v \${STORAGE_LOCATION}/.env:/app/server/.env \\
-e STORAGE_DIR="/app/server/storage" \\
${PLACEHOLDER.image}`;

const targets: { icon: string; title: string; text: string }[] = [
  { icon: "cube", title: "Docker", text: "One container, one storage volume." },
  { icon: "stack", title: "Docker Compose", text: "The same container, managed as a service." },
  {
    icon: "steering-wheel",
    title: "Kubernetes",
    text: "An example manifest with persistent storage, a service and an ingress.",
  },
  { icon: "anchor", title: "Helm", text: "A chart with ConfigMap settings, Secret references, Ingress and Gateway API routes." },
  { icon: "lock-simple", title: "OpenShift", text: "An image and entrypoint built for restricted SCCs and arbitrary user IDs." },
  { icon: "cloud", title: "Cloud templates", text: "AWS CloudFormation, Google Cloud Deployment Manager, DigitalOcean Terraform." },
  {
    icon: "wifi-slash",
    title: "Disconnected networks",
    text: "Local models, the built-in embedder and LanceDB, with no cloud dependency.",
  },
  { icon: "hammer", title: "Build from source", text: "Build the image yourself from the repository's Dockerfile." },
];
---

<Section id="deploy" tone="light" labelledby="deploy-title">
  <div class="layout-grid deploy">
    <div class="deploy__intro" data-reveal>
      <SectionIntro eyebrow="Deployment" title="Deploy it where your data already lives." id="deploy-title">
        <p class="body deploy__body">
          Mission LLM ships as a single container that serves the web app and API on port <span class="tnum">3001</span>.
          Run it on a workstation, a server in your rack, a Kubernetes cluster or a cloud account you control. On a
          disconnected network, pair it with a local model runtime and stage the built-in models in advance.
        </p>
        <p class="deploy__link"><ArrowLink href={DOWNLOAD_HREF}>See every install option</ArrowLink></p>
      </SectionIntro>
    </div>

    <div class="deploy__code" data-reveal="2">
      <!-- TODO: REGISTRY is a placeholder until public images are published. -->
      <CodeBlock
        label="Run with Docker (Linux or macOS)"
        lang="shell"
        code={dockerRun}
        caption="REGISTRY is a placeholder. Public images are not published yet. Today you build the image from source (see Download)."
      />
    </div>

    <div class="deploy__targets" data-reveal="3">
      <ul class="targets" role="list">
        {
          targets.map((t) => (
            <li class="target">
              <span class="target__icon" aria-hidden="true">
                <Icon name={t.icon} size={24} />
              </span>
              <h3 class="h4 target__title">{t.title}</h3>
              <p class="target__text">{t.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</Section>

<style>
  .deploy {
    row-gap: var(--gap-visual);
  }
  .deploy__body {
    max-width: 60ch;
  }

  @media (min-width: 960px) {
    .deploy__intro {
      grid-column: 1 / span 6;
      align-self: center;
    }
    .deploy__code {
      grid-column: 7 / -1;
      align-self: center;
    }
  }
  @media (min-width: 1280px) {
    .deploy__code {
      grid-column: 8 / -1;
    }
  }

  /* Targets: one panel read as a table, cells divided by 1px hairlines (the grid gap shows the
     panel's hairline color). 1-up below 640px, 2-up from 640px, 4-up from 1280px. */
  .targets {
    display: grid;
    grid-template-columns: repeat(var(--card-cols), minmax(0, 1fr));
    gap: 1px;
    margin: 0;
    border-radius: var(--radius-lg);
    background: var(--color-hairline);
    box-shadow:
      0 0 0 1px var(--color-hairline),
      var(--shadow-card);
    overflow: hidden;
  }
  .target {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    min-width: 0;
    padding: var(--card-pad);
    background: var(--color-surface);
  }
  .target__icon {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-bottom: var(--space-5);
    border-radius: var(--radius-md);
    color: var(--color-accent);
    background: var(--color-stage);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }
  .target__title {
    color: var(--color-text);
  }
  .target__text {
    margin-top: var(--space-2);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }
  /* Phones: one column of tiles, so the icon sits beside the title instead of above it. */
  @media (max-width: 639.98px) {
    .target {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr);
      grid-template-areas: "icon title" "icon text";
      column-gap: var(--space-4);
      align-items: start;
    }
    .target__icon {
      grid-area: icon;
      margin-bottom: 0;
    }
    .target__title {
      grid-area: title;
      padding-top: 9px;
    }
    .target__text {
      grid-area: text;
    }
  }
</style>

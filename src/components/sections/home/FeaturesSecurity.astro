---
/*
 * Feature accordion 2: security and control that ship today. Replica of the reference's "Magic
 * Features" block (section-1440x900-03, bottom): pad "feature" (64 to 112), eyebrow 20/28 and H2
 * 36/40, then the FeatureAccordion with the screenshot on the LEFT (the reference keeps it there for
 * both accordions) and the accordion on the right, 714 | 584 with a 94 gap at 1440.
 * Items are only what ships today (copy.md "Security and control"). Loopback-only binding is the
 * Docker port binding (-p 127.0.0.1:3001:3001), which works with every release and is step 8 of
 * /security#hardening. The SERVER_HOST and COLLECTOR_HOST settings (mission-llm commit c590dee0) are
 * not on master yet, so they are listed on /security under "In development", not here; setting
 * SERVER_HOST=127.0.0.1 inside a container would also make the app unreachable from the host.
 * Roadmap items (SSO, MFA, audit trail forwarding, an offline switch) stay on /security under
 * "In development". Open bodies stay at two lines at 1440, so the section holds 800px.
 * Only security.png exists for this block, so every item shows it until more captures land.
 * Titles stay short enough to hold one line at 390 (18px Clash Display in a 306px row).
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import FeatureAccordion, { type AccordionItem } from "../../ui/FeatureAccordion.astro";
import { TELEMETRY_ENV } from "../../../data/site";

const shot = { name: "security", alt: "The Event Logs admin page in Mission LLM." } as const;

const items: AccordionItem[] = [
  {
    id: "offline",
    title: "Runs fully offline",
    body: "Pair it with a local model runtime and stage the built-in models. Chat, embeddings and search then run offline.",
    link: { href: "/security#outbound", label: "Learn more about offline use" },
    image: shot,
  },
  {
    id: "loopback",
    title: "Loopback-only binding",
    body: "In Docker, bind the published port to 127.0.0.1 (-p 127.0.0.1:3001:3001) and only that machine can connect.",
    link: { href: "/security#hardening", label: "Learn more about hardening" },
    image: shot,
  },
  {
    id: "roles",
    title: "Roles and API keys",
    body: "Admin, manager and default roles, with workspace membership. Admins issue and revoke keys for the developer API.",
    link: { href: "/security#controls", label: "Learn more about access" },
    image: shot,
  },
  {
    id: "events",
    title: "Admin event log",
    body: "Sign-ins, failed sign-ins, and changes to users, API keys, invites, workspaces and documents, in one log for admins.",
    link: { href: "/security#controls", label: "Learn more about oversight" },
    image: shot,
  },
  {
    id: "telemetry",
    title: "Telemetry off switch",
    body: `Set ${TELEMETRY_ENV} before the first start and no usage events are sent. Admins can also turn it off in Settings.`,
    link: { href: "/security#outbound", label: "Learn more about telemetry" },
    image: shot,
  },
];
---

<Section id="control" pad="feature" class="section--h800" labelledby="control-title">
  <SectionIntro eyebrow="Security and control" title="You set the boundary." id="control-title" />
  <FeatureAccordion id="control-acc" label="Security and control" items={items} />
</Section>

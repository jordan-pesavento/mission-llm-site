---
/*
 * Resources (#resources), a DARK section now (HERO-REVISION.md tone alternation): three cards on the
 * card rules, each a whole card link to a real page (Security overview, Install guide, Editions). The
 * drawing sits on a panel at 443:215 on top, then the title, the body and an arrow meta line. The
 * isometric drawings (images/resources/*.svg) recolor to the dark tone through the Art component, so
 * they read on the navy ground. No invented posts or dates: the meta names the page the card opens.
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import Art from "../../ui/Art.astro";
import Icon from "../../ui/Icon.astro";
import { INSTALL_METHODS } from "../../../data/site";

const cards = [
  {
    href: "/security",
    meta: "Security overview",
    title: "See where questions and documents go, and which controls ship today.",
    body: "A plain-language data flow, every outbound connection and how to avoid it, and eight steps to harden an install.",
    art: "images/resources/security-overview.svg",
  },
  {
    href: "/download",
    meta: "Install guide",
    title: "Install it on one lab workstation or a whole campus cluster.",
    body: `Build the image from source, then run it with ${INSTALL_METHODS.slice(0, -1).join(", ")} or ${INSTALL_METHODS.at(-1)}.`,
    art: "images/resources/install-guide.svg",
  },
  {
    href: "/editions",
    meta: "Editions",
    title: "Start free with the full system, for one class, a whole school or a team.",
    body: "Community is the full application, free to self-host. Enterprise is planned to add support, deployment help and governance features.",
    art: "images/resources/editions.svg",
  },
];
---

<Section id="resources" tone="dark" labelledby="resources-title">
  <div class="intro"><h2 id="resources-title" class="h2">Resources</h2></div>
  <ul class="cards" role="list">
    {
      cards.map((c) => (
        <li class="rcard card">
          <div class="rcard__art">
            <Art src={c.art} />
          </div>
          <div class="rcard__text">
            <h3 class="h3 rcard__title">
              <a class="rcard__link" href={c.href}>
                {c.title}
              </a>
            </h3>
            <p class="rcard__body">{c.body}</p>
            <p class="rcard__meta" aria-hidden="true">
              {c.meta}
              <Icon set="line" name="arrow" size={18} />
            </p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--col-gap);
    margin-top: var(--gap-intro);
  }
  .rcard {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    transition: box-shadow var(--t-fast) var(--ease);
  }
  .rcard__art {
    aspect-ratio: 443 / 215;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
  }
  .rcard__art :global(.art),
  .rcard__art :global(svg) {
    width: 100%;
    height: 100%;
  }
  .rcard__text {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: clamp(1.25rem, 0.8rem + 1.2vw, 2rem);
  }
  .rcard__title {
    text-wrap: wrap;
  }
  .rcard__link {
    color: inherit;
    text-decoration: none;
  }
  .rcard__link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--r-card);
  }
  .rcard__link:focus-visible {
    outline: none;
  }
  .rcard__link:focus-visible::after {
    outline: 2px solid var(--color-focus);
    outline-offset: 3px;
  }
  .rcard__body {
    color: var(--color-text-muted);
  }
  .rcard__meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    padding-top: 8px;
    font-weight: var(--fw-semibold);
    color: var(--color-heading);
  }
  .rcard__meta :global(svg) {
    width: 18px;
    height: 18px;
    transition: transform var(--t-fast) var(--ease);
  }
  @media (hover: hover) {
    .rcard:hover {
      box-shadow: 0 0 0 1px var(--color-line-strong), var(--shadow-card);
    }
    .rcard:hover .rcard__meta :global(svg) {
      transform: translateX(3px);
    }
    .rcard:hover .rcard__link {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 0.2em;
    }
  }
  @media (min-width: 640px) and (max-width: 1023.98px) {
    .rcard {
      grid-template-rows: none;
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      align-items: center;
    }
    .rcard__art {
      height: 100%;
      aspect-ratio: auto;
      border-bottom: 0;
      border-right: 1px solid var(--color-line);
    }
  }
  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>

---
/*
 * Resources (#resources), in place of the reference's "Blog". Package C.
 * Reference (anythingllm.com, 1440): pad "section" (128, 96 on phones), H2 48/48 (36/40 below 1024)
 * with normal tracking (the reference's "Blog"), 56px to a row of three cards with 32px gaps, and the
 * dotted rule at the bottom edge that separates it from the open source section. Each card: a 443 x 215 image (radius 10), the H3
 * (Clash 24/32) 20px below it, 16/24 mist-700 text 8px below that, and a 14/20 meta line 20px below.
 * Ours links to real pages (Security overview, Install guide, Editions). No invented posts or dates:
 * the meta line names the page the card opens.
 * Layout: three columns from 1024; from 640 to 1023 each card is a row (image left, text right);
 * phones stack the cards with 32px between them (reference phone layout).
 * Images: public/images/resources/*.svg, isometric line illustrations in the language of the home
 * steps art (public/images/steps/*.svg): hairline ink and mist strokes, page-colored occlusion, the
 * solid emblem arrow, no text and no gradients. All three cards use the light tone (white surface with
 * the card shadow), so the row reads as one set like the steps row. The SVGs are inlined at build
 * time (the regex below needs width="443" height="215" adjacent on the root <svg>), so every id in a
 * file is prefixed per file (sec-, inst-, ed-) to stay unique on the page. They are decorative (the
 * card title carries the meaning). The Security card counts the eight hardening steps on
 * /security#hardening (Hardening.astro STEPS); the Enterprise body says "is planned to add" because its
 * services are Planned and its features In development (EditionCards).
 * Card titles wrap greedily (text-wrap: wrap), as the reference's, not balanced.
 * The whole card is one link: the title's link stretches over the card, and its focus ring outlines
 * the card.
 */
import fs from "node:fs";
import path from "node:path";
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import { INSTALL_METHODS } from "../../../data/site";

const ROOT_SIZE = /<svg\b([^>]*?)\swidth="\d+"\sheight="\d+"/;
const art = (file: string) => {
  const svg = fs.readFileSync(path.join(process.cwd(), "public/images/resources", file), "utf8");
  if (!ROOT_SIZE.test(svg)) throw new Error(`Resources: ${file} needs width="443" height="215" next to each other on its root <svg>.`);
  return (
    svg
      .replace(/<!--[\s\S]*?-->/g, "")
      // Decorative inline art: drop the file's <title> so it adds no tooltip or duplicate text.
      .replace(/<title>[\s\S]*?<\/title>/g, "")
      .replace(ROOT_SIZE, '<svg$1 aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid slice"')
  );
};

const cards = [
  {
    href: "/security",
    meta: "Security overview",
    title: "See where student questions go and which controls ship today.",
    body: "A plain-language data flow, every outbound connection and how to avoid it, and eight steps to harden an install.",
    art: art("security-overview.svg"),
    tone: "light",
  },
  {
    href: "/download",
    meta: "Install guide",
    title: "Install it on one lab workstation or a whole campus cluster.",
    body: `Build the image from source, then run it with ${INSTALL_METHODS.slice(0, -1).join(", ")} or ${INSTALL_METHODS.at(-1)}.`,
    art: art("install-guide.svg"),
    tone: "light",
  },
  {
    href: "/editions",
    meta: "Editions",
    title: "Start free with the full application, for one class or a whole school.",
    body: "Community is the full application, free to self-host. Enterprise is planned to add support, deployment help and governance features.",
    art: art("editions.svg"),
    tone: "light",
  },
];
---

<Section id="resources" divider labelledby="resources-title">
  <SectionIntro title="Resources" size="lg" id="resources-title" />
  <ul class="cards" role="list">
    {
      cards.map((c, i) => (
        <li class="card" data-reveal={i === 0 ? "" : String(i + 1)}>
          <div class:list={["card__image", `card__image--${c.tone}`]} set:html={c.art} />
          <div class="card__text">
            <h3 class="h3 card__title">
              <a class="card__link" href={c.href}>
                {c.title}
              </a>
            </h3>
            <p class="card__body">{c.body}</p>
            <p class="small card__meta">{c.meta}</p>
          </div>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--card-gap);
    margin-top: var(--gap-h2-cards);
  }
  .card {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    min-width: 0;
  }
  @media (min-width: 640px) and (max-width: 1023.98px) {
    .cards {
      row-gap: var(--space-12);
    }
    .card {
      grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
      column-gap: var(--card-gap);
      align-items: start;
    }
  }
  @media (min-width: 1024px) {
    .cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    /* Cards in a row share the tallest card's height; the text fills the rest of it, so the meta
       labels (pushed to the bottom below) sit on one line whatever the body length. */
    .card {
      grid-template-rows: auto 1fr;
      align-content: stretch;
    }
  }

  .card__image {
    aspect-ratio: 443 / 215;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--navy-950);
  }
  .card__image--light {
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }
  .card__image :global(svg) {
    display: block;
    width: 100%;
    height: 100%;
  }

  :global(#resources .intro__title) {
    letter-spacing: normal;
  }
  .card__title {
    margin-top: var(--space-5);
    text-wrap: wrap;
  }
  @media (min-width: 640px) and (max-width: 1023.98px) {
    .card__title {
      margin-top: 0;
    }
  }
  .card__link {
    color: inherit;
    text-decoration: none;
  }
  /* The title's link covers the whole card. */
  .card__link::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-md);
  }
  .card__link:hover {
    text-decoration-line: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    text-decoration-color: currentColor;
  }
  .card__link:focus-visible {
    outline: none;
  }
  .card__link:focus-visible::after {
    outline: 2px solid var(--color-focus);
    outline-offset: 6px;
  }
  .card__body {
    margin-top: var(--space-2);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--mist-700);
  }
  .card__text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  /* 20px below the body, and pushed to the card's foot when the row is taller (three columns). */
  .card__meta {
    margin-top: auto;
    padding-top: var(--space-5);
  }
</style>

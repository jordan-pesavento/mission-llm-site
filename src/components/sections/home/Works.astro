---
/*
 * "Works with" strip: the reference's 60px partner-logo strip between the hero and the stats
 * (y 840 to 900 at 1440), with honest content: plain-type names of the local model runtimes and
 * deployment targets Mission LLM works with, never logos or customers.
 * Evidence (src/content/copy.md): local runtimes named in the provider settings (Ollama, LM Studio,
 * LocalAI, KoboldCPP: frontend/src/pages/GeneralSettings/LLMPreference/index.jsx) and the container
 * install methods on /download (Docker, Kubernetes, Helm, OpenShift).
 * Look: Clash Display 500 in mist-500 (18, 20 from 640, 24 from 1280), one name centered in each of
 * a row of equal slots across the content width, with the reference's soft fade at both edges;
 * static (no marquee). Every name is whole at every width: phones show three names, 640 to 1023
 * five, 1024 and up all eight.
 */
import Container from "../../ui/Container.astro";

const ITEMS: { name: string; from?: "sm" | "lg" }[] = [
  { name: "Ollama" },
  { name: "LM Studio", from: "sm" },
  { name: "LocalAI", from: "lg" },
  { name: "KoboldCPP", from: "lg" },
  { name: "Docker" },
  { name: "Kubernetes" },
  { name: "Helm", from: "sm" },
  { name: "OpenShift", from: "lg" },
];
---

<section class="works" aria-label="Works with these local model runtimes and deployment targets">
  <Container>
    <ul class="works__list" role="list">
      {ITEMS.map((item) => <li class:list={["works__item", item.from && `works__item--${item.from}`]}>{item.name}</li>)}
    </ul>
  </Container>
</section>

<style>
  .works {
    display: flex;
    align-items: center;
    height: 60px;
    overflow: hidden;
  }
  /* Equal slots, one name centered in each (the reference's logos sit about 194px apart at 1440). */
  .works__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    justify-items: center;
    align-items: center;
    /* The reference's edge fade: the outer names soften into the page. */
    -webkit-mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.3) 0, #000 16%, #000 84%, rgb(0 0 0 / 0.3) 100%);
    mask-image: linear-gradient(90deg, rgb(0 0 0 / 0.3) 0, #000 16%, #000 84%, rgb(0 0 0 / 0.3) 100%);
  }
  .works__item {
    font-family: var(--font-display);
    font-size: 1.125rem; /* 18 on phones */
    line-height: 1.75rem;
    font-weight: var(--fw-medium);
    letter-spacing: -0.01em;
    white-space: nowrap;
    color: var(--mist-500);
  }
  .works__item--sm,
  .works__item--lg {
    display: none;
  }
  @media (min-width: 640px) {
    .works__item {
      font-size: 1.25rem; /* 20 */
    }
    .works__item--sm {
      display: block;
    }
  }
  @media (min-width: 1024px) {
    .works__item--lg {
      display: block;
    }
  }
  @media (min-width: 1280px) {
    .works__item {
      font-size: 1.5rem; /* 24: about the reference's logo height */
      line-height: 2rem;
    }
  }
</style>

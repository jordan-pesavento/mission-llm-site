---
/*
 * "Run it on a lab workstation or a campus server" (#deploy), a LIGHT section now (HERO-REVISION.md tone
 * alternation): text 1-5 | code 7-12 (split--deploy). The code block keeps the raised dark surface in
 * both tones (CodeBlock), so it reads as a terminal panel on the light ground. Its command and caption
 * are read verbatim from copy.md ("### Deploy anywhere") at build time; REGISTRY stays a marked
 * placeholder and the caption says why. The build fails if the copy moves.
 */
import fs from "node:fs";
import path from "node:path";
import Section from "../../ui/Section.astro";
import Eyebrow from "../../ui/Eyebrow.astro";
import ArrowLink from "../../ui/ArrowLink.astro";
import CodeBlock from "../../ui/CodeBlock.astro";
import { DOWNLOAD_HREF } from "../../../data/site";

const md = fs.readFileSync(path.join(process.cwd(), "src/content/copy.md"), "utf8").replace(/\r\n/g, "\n");
const start = md.indexOf("### Deploy anywhere");
if (start < 0) throw new Error('DeployBand: copy.md heading "### Deploy anywhere" not found.');
const block = md.slice(start, md.indexOf("\n### ", start + 1));
const fence = block.match(/- Code block, label "([^"]+)":\n```shell\n([\s\S]*?)\n```/);
const caption = block.match(/- Caption: "([^"]+)"/);
if (!fence || !caption) throw new Error("DeployBand: the Docker code block or its caption moved in copy.md.");
const [, codeLabel, code] = fence;
---

<Section id="deploy" labelledby="deploy-title">
  <div class="split split--deploy deploy">
    <div class="deploy__text">
      <Eyebrow>Self-hosted</Eyebrow>
      <h2 id="deploy-title" class="h2 deploy__title">Run it on a lab workstation or a campus server.</h2>
      <p class="deploy__lead">
        Mission LLM ships as one container that serves the app and API on port 3001. Start it with Docker, Compose, Kubernetes, Helm or
        OpenShift, on your own hardware or in a cloud account you control.
      </p>
      <p class="deploy__more"><ArrowLink href={DOWNLOAD_HREF}>See every install option</ArrowLink></p>
    </div>
    <div class="deploy__visual">
      <CodeBlock
        label={codeLabel.startsWith("Run with Docker") ? "Docker on Linux or macOS" : codeLabel}
        lang="shell"
        code={code}
        caption={caption[1]}
      />
    </div>
  </div>
</Section>

<style>
  .deploy {
    --split-stack-gap: var(--space-12);
  }
  .deploy__text,
  .deploy__visual {
    min-width: 0;
  }
  .deploy__title {
    margin-top: var(--gap-eyebrow);
  }
  .deploy__lead {
    max-width: var(--measure);
    margin-top: 20px;
    color: var(--color-text);
  }
  .deploy__more {
    display: flex;
    margin-top: 28px;
  }
</style>

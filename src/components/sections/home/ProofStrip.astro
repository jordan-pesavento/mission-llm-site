---
/*
 * Home > Proof strip (copy.md: Home > Proof strip). Work package A.
 * Four verifiable facts in place of a logo wall: 4-up from 1280, 2-up from 640, 1-up below, with
 * hairline dividers between cells only. Figures are real text in the HTML (no count-ups) and come
 * from COUNTS in src/data/site.ts. Rows line up across columns through subgrid.
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import { COUNTS } from "../../../data/site";

const facts = [
  {
    title: "Runs on disconnected networks",
    line: "Local models, the built-in embedder and the built-in vector store need no internet connection.",
  },
  {
    title: `${COUNTS.llmProviders} model providers`,
    line: "Local runtimes and cloud APIs, chosen per workspace.",
  },
  {
    title: `${COUNTS.vectorDatabases} vector databases`,
    line: "LanceDB built in, plus PGVector, Qdrant, Milvus, Chroma, Weaviate and more.",
  },
  {
    title: "Docker, Kubernetes, Helm, OpenShift",
    line: "Plus AWS, Google Cloud and DigitalOcean templates.",
  },
];
---

<Section tone="light" pad="strip" hairline labelledby="proof-title">
  <SectionIntro srOnly title="At a glance" id="proof-title" />
  <ul class="facts" role="list" data-reveal>
    {
      facts.map((f) => (
        <li class="fact">
          <p class="fact__title tnum">{f.title}</p>
          <p class="fact__line">{f.line}</p>
        </li>
      ))
    }
  </ul>
  <p class="proof__note">
    Offline use requires a local model runtime and built-in models staged in advance. See <a href="/security#outbound"
      >Security</a
    > for every outbound connection.
  </p>
</Section>

<style>
  .facts {
    --cell-pad: var(--space-6);
    display: grid;
    grid-template-columns: repeat(var(--card-cols), minmax(0, 1fr));
    column-gap: 0;
    row-gap: 0;
  }
  .fact {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 2;
    row-gap: var(--space-2);
    align-content: start;
    padding-block: var(--space-5);
    border-top: 1px solid var(--color-hairline);
  }
  .fact:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .fact:last-child {
    padding-bottom: 0;
  }
  .fact__title {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
    font-weight: 500;
    color: var(--color-text);
    text-wrap: balance;
  }
  .fact__line {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-2);
    max-width: 40ch;
  }

  /* 2-up: a vertical rule between the columns and a horizontal rule between the rows. */
  @media (min-width: 640px) {
    .fact,
    .fact:first-child,
    .fact:last-child {
      padding: 0;
      border-top: 0;
    }
    .fact:nth-child(odd) {
      padding-right: var(--cell-pad);
    }
    .fact:nth-child(even) {
      padding-left: var(--cell-pad);
      border-left: 1px solid var(--color-hairline);
    }
    .fact:nth-child(-n + 2) {
      padding-bottom: var(--cell-pad);
    }
    .fact:nth-child(n + 3) {
      padding-top: var(--cell-pad);
      border-top: 1px solid var(--color-hairline);
    }
  }

  /* 4-up: one row, vertical rules between cells only. */
  @media (min-width: 1280px) {
    .fact,
    .fact:nth-child(n) {
      padding: 0 var(--cell-pad);
      border-top: 0;
      border-left: 1px solid var(--color-hairline);
    }
    .fact:first-child {
      padding-left: 0;
      border-left: 0;
    }
    .fact:last-child {
      padding-right: 0;
    }
  }
  @media (min-width: 1680px) {
    .facts {
      --cell-pad: var(--space-7);
    }
  }

  .proof__note {
    margin-top: var(--space-7);
    font-size: var(--fs-ui);
    line-height: var(--lh-ui);
    color: var(--color-text-3);
    max-width: var(--measure);
  }
</style>

---
/*
 * Final CTA. Package C.
 * Reference (anythingllm.com): pad "cta" (144 at 1440, 112 on phones), everything centered: H2 48/48
 * at every width (max 768), a 16/26 mist-600 paragraph (max 576) 12px below it, and one large
 * primary button (32px side padding) 20px below that. Light page; the dark footer follows 32px
 * further down than the padding alone (reference: the section ends at 7238 and the footer starts at
 * 7270 at 1440, and the same 32px at 1920 and 390).
 * Copy: copy.md > Home > Final CTA. The H2 holds one line from 768 (602px of Clash 48).
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import Button from "../../ui/Button.astro";
import { DOWNLOAD_HREF } from "../../../data/site";
---

<Section pad="cta" labelledby="cta-title" class="final-cta">
  <div class="cta" data-reveal>
    <SectionIntro
      title="Bring it to your next course."
      size="cta"
      align="center"
      id="cta-title"
      lead="Start with one container, a local model and one course. Add students, workspaces and readings when you are ready."
    />
    <div class="cta__action">
      <Button href={DOWNLOAD_HREF} size="lg">Download Mission LLM</Button>
    </div>
  </div>
</Section>

<style>
  :global(section.section.final-cta) {
    padding-bottom: calc(var(--pad-cta) + var(--space-8));
  }
  .cta :global(.intro__lead) {
    margin-top: var(--space-3);
  }
  .cta__action {
    display: flex;
    justify-content: center;
    margin-top: var(--space-5);
  }
</style>

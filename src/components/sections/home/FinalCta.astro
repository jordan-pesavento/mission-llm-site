---
/*
 * Closing (DESIGN-SPEC 9, 11 + HERO-REVISION.md tone): a DARK section that is both the contact moment
 * and the mark's one large appearance. Text 1-6 | the mark slab 7-12 (split--closing). The mark slab
 * (images/scenes/mark-slab.svg) is the ML mark as an isometric solid on a server plate, drawn once on
 * the drafting lattice, with the node the only color; it recolors to the dark tone. One action, "Talk
 * to us" to the contact form (Download on the home page is the nav's job only).
 */
import Section from "../../ui/Section.astro";
import Button from "../../ui/Button.astro";
import Art from "../../ui/Art.astro";
import { CONTACT_HREF } from "../../../data/site";
---

<Section tone="dark" labelledby="closing-title" class="closing">
  <div class="split split--closing closing__grid">
    <div class="closing__text">
      <h2 id="closing-title" class="h2">Bring it to your next course.</h2>
      <p class="lead closing__lead">
        Start with one container, a local model and one course. Questions first? Tell us what you teach or run and we will reply by email.
      </p>
      <div class="actions closing__actions">
        <Button href={CONTACT_HREF} size="lg" iconEnd="arrow">Talk to us</Button>
      </div>
    </div>
    <div class="closing__art">
      <Art src="images/scenes/mark-slab.svg" draw lattice class="closing__slab" />
    </div>
  </div>
</Section>

<style>
  .closing {
    overflow-x: clip;
  }
  .closing__text {
    min-width: 0;
  }
  .closing__lead {
    margin-top: 20px;
    color: var(--color-text-muted);
  }
  .closing__actions {
    margin-top: 32px;
  }
  .closing__slab {
    max-width: 28rem;
    margin-inline: auto;
  }
  @media (min-width: 1024px) {
    .closing__slab {
      max-width: min(100%, 44rem, calc((var(--view-h) - 2 * var(--pad-y)) * 1.06));
    }
  }
</style>

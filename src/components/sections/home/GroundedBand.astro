---
/*
 * Grounded answers (#grounded), a DARK band (DESIGN-SPEC 11): text 1-5 | media 6-12 (split--band).
 * Three crop tiers of the grounded capture: the Sources panel alone below 1280, the answer plus its
 * Sources from 1280 to 1919, and the wide view from 1920 (Screenshot cropMid/cropSm), so the app text
 * stays near 1:1 at every size. Honesty (copy.md): answers list the documents they used when documents
 * were retrieved; the Sources panel shows the retrieved passages with match scores. Never "cites":
 * inline citations are in development, so the heading says the sources are listed. The band speaks
 * of documents and workspaces (course readings, team manuals), not only of readings.
 */
import DarkBand from "../../ui/DarkBand.astro";
import Eyebrow from "../../ui/Eyebrow.astro";
import ArrowLink from "../../ui/ArrowLink.astro";
import Screenshot from "../../ui/Screenshot.astro";

const points = ["Sources listed under grounded answers", "Retrieved passages with match scores", "Query mode, with a refusal message you write"];
---

<DarkBand id="grounded" labelledby="grounded-title">
  <div class="split split--band grounded">
    <div class="grounded__text">
      <Eyebrow>Grounded answers</Eyebrow>
      <h2 id="grounded-title" class="h2 grounded__title">Answers from your own documents, sources listed.</h2>
      <p class="grounded__lead">
        When a workspace has documents, Mission LLM searches them on your server before the model answers. Open Sources to see
        which documents an answer used, the passages it pulled and how closely each one matched.
      </p>
      <ul class="dots" role="list">
        {points.map((p) => <li>{p}</li>)}
      </ul>
      <p class="grounded__more"><ArrowLink href="/security#data-flow">How your data flows</ArrowLink></p>
    </div>
    <div class="grounded__media">
      <Screenshot
        name="grounded"
        alt="A student's answer about energy flow and the nitrogen cycle, with the Sources panel open: each course reading it drew on, a passage from it and its match score."
        crop={{ x: 283, y: 52, w: 1157, h: 641 }}
        cropMid={{ x: 680, y: 52, w: 760, h: 470 }}
        cropSm={{ x: 1150, y: 0, w: 290, h: 380 }}
        frame="42vw"
        frameClass="grounded__frame"
      />
    </div>
  </div>
</DarkBand>

<style>
  .grounded {
    --split-stack-gap: var(--space-12);
  }
  .grounded__text,
  .grounded__media {
    min-width: 0;
  }
  .grounded__title {
    margin-top: var(--gap-eyebrow);
  }
  .grounded__lead {
    max-width: 36rem;
    margin-top: 20px;
    color: var(--color-text);
  }
  .grounded :global(.dots) {
    margin-top: 24px;
  }
  .grounded__more {
    display: flex;
    margin-top: 28px;
  }
  /* The whole capture is shown (HERO-REVISION.md item E); below 1024 it stacks under the text at full
     column width so the entire screen stays readable. */
  .grounded__media :global(.frame) {
    margin-inline: auto;
  }
  @media (min-width: 1024px) {
    /* Size the frame by the height that fits the band (its natural aspect), aligned to the column's right. */
    .grounded__media :global(.frame) {
      max-width: calc((var(--view-h) - 2 * var(--pad-y)) * var(--w) / var(--h));
      margin: 0 0 0 auto;
    }
  }
</style>

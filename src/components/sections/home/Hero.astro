---
/*
 * Home hero (redesign + HERO-REVISION.md): a deep-navy section that fills the viewport under the nav,
 * so on desktop first load only the hero shows and nothing of the next section peeks in.
 * - data-tone="dark" (navy-950), the first child of <main>, so the nav shows its light skin from the
 *   first paint (Header's :has() rule) and stays clearly apart from the hero at rest.
 * - The inner block is at least the visible page under the nav (min-height: var(--view-h) = 100svh -
 *   --nav-h). Its rows are the headline-and-scene composition (centered) and the "Runs with" strip
 *   pinned to the bottom, so all of it fits one screen from 1024 to 2560; on short screens it scrolls
 *   inside the hero rather than squashing (HERO-REVISION.md 1, 2d).
 * - One signature scene (images/scenes/hero-scene.svg): the classroom on its local server, the answer
 *   panel and its numbered source chips, drawn in light strokes on navy with the blue node the only
 *   color. It draws itself once when in view and rests on the final frame; reduced motion shows the
 *   final frame at once (Art `draw` + draw.ts). Decorative (aria-hidden): the lead tells the story.
 * - The "Runs with" strip (HERO-REVISION.md 2b/2c): the four-number stats band is gone; the runtimes
 *   and deploy targets stay as one quiet full-width row inside the hero on its navy tone.
 * Copy: "Your class, answered." stays on two lines; "lists its sources", never "cites"; no standalone
 * "AI" in the Clash Display heading. One primary action plus one secondary (spec section 6).
 */
import Art from "../../ui/Art.astro";
import Button from "../../ui/Button.astro";

// Local model runtimes and deployment targets Mission LLM works with (copy.md), never logos or customers.
const RUNS_WITH = ["Ollama", "LM Studio", "LocalAI", "KoboldCPP", "Docker", "Kubernetes", "Helm", "OpenShift"];
---

<section class="hero" data-tone="dark" aria-labelledby="hero-title">
  <div class="wrap hero__inner">
    <div class="hero__grid split">
      <div class="hero__text">
        <p class="eyebrow">Private AI for courses, on your own hardware</p>
        <h1 id="hero-title" class="h1 hero__title">Your class, <span class="nowrap">answered.</span></h1>
        <p class="lead hero__lead">
          A course assistant that answers from your readings and lists its sources, on your school's own servers.
        </p>
        <div class="actions hero__actions" data-row="hero-actions">
          <Button href="#steps">See how it works</Button>
          <Button href="/security" variant="secondary">Security overview</Button>
        </div>
      </div>
      <div class="hero__art">
        <Art src="images/scenes/hero-scene.svg" draw lattice class="hero__scene" />
      </div>
    </div>

    <div class="hero__runs" aria-label="Runs with these local model runtimes and deployment targets">
      <p class="hero__runs-label">Runs with</p>
      <ul class="hero__runs-list" role="list">
        {RUNS_WITH.map((name) => <li>{name}</li>)}
      </ul>
    </div>
  </div>
</section>

<style>
  .hero {
    overflow-x: clip; /* the lattice and scene overhang are clipped to the section */
  }
  /* At least the visible page under the fixed nav; padding sits inside it (border-box), so the section
     height stays >= --view-h and nothing of the next section shows at scroll 0. */
  .hero__inner {
    display: grid;
    grid-template-rows: 1fr;
    align-content: center;
    gap: clamp(1.5rem, 0.5rem + 2svh, 2.75rem);
    min-height: var(--view-h);
    padding-block: clamp(1.5rem, 0.5rem + 3svh, 3rem);
  }
  .hero__grid {
    align-self: center;
    width: 100%;
  }
  .hero__title {
    margin-top: 14px;
    max-width: 11ch;
  }
  .hero__lead {
    margin-top: clamp(1rem, 0.6rem + 1vw, 1.5rem);
    max-width: 30rem;
    color: var(--color-text-muted);
  }
  .hero__actions {
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
  }
  .hero__art {
    width: 100%;
    justify-self: center;
    min-width: 0;
  }
  .hero__scene {
    width: 100%;
    max-width: 36rem;
    margin-inline: auto;
  }

  /* The "Runs with" strip: a quiet full-width row on the hero's navy tone, a hairline above it. */
  .hero__runs {
    display: grid;
    gap: 10px 24px;
    align-items: baseline;
    padding-top: clamp(1.25rem, 0.75rem + 1.5svh, 2rem);
    border-top: 1px solid var(--color-line);
  }
  .hero__runs-label {
    font-size: 1rem;
    font-weight: var(--fw-semibold);
    color: var(--color-text-quiet);
  }
  .hero__runs-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px var(--col-gap);
  }
  .hero__runs-list li {
    display: flex;
    align-items: center;
    font: var(--fw-medium) clamp(1.125rem, 0.9rem + 0.45vw, 1.5rem) / 1.3 var(--font-display);
    letter-spacing: -0.01em;
    color: var(--color-text-muted);
    white-space: nowrap;
  }

  @media (min-width: 640px) {
    .hero__runs-list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (max-width: 639.98px) {
    .hero__actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .hero__actions :global(.btn) {
      padding-inline: 12px;
    }
  }
  @media (max-width: 1023.98px) {
    .hero__scene {
      max-width: 30rem;
    }
  }
  /* From 1024 the composition is the scene beside the headline, the strip along the bottom; all within
     one viewport. The scene is sized by the viewport HEIGHT (not just its column width), so it grows to
     fill tall, wide screens and the hero reads confidently with no large empty upper region (F4). The
     text column takes the remaining width; the height budget subtracts the strip, gaps and padding so the
     whole hero always fits one screen, and a 44vw cap keeps the text column roomy on very wide screens. */
  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-rows: 1fr auto;
    }
    .hero__grid {
      grid-template-columns: minmax(20rem, 1fr) auto;
      align-items: center;
      column-gap: clamp(2rem, 0.5rem + 2.5vw, 5rem);
    }
    .hero__text {
      grid-column: 1;
      max-width: 44rem;
    }
    .hero__art {
      grid-column: 2;
      display: flex;
      align-items: center;
      justify-content: flex-end;
    }
    .hero__scene {
      width: auto;
      height: clamp(320px, min(calc(var(--view-h) - 13rem), 44vw), 1000px);
      max-width: 100%;
      margin-inline: 0;
    }
    /* The scene SVG is injected with set:html, so it carries no scoped attribute: reach it with
       :global(). Drive it by height so the whole scene scales with the hero and the answer card reads
       large on wide screens (F4). */
    .hero__scene :global(svg) {
      height: 100%;
      width: auto;
      max-width: 100%;
    }
    .hero__runs {
      align-self: end;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      column-gap: var(--col-gap);
    }
    .hero__runs-label {
      grid-column: 1 / span 2;
    }
    .hero__runs-list {
      grid-column: 3 / -1;
      display: flex;
      flex-wrap: nowrap;
      gap: 0;
    }
    .hero__runs-list li + li::before {
      content: "";
      width: 1px;
      height: 0.9em;
      margin-inline: clamp(0.75rem, -0.2rem + 1.1vw, 1.5rem);
      background: var(--color-line-strong);
    }
  }
  @media (min-width: 1024px) and (max-width: 1279.98px) {
    .hero__runs-list li {
      font-size: 1rem;
    }
  }
  /* Short-and-wide screens: drop the strip so the headline and scene still fit one screen. */
  @media (min-width: 1024px) and (max-height: 620px) {
    .hero__runs {
      display: none;
    }
  }

  /* HERO-REVISION.md item C: after the scene draws on (Art adds .is-drawn), keep a subtle continuous
     ambient motion so the hero feels alive. Transform and opacity only, so no layout thrash and CSP is
     untouched (pure CSS, no inline script). It starts only when motion is allowed and only once the
     draw-on has finished, so it never fights the entrance animation; under prefers-reduced-motion the
     scene stays on its resting frame with no motion. */
  @media (prefers-reduced-motion: no-preference) {
    /* The blue node in the server gently pulses (the one point of color: "here", processing). */
    .hero__art :global(.art.is-drawn [data-node]) {
      transform-box: fill-box;
      transform-origin: center;
      animation: hero-node-pulse 3.4s ease-in-out 0.5s infinite;
      will-change: transform, opacity;
    }
    /* The answer panel floats a few units, so the "answer" reads as arriving and settling. Its base
       matrix is re-stated before the float so the CSS transform does not drop the panel's placement. */
    .hero__art :global(.art.is-drawn .art-panel) {
      animation: hero-panel-float 7s ease-in-out 0.5s infinite;
      will-change: transform;
    }
  }
  @keyframes hero-node-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.16);
      opacity: 0.82;
    }
  }
  @keyframes hero-panel-float {
    0%,
    100% {
      transform: translateY(0) matrix(0.58, 0.21, 0, 0.62, 305, 30);
    }
    50% {
      transform: translateY(-3.5px) matrix(0.58, 0.21, 0, 0.62, 305, 30);
    }
  }
</style>

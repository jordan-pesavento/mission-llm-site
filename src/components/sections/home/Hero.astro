---
/*
 * Home hero (redesign + HERO-REVISION.md): a deep-navy section that fills the viewport under the nav,
 * so on desktop first load only the hero shows and nothing of the next section peeks in.
 * - data-tone="dark" (navy-950), the first child of <main>, so the nav shows its light skin from the
 *   first paint (Header's :has() rule) and stays clearly apart from the hero at rest.
 * - The inner block is at least the visible page under the nav (min-height: var(--view-h) = 100svh -
 *   --nav-h). Its rows are the headline-and-scene composition (centered) and the "Runs with" strip
 *   pinned to the bottom, so all of it fits one screen from 1024 to 2560; on short screens it scrolls
 *   inside the hero rather than squashing (HERO-REVISION.md 1, 2d).
 * - One signature scene (images/scenes/hero-scene.svg, hero v2 concept A): a finished isometric
 *   illustration with real volume on the navy ground: three stepped tiers of nine lit learner laptops,
 *   an instructor desk, the in-house server tower carrying the ML mark with its one glowing node, dashed
 *   guides with moving dots from each row into the server's sockets, and the answer card above it (a
 *   question, an answer, three numbered source chips, an input bar). It ships its own floor grid and
 *   light pool, so the drafting lattice is off here. Its outlines draw on once when in view (Art `draw`
 *   + draw.ts; faces are solid from the first frame), then the ambient motion below runs; reduced
 *   motion shows the final frame at once. Decorative (aria-hidden): the lead tells the story.
 * - The "Runs with" band (RunsWith.astro): a full-bleed continuous marquee along the bottom of the hero,
 *   like anythingllm.com's logo strip (owner: "this section should rotate like AnythingLLM's").
 * Copy (positioning pass, copy.md > Home > Hero): "Your class, your model." stays on two lines; "lists
 * its sources", never "cites"; no standalone "AI" in the Clash Display heading ("AI" sits in the Jakarta
 * eyebrow and lead only). One primary action to the uses accordion (#product), the Security secondary,
 * and a GitHub repository button (owner request, like AnythingLLM's hero); on a phone the primary spans
 * the row.
 */
import Art from "../../ui/Art.astro";
import Button from "../../ui/Button.astro";
import RunsWith from "./RunsWith.astro";
import { PLACEHOLDER } from "../../../data/site";

// Local model runtimes and deployment targets Mission LLM works with (copy.md), never logos or customers.
const RUNS_WITH = ["Ollama", "LM Studio", "LocalAI", "KoboldCPP", "Docker", "Kubernetes", "Helm", "OpenShift"];
---

<section class="hero" data-tone="dark" aria-labelledby="hero-title">
  <div class="wrap hero__inner">
    <div class="hero__grid split">
      <div class="hero__text">
        <p class="eyebrow">A private, offline AI system for schools and teams</p>
        <h1 id="hero-title" class="h1 hero__title">Your class, <span class="nowrap">your model.</span></h1>
        <p class="lead hero__lead">
          An in-house AI system for schools and teams. It runs on your own hardware, answers from your own documents and lists its sources. Pair it with a local model and your questions and documents never leave the building.
        </p>
        <div class="actions hero__actions" data-row="hero-actions">
          <Button href="#product">See what it can do</Button>
          <Button href="/security" variant="secondary">Security overview</Button>
          <Button href={PLACEHOLDER.repositoryUrl} variant="secondary" iconStart="github-logo" iconSet="phosphor" target="_blank" rel="noopener">GitHub</Button>
        </div>
      </div>
      <div class="hero__art">
        <Art src="images/scenes/hero-scene.svg" draw class="hero__scene" />
      </div>
    </div>

    <RunsWith label="Runs with" items={RUNS_WITH} />
  </div>
</section>

<style>
  .hero {
    overflow-x: clip; /* any scene overhang (the svg keeps overflow visible) is clipped to the section */
  }
  /* At least the visible page under the fixed nav; padding sits inside it (border-box), so the section
     height stays >= --view-h and nothing of the next section shows at scroll 0. */
  .hero__inner {
    display: grid;
    grid-template-rows: 1fr;
    align-content: center;
    gap: clamp(1.5rem, 0.5rem + 2svh, 2.75rem);
    min-height: var(--view-h);
    padding-block: clamp(1.5rem, 0.5rem + 3svh, 3rem);
  }
  .hero__grid {
    align-self: center;
    width: 100%;
  }
  .hero__title {
    margin-top: 14px;
    max-width: 11ch;
  }
  .hero__lead {
    margin-top: clamp(1rem, 0.6rem + 1vw, 1.5rem);
    max-width: 30rem;
    color: var(--color-text-muted);
  }
  .hero__actions {
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.5rem);
  }
  .hero__art {
    width: 100%;
    justify-self: center;
    min-width: 0;
  }
  .hero__scene {
    width: 100%;
    max-width: 36rem;
    margin-inline: auto;
  }

  @media (max-width: 639.98px) {
    .hero__actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }
    .hero__actions :global(.btn) {
      padding-inline: 12px;
    }
    /* Three actions on a phone: the primary spans the row, Security and GitHub sit side by side. */
    .hero__actions > :global(.btn:first-child) {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 1023.98px) {
    .hero__scene {
      max-width: 30rem;
    }
  }
  /* From 1024 the composition is the scene beside the headline, the strip along the bottom; all within
     one viewport. The scene is sized by the viewport HEIGHT (not just its column width), so it grows to
     fill tall, wide screens and the hero reads confidently with no large empty upper region (F4). The
     text column takes the remaining width; the height budget subtracts the strip, gaps and padding so the
     whole hero always fits one screen, and a 44vw cap keeps the text column roomy on very wide screens. */
  @media (min-width: 1024px) {
    .hero__inner {
      grid-template-rows: 1fr auto;
    }
    .hero__grid {
      grid-template-columns: minmax(20rem, 1fr) auto;
      align-items: center;
      column-gap: clamp(2rem, 0.5rem + 2.5vw, 5rem);
    }
    .hero__text {
      grid-column: 1;
      max-width: 44rem;
    }
    .hero__art {
      grid-column: 2;
      display: flex;
      align-items: center;
      justify-content: flex-end;
    }
    .hero__scene {
      width: auto;
      height: clamp(320px, min(calc(var(--view-h) - 13rem), 44vw), 1000px);
      max-width: 100%;
      margin-inline: 0;
    }
    /* The scene SVG is injected with set:html, so it carries no scoped attribute: reach it with
       :global(). Drive it by height so the whole scene scales with the hero and the answer card reads
       large on wide screens (F4). */
    .hero__scene :global(svg) {
      height: 100%;
      width: auto;
      max-width: 100%;
    }
  }
  /* Small laptops (1024 to 1279): the three actions must stay on ONE row (owner rule: a row of buttons
     never wraps). The text column is what the scene leaves, so here the scene's width cap drops from 44vw
     to 35vw and the buttons tighten their inline padding; from 1280 the normal sizes return. */
  @media (min-width: 1024px) and (max-width: 1279.98px) {
    .hero__scene {
      height: clamp(320px, min(calc(var(--view-h) - 13rem), 35vw), 1000px);
    }
    .hero__actions {
      flex-wrap: nowrap;
    }
    .hero__actions :global(.btn) {
      padding-inline: 16px;
    }
  }

  /* Hero scene ambient motion (HERO-REVISION.md item C, hero v2 concept A). Pure CSS, keyed off the
     wrapper class draw.ts adds when the draw-on has finished (.art.is-drawn), so nothing fights the
     entrance. Transform, opacity and stroke-dashoffset only (no layout, no scripts, CSP untouched). The
     SVG is injected with set:html, so :global() reaches it. Hooks in the SVG: [data-node] (the one
     glowing node), .a-halo (its glow rings), .a-screen (each laptop's lit screen group, per tier
     .a-tier1/2/3), .a-flow (the moving-dot guides), .a-sweep (the light beam slices), .art-panel (the
     answer card). Under prefers-reduced-motion the scene rests on its final frame (the reduce block
     below; global.css also collapses every animation). */
  @media (prefers-reduced-motion: no-preference) {
    /* The one point of color: the node pulses with its halo (processing, "here"). */
    .hero__art :global(.art.is-drawn [data-node]) {
      transform-box: fill-box;
      transform-origin: center;
      animation: hero-a-node 3.4s ease-in-out 0.4s infinite;
      will-change: transform, opacity;
    }
    .hero__art :global(.art.is-drawn .a-halo) {
      transform-box: fill-box;
      transform-origin: center;
      animation: hero-a-halo 3.4s ease-in-out 0.4s infinite;
      will-change: transform, opacity;
    }
    /* Nine lit screens breathe, one phase per tier so the room never blinks in unison. */
    .hero__art :global(.art.is-drawn .a-screen) {
      animation: hero-a-breathe 5.2s ease-in-out infinite;
      will-change: opacity;
    }
    .hero__art :global(.art.is-drawn .a-tier2 .a-screen) {
      animation-delay: -1.7s;
    }
    .hero__art :global(.art.is-drawn .a-tier3 .a-screen) {
      animation-delay: -3.5s;
    }
    /* Data travels: the dot pattern (dasharray 0.01 7.2, round caps) slides one period per loop, so the
       dots run from each row's port into the server's sockets, and from the server up into the card. */
    .hero__art :global(.art.is-drawn .a-flow) {
      animation: hero-a-flow 0.95s linear infinite;
      will-change: stroke-dashoffset;
    }
    /* A slow soft beam of light crosses the floor and the three tiers (slices drawn on each surface, all
       moved together along the isometric x axis: 110 units = translate(95.26, 55)). */
    .hero__art :global(.art.is-drawn .a-sweep) {
      animation: hero-a-sweep 12s ease-in-out 1s infinite;
      will-change: transform, opacity;
    }
    /* The answer card floats a few units (it has no transform attribute of its own: the isometric plane
       sits on an inner group, so a plain translate is safe). The input caret rests visible: no blink. */
    .hero__art :global(.art.is-drawn .art-panel) {
      animation: hero-a-float 7s ease-in-out 0.3s infinite;
      will-change: transform;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__art :global(.art.is-drawn [data-node]),
    .hero__art :global(.art.is-drawn .a-halo),
    .hero__art :global(.art.is-drawn .a-screen),
    .hero__art :global(.art.is-drawn .a-flow),
    .hero__art :global(.art.is-drawn .a-sweep),
    .hero__art :global(.art.is-drawn .art-panel) {
      animation: none;
    }
  }
  @keyframes hero-a-node {
    0%,
    100% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.14);
      opacity: 0.86;
    }
  }
  @keyframes hero-a-halo {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.7;
    }
    50% {
      transform: scale(1.24);
      opacity: 1;
    }
  }
  @keyframes hero-a-breathe {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.84;
    }
  }
  @keyframes hero-a-flow {
    from {
      stroke-dashoffset: 0;
    }
    to {
      stroke-dashoffset: -7.21;
    }
  }
  @keyframes hero-a-sweep {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    88% {
      opacity: 1;
    }
    100% {
      transform: translate(95.26px, 55px);
      opacity: 0;
    }
  }
  @keyframes hero-a-float {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-3.5px);
    }
  }
</style>

---
/*
 * Feature accordion 1 (package A): the reference's first feature block. Anchor #product is linked
 * from the header and footer. Measured at 1440: pad "feature" (112), eyebrow 20/28, H2 36/40 16px
 * below it, then the FeatureAccordion 58px below the H2 (screenshot 714 x 416 at x 24, accordion
 * 832..1416). Phones: screenshot above the list.
 *
 * Copy rules: titles stay on one line at 390 (26 characters or fewer); bodies are one or two
 * sentences that fit two lines at 1440 (about 100 characters), so the open item keeps the list as
 * tall as the screenshot. Every item carries a link to a real page or anchor, as in the reference,
 * so the list height does not jump when another item opens.
 * Facts: src/content/copy.md "Product tour" and the evidence table (retrieval and the Sources list,
 * @agent, skills and MCP servers switched on by admins, 38 providers chosen per workspace, per-
 * workspace documents, prompt and model, threads, three roles in multi-user mode).
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import FeatureAccordion, { type AccordionItem } from "../../ui/FeatureAccordion.astro";
import { COUNTS } from "../../../data/site";

// Real captures of the app (test instance with fictional sample documents).
const items: AccordionItem[] = [
  {
    id: "documents",
    title: "Documents with sources",
    body: "Files you add are parsed and indexed on your server. Answers drawn from them list their sources.",
    link: { href: "#grounded", label: "See how sources work" },
    image: { name: "feature-documents", alt: "An answer drawn from workspace documents, with the Sources panel showing each document and its match score." },
  },
  {
    id: "agents",
    title: "Agents and tools",
    body: "Type @agent to hand off a task. Agents use the skills and MCP servers your admins turn on.",
    link: { href: "/security#controls", label: "How admins control tools" },
    image: { name: "feature-agents", alt: "The Agent Skills settings page in Mission LLM." },
  },
  {
    id: "models",
    title: "Model choice per workspace",
    body: `Pick from ${COUNTS.llmProviders} model providers, local or cloud, and set a different one for each workspace.`,
    link: { href: "/security#data-flow", label: "Where your data goes" },
    image: { name: "feature-models", alt: "The LLM provider settings page in Mission LLM." },
  },
  {
    id: "workspaces",
    title: "Workspaces and threads",
    body: "Each workspace keeps its own documents, prompt and model. Threads keep lines of work apart.",
    link: { href: "/download#after-install", label: "Set up your first workspace" },
    image: { name: "feature-workspaces", alt: "A new thread in the Engineering Specs workspace, with the workspace and thread list in the sidebar." },
  },
  {
    id: "users",
    title: "Multi-user and roles",
    body: "In multi-user mode, everyone signs in with their own account and an admin, manager or default role.",
    link: { href: "/security#controls", label: "See access controls" },
    image: { name: "feature-users", alt: "The Users admin page in Mission LLM." },
  },
];
---

<Section id="product" pad="feature" class="section--h800" labelledby="product-title">
  <div data-reveal>
    <SectionIntro eyebrow="Ready on day one." title="Equipped for the mission." id="product-title" />
  </div>
  <div data-reveal="2">
    <FeatureAccordion id="product-acc" label="Product features" items={items} />
  </div>
</Section>

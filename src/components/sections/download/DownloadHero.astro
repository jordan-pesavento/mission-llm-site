---
/*
 * Download > Hero and platform chooser. Package C.
 * Copy: src/content/copy.md > Download > Hero and Platforms (verbatim).
 * The page's top section, so it is DARK (HERO-REVISION.md: each inner page's hero-equivalent top
 * section is navy, and the sections alternate below it; Install options that follows is light).
 * Every Download button on the site leads here, so the first screen answers "what can I install".
 * The platforms read as the reference's "Up and running" row: four columns, each with a 1px left rule
 * and 25px inset, a 36px glyph, a title and one line of text.
 * - Server (Docker, build from source): available today; "Get started" opens the Build from source
 *   tab (#p-source), the one method that works before public images exist.
 * - Windows, macOS, Linux desktop apps: "Coming soon", no links (installers do not exist).
 * The status note says public images are not published yet (REGISTRY stays a TODO placeholder).
 * Columns: 4 from 1024, 2 from 640; phones stack them and the desktop apps drop their one-line blurb.
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import Button from "../../ui/Button.astro";
import Badge from "../../ui/Badge.astro";
import Icon from "../../ui/Icon.astro";

const DESKTOP = [
  { name: "Windows", icon: "windows-logo", text: "A native desktop app for Windows, in development." },
  { name: "macOS", icon: "apple-logo", text: "A native desktop app for macOS, in development." },
  { name: "Linux", icon: "linux-logo", text: "A native desktop app for Linux, in development." },
];
---

<Section tone="dark" pad="hero" labelledby="download-title" class="dl-hero">
  <div class="dl-hero__top">
    <div class="dl-hero__intro" data-reveal>
      <SectionIntro level={1} eyebrow="Download" title="Install Mission LLM on your own infrastructure." id="download-title" />
      <p class="lead dl-hero__lead">
        Mission LLM runs as one container on a lab workstation, a school server or a cluster, beside a local model runtime.
        Pick the method that fits your environment. The commands below come from the project's deployment documentation.
      </p>
    </div>
    <div class="note dl-hero__note" role="note" data-reveal="2">
      <!-- TODO: REGISTRY is a placeholder until public release images are published. -->
      <p>
        <strong>Public release images are not published yet.</strong> Build the image from source today, push it to your
        own registry, and replace <code>REGISTRY</code> in the commands below.
      </p>
    </div>
  </div>

  <div class="platforms" data-reveal="3">
    <h2 class="sr-only" id="platforms-title">Platforms</h2>
    <ul class="platforms__grid" role="list" aria-labelledby="platforms-title">
      <li class="platform">
        <div class="platform__top">
          <Icon name="hard-drives" size={36} class="platform__glyph" />
          <Badge kind="today" />
        </div>
        <h3 class="h4 platform__name">Server</h3>
        <p class="platform__meta">Docker, build from source</p>
        <p class="platform__text">A lab workstation, a server in your rack, or Kubernetes, Helm and OpenShift.</p>
        <div class="platform__foot">
          <Button href="#p-source" iconEnd="arrow-down">Get started</Button>
        </div>
      </li>
      {
        DESKTOP.map((d) => (
          <li class="platform platform--soon">
            <div class="platform__top">
              <Icon name={d.icon} size={36} class="platform__glyph" />
              <Badge kind="soon" />
            </div>
            <h3 class="h4 platform__name">{d.name}</h3>
            <p class="platform__meta">Desktop app</p>
            <p class="platform__text">{d.text}</p>
          </li>
        ))
      }
    </ul>
    <p class="platforms__foot">
      Until the desktop apps ship, <a href="#p-source">build and run Mission LLM in Docker</a> on your own computer.
      Checksums and signatures will be published with the first release.
    </p>
  </div>
</Section>

<style>
  /* From 1024: the intro and the status note side by side, the note aligned to the intro's baseline. */
  .dl-hero__top {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-8);
    align-items: end;
  }
  .dl-hero__intro {
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .dl-hero__top {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--split-gap);
    }
  }
  .dl-hero__lead {
    max-width: var(--measure);
    margin-top: var(--space-6);
  }
  .dl-hero__note {
    max-width: var(--measure);
  }

  /* ---------- Platforms: the reference's step columns ---------- */
  .platforms {
    margin-top: var(--gap-intro);
  }
  .platforms__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-10) 0;
  }
  @media (min-width: 640px) {
    .platforms__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: var(--space-12);
    }
  }
  @media (min-width: 1024px) {
    .platforms__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  .platform {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--space-3) var(--space-6) 0 25px;
    border-left: 1px solid var(--color-line);
  }
  .platform__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-3);
    min-height: 40px;
  }
  .platform__top :global(.platform__glyph) {
    color: var(--color-text-muted);
  }
  .platform__name {
    margin-top: var(--space-8);
  }
  .platform__meta {
    margin-top: var(--space-1);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-medium);
    color: var(--color-text);
  }
  .platform__text {
    max-width: 17.5rem;
    margin-top: var(--space-3);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-muted);
  }
  .platform__foot {
    margin-top: auto;
    padding-top: var(--space-6);
  }
  .platforms__foot {
    max-width: var(--measure);
    margin-top: var(--space-10);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-muted);
  }

  /* Phones: the desktop apps are compact (glyph, name, "Desktop app", badge). */
  @media (max-width: 639.98px) {
    .platform--soon .platform__name {
      margin-top: var(--space-4);
    }
    .platform--soon .platform__text {
      display: none;
    }
  }
</style>

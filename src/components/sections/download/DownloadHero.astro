---
/*
 * Download > Hero and platform chooser. Work package C.
 * Copy: src/content/copy.md > Download > Hero and Platforms.
 * Every Download button on the site leads here, so the first screen answers "what can I install":
 * the headline, then four equal platform cards (the anythingllm.com/download pattern):
 * - Server (Docker, build from source): available today, "Get started" opens the Build from
 *   source tab (#p-source), the one method that works before public images exist.
 * - Windows, macOS, Linux desktop apps: "Coming soon" with no links (installers do not exist).
 * The status note says public images are not published yet. Checksums and signatures are
 * promised only as "with the first release".
 * Grid: the shared card grid (1-up, 2-up from 640, 4-up from 1280), equal heights, the action or
 * badge pinned to each card's bottom. On phones the three desktop cards are compact rows.
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import Button from "../../ui/Button.astro";
import Badge from "../../ui/Badge.astro";
import Icon from "../../ui/Icon.astro";

const DESKTOP = [
  { name: "Windows", icon: "windows-logo", text: "Try Mission LLM on a Windows PC." },
  { name: "macOS", icon: "apple-logo", text: "Try Mission LLM on a Mac." },
  { name: "Linux", icon: "linux-logo", text: "Try Mission LLM on a Linux desktop." },
];
---

<Section tone="light" labelledby="download-title" class="dl-hero">
  <div class="hero">
    <div class="hero__intro" data-reveal>
      <SectionIntro level={1} eyebrow="Download" title="Install Mission LLM on your own infrastructure." id="download-title" />
    </div>
    <p class="lead hero__lead" data-reveal="2">
      Mission LLM runs as a container. Pick the method that fits your environment. The commands below come from the
      project's deployment documentation.
    </p>
    <div class="note hero__note" role="note" data-reveal="2">
      <!-- TODO: REGISTRY is a placeholder until public release images are published. -->
      <p>
        <strong>Public release images are not published yet.</strong> Build the image from source today, push it to your
        own registry, and replace <code>REGISTRY</code> in the commands below.
      </p>
    </div>
  </div>

  <div class="platforms" data-reveal="3">
    <h2 class="sr-only" id="platforms-title">Platforms</h2>
    <ul class="card-grid platforms__grid" role="list" aria-labelledby="platforms-title">
      <li class="platform platform--server">
        <div class="platform__head">
          <span class="platform__icon" aria-hidden="true"><Icon name="hard-drives" size={26} /></span>
          <Badge kind="today" />
        </div>
        <h3 class="platform__name">Server</h3>
        <p class="platform__meta">Docker, build from source</p>
        <p class="platform__text">A workstation, a server in your rack, or Kubernetes, Helm and OpenShift.</p>
        <div class="platform__foot">
          <Button href="#p-source" iconEnd="arrow-down">Get started</Button>
        </div>
      </li>
      {
        DESKTOP.map((d) => (
          <li class="platform platform--soon">
            <div class="platform__head">
              <span class="platform__icon" aria-hidden="true">
                <Icon name={d.icon} size={26} />
              </span>
            </div>
            <h3 class="platform__name">{d.name}</h3>
            <p class="platform__meta">Desktop app</p>
            <p class="platform__text">{d.text}</p>
            <div class="platform__foot">
              <Badge kind="soon" />
            </div>
          </li>
        ))
      }
    </ul>
    <p class="platforms__foot">
      Until the desktop apps ship, <a href="#p-source">build and run Mission LLM in Docker</a> on your workstation.
      Checksums and signatures will be published with the first release.
    </p>
  </div>
</Section>

<style>
  .hero {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--space-6);
  }
  /* Explicit classes, not .hero > *: the scoped wildcard would outrank the media queries. */
  .hero__intro,
  .hero__lead,
  .hero__note {
    grid-column: 1 / -1;
    min-width: 0;
  }
  @media (min-width: 960px) {
    /* Two balanced lines instead of three at desktop widths. */
    .hero__intro :global(.display) {
      max-width: 26ch;
    }
  }
  .hero__lead {
    margin-top: calc(var(--gap-heading) - var(--space-6));
  }
  .hero__note {
    max-width: 44rem;
  }
  @media (min-width: 960px) {
    .hero__intro {
      grid-column: 1 / span 10;
    }
    .hero__lead,
    .hero__note {
      grid-column: 1 / span 8;
    }
  }
  @media (min-width: 1280px) {
    .hero {
      row-gap: var(--space-7);
      align-items: start;
    }
    .hero__lead {
      margin-top: 0;
      grid-column: 1 / span 6;
    }
    .hero__note {
      grid-column: 7 / -1;
      max-width: none;
    }
  }

  /* ---------- Platform chooser ---------- */
  .platforms {
    margin-top: var(--gap-visual);
  }
  .platform {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: var(--card-pad);
    border-radius: var(--radius-lg);
  }
  .platform--server {
    background: var(--color-surface);
    box-shadow:
      0 0 0 1px var(--color-hairline-strong),
      var(--shadow-card);
  }
  /* Dashed outline: not available yet, matching the Coming soon badge. */
  .platform--soon {
    border: 1px dashed var(--color-hairline-dashed);
    background: transparent;
  }
  .platform__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }
  .platform__icon {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    color: var(--color-accent);
    background: var(--color-stage);
    box-shadow: inset 0 0 0 1px var(--color-hairline);
  }
  .platform--soon .platform__icon {
    color: var(--color-text-3);
    background: transparent;
  }
  .platform__name {
    font-size: var(--fs-h3);
    line-height: var(--lh-h3);
    letter-spacing: var(--ls-h3);
    font-weight: var(--fw-h3);
  }
  .platform__meta {
    margin-top: var(--space-1);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: 500;
    color: var(--color-text-2);
  }
  .platform__text {
    margin-top: var(--space-3);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }
  /* 48px, the button height, so the badges center on the same line as Get started. */
  .platform__foot {
    display: flex;
    align-items: center;
    min-height: 48px;
    margin-top: auto;
    padding-top: var(--space-6);
  }
  .platforms__foot {
    margin-top: var(--space-5);
    max-width: var(--measure);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-2);
  }

  /* Phones: the three desktop apps are compact rows (icon, name, badge) under the server card. */
  @media (max-width: 639.98px) {
    .platform--soon {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      grid-template-areas:
        "icon name badge"
        "icon meta badge";
      align-items: center;
      column-gap: var(--space-4);
      padding-block: var(--space-4);
    }
    .platform--soon .platform__head {
      grid-area: icon;
      margin: 0;
    }
    .platform--soon .platform__name {
      grid-area: name;
      font-size: var(--fs-h4);
      line-height: var(--lh-h4);
    }
    .platform--soon .platform__meta {
      grid-area: meta;
      margin: 0;
      font-weight: 400;
    }
    .platform--soon .platform__text {
      display: none;
    }
    .platform--soon .platform__foot {
      grid-area: badge;
      margin: 0;
      padding: 0;
    }
  }
</style>

---
/*
 * Private layout for the Download sections (work package C): the heading rail.
 * Below 1280 the heading stacks above the content. From 1280 the heading (and the optional
 * "aside" slot under it) sits in columns 1 to 4 and the content in columns 5 to 12, so every
 * Download section lines up with the install options panel.
 * Usage: <Rail title="System requirements" id="requirements-title"> ...content... </Rail>
 */
import SectionIntro from "../../ui/SectionIntro.astro";

interface Props {
  title: string;
  id: string;
}
const { title, id } = Astro.props;
const hasAside = Astro.slots.has("aside");
---

<div class="rail">
  <div class="rail__head" data-reveal>
    <SectionIntro title={title} id={id} />
    {hasAside && <div class="rail__aside"><slot name="aside" /></div>}
  </div>
  <div class="rail__body" data-reveal="2"><slot /></div>
</div>

<style>
  .rail {
    display: grid;
    grid-template-columns: repeat(var(--grid-cols), minmax(0, 1fr));
    column-gap: var(--grid-gap);
    row-gap: var(--gap-visual);
  }
  .rail__head,
  .rail__body {
    grid-column: 1 / -1;
    min-width: 0;
  }
  .rail__aside {
    margin-top: var(--gap-heading);
    max-width: var(--measure);
  }
  @media (min-width: 1280px) {
    .rail__head {
      grid-column: 1 / span 4;
    }
    .rail__body {
      grid-column: 5 / -1;
    }
  }
</style>

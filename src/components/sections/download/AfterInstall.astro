---
/*
 * Download > After you install. Package C.
 * Copy: src/content/copy.md > Download > After you install (5 steps, verbatim). The short step
 * titles are ours; the sentences under them are the copy. "Just me" and "My team" are the real
 * onboarding labels (mission-llm frontend/src/locales/en/common.js:16-17). Step 5 names a course,
 * a cohort or a team (positioning pass): the same workspace serves all three.
 * Visual system: the reference's "Up and running in a few clicks." row, with an illustration per
 * step as on the home steps row. H2 48/48 (SectionIntro size="lg"), 56 to 96px, then one column per
 * step with a 1px mist-300 left rule and a 25px inset: the number (Jakarta 36/40, mist-500), a
 * Jakarta 600 20/28 title 32px below, the illustration 20px below that, and 16/24 text 20px below it.
 * Five columns from 1280 (never a lone last step), stacked below 1280: at 1024 five columns would
 * break the inline commands (http://localhost:3001, DISABLE_TELEMETRY="true") mid-token.
 * Illustrations: isometric line art in the language of public/images/steps/*.svg. Step 2 reuses the
 * home steps art (model.svg); steps 1, 3, 4 and 5 are public/images/install/*.svg (access.svg is the
 * Users panel of team.svg with its labels drawn as ink bars, since the words are illegible at these sizes).
 * Decorative (alt=""), lazy (below the fold), square: min(250px, 100%) when stacked (as the home
 * steps row), min(200px, 100%) from 1280, where the content box of a column is about 197px. From
 * 1280 the titles keep a two-line slot (56px) so the five illustrations start on one line.
 * Inline code never breaks mid-token (the global :not(pre) > code rule). Step 1 puts a few words
 * before the URL chip, so no lone "Open" is left above it; step 4 names the variable and its value as
 * two short chips, so the sentence wraps between them in a 197px column.
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import { LOCAL_URL, TELEMETRY_ENV } from "../../../data/site";

const code = (s: string) => `<code>${s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;")}</code>`;
// DISABLE_TELEMETRY="true", split at "=" into the name and the exact value it must have.
const [TELEMETRY_NAME, TELEMETRY_VALUE] = TELEMETRY_ENV.split("=");

const STEPS = [
  {
    title: "Open the app",
    text: `In a browser, open ${code(LOCAL_URL)} or your server's address on port 3001.`,
    visual: "/images/install/open-app.svg",
  },
  {
    title: "Choose a model",
    text: "In onboarding, choose your model provider. Documents are embedded with the built-in embedder and stored in the built-in LanceDB store by default. You can change both in Settings.",
    visual: "/images/steps/model.svg",
  },
  {
    title: "Set up access",
    text: "Choose “Just me” to set a password, or “My team” to turn on multi-user mode for a class or a team, before anyone else can reach the server.",
    visual: "/images/install/access.svg",
  },
  {
    title: "Turn off telemetry",
    text: `Confirm ${code(TELEMETRY_NAME)} is set to ${code(TELEMETRY_VALUE)} in the server environment.`,
    visual: "/images/install/telemetry-off.svg",
  },
  {
    title: "Add your documents",
    text: "Create a workspace for each course, cohort or team and add its syllabus, readings, manuals or policies.",
    visual: "/images/install/course-documents.svg",
  },
];
---

<Section id="after-install" labelledby="after-install-title">
  <div data-reveal>
    <SectionIntro title="After you install" size="lg" id="after-install-title" />
  </div>
  <ol class="steps" role="list" data-reveal="2">
    {
      STEPS.map((s, i) => (
        <li class="step">
          <span class="num" aria-hidden="true">
            {i + 1}
          </span>
          <h3 class="h4 step__title">{s.title}</h3>
          <img class="step__visual" src={s.visual} width="250" height="250" alt="" loading="lazy" decoding="async" />
          <p class="step__text" set:html={s.text} />
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-10) 0;
    margin-top: var(--gap-h2-grid);
  }
  @media (min-width: 1280px) {
    .steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .step {
    min-width: 0;
    padding: var(--space-3) var(--space-6) 0 25px;
    border-left: 1px solid var(--color-line);
  }
  .step__title {
    margin-top: var(--space-5);
  }
  .step__visual {
    display: block;
    width: 250px;
    max-width: 100%;
    height: auto;
    aspect-ratio: 1;
    margin-top: var(--space-5);
  }
  .step__text {
    margin-top: var(--space-5);
    max-width: var(--measure);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--color-text-muted);
  }
  /* In the narrow five-column layout a URL chip can be wider than its column; let it wrap there
     (these are references in prose, not copy-paste command blocks, which stay in CodeBlock). */
  @media (min-width: 1280px) {
    .step__text :global(code) {
      white-space: normal;
      overflow-wrap: anywhere;
    }
  }
  @media (min-width: 1280px) {
    .step__title {
      min-height: 3.5rem; /* 56: two title lines, so every illustration starts on one line */
    }
    .step__visual {
      width: min(200px, 100%);
    }
    .step__text {
      max-width: 17.5rem;
    }
  }
</style>

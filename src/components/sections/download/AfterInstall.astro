---
/*
 * Download > After you install. Package C.
 * Copy: src/content/copy.md > Download > After you install (5 steps, verbatim). The short step
 * titles are ours; the sentences under them are the copy.
 * Visual system: the reference's "Up and running in a few clicks." row. H2 48/48 (SectionIntro
 * size="lg"), 56 to 96px, then one column per step with a 1px mist-300 left rule and a 25px inset:
 * the number (Jakarta 36/40, mist-500), a Jakarta 600 20/28 title 32px below, and 16/24 text.
 * Five columns from 1280 (never a lone last step), stacked below 1280: at 1024 five columns would
 * break the inline commands (http://localhost:3001, DISABLE_TELEMETRY="true") mid-token.
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import { LOCAL_URL, TELEMETRY_ENV } from "../../../data/site";

const code = (s: string) => `<code>${s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/"/g, "&quot;")}</code>`;

const STEPS = [
  { title: "Open the app", text: `Open ${code(LOCAL_URL)}, or your server's address on port 3001.` },
  {
    title: "Choose a model",
    text: "In onboarding, choose your model provider. Documents are embedded with the built-in embedder and stored in the built-in LanceDB store by default. You can change both in Settings.",
  },
  {
    title: "Set up access",
    text: "Choose “Just me” to set a password, or “My team” to turn on multi-user mode, before anyone else can reach the server.",
  },
  { title: "Turn off telemetry", text: `Confirm ${code(TELEMETRY_ENV)} is set in the server environment.` },
  { title: "Add documents", text: "Create a workspace and add your documents." },
];
---

<Section id="after-install" labelledby="after-install-title">
  <div data-reveal>
    <SectionIntro title="After you install" size="lg" id="after-install-title" />
  </div>
  <ol class="steps" role="list" data-reveal="2">
    {
      STEPS.map((s, i) => (
        <li class="step">
          <span class="step__num" aria-hidden="true">
            {i + 1}
          </span>
          <h3 class="h4 step__title">{s.title}</h3>
          <p class="step__text" set:html={s.text} />
        </li>
      ))
    }
  </ol>
</Section>

<style>
  .steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-10) 0;
    margin-top: var(--gap-h2-grid);
  }
  @media (min-width: 1280px) {
    .steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }
  .step {
    min-width: 0;
    padding: var(--space-3) var(--space-6) 0 25px;
    border-left: 1px solid var(--color-line);
  }
  .step__num {
    display: block;
    font-size: var(--fs-step-num);
    line-height: var(--lh-step-num);
    color: var(--mist-500);
  }
  .step__title {
    margin-top: var(--space-8);
  }
  .step__text {
    margin-top: var(--space-3);
    max-width: var(--measure);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--mist-600);
  }
  @media (min-width: 1280px) {
    .step__text {
      max-width: 17.5rem;
    }
  }
  .step__text :global(code) {
    white-space: normal;
    overflow-wrap: anywhere;
  }
</style>

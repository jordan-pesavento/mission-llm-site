---
/*
 * Download > Install options (anchor #options). Work package C.
 * Copy: src/content/copy.md > Download > Install options. Every command is read verbatim from
 * copy.md by ./_commands.ts and rendered in a CodeBlock.
 *
 * Method tabs use src/scripts/tabs.ts (data-tabs-hash, so /download#p-helm opens Helm).
 * Panel ids: p-source (first, the default), p-docker, p-compose, p-kubernetes, p-helm, p-openshift.
 * Arrow keys in either axis move between methods (tabs.ts), whether the list is a grid or a column.
 * Without JS the tablists stay hidden and every panel renders in order under its own h3.
 * Visual system (reference, anythingllm.com feature sections): eyebrow and H2, 48 to 58px, then two
 * columns from 1024 (5fr | 12fr, the 94px split gap). The method list reads like the reference's
 * accordion: 60px rows, Clash Display 400 18/24 titles, mist-300 separators; the selected row is
 * ink with an arrow, the others mist-600. The list sticks under the header while the panel scrolls.
 * Below 1024 the methods are a 2-up (phones) or 3-up grid of 44px, radius-8 controls above the
 * panel (secondary ring; the selected one is solid navy like the primary button).
 * Cloud templates, For evaluation and Without containers follow on hairline rows in the same two
 * columns. The cloud list holds exactly COUNTS.cloudTemplates entries (the home page shows the count).
 * The container methods end with "Then open http://localhost:3001" (the Ollama pattern). The
 * cluster methods do not: their address is the ingress, route or service you configure.
 */
import Section from "../../ui/Section.astro";
import SectionIntro from "../../ui/SectionIntro.astro";
import CodeBlock from "../../ui/CodeBlock.astro";
import Icon from "../../ui/Icon.astro";
import { COUNTS, LOCAL_URL } from "../../../data/site";
import { fences } from "./_commands";

const [dockerUnix, dockerWindows] = fences("Docker", 2);
const [composeFile, composeUp] = fences("Docker Compose", 2);
const [sourceBuild, sourceCompose] = fences("Build from source", 2);
const [k8sApply] = fences("Kubernetes", 1);
const [helmValues, helmInstall] = fences("Helm", 2);
const [openshiftCmds] = fences("OpenShift", 1);

// Build from source is first and selected by default: it is the one method that works before public
// images exist (every other method needs an image in your registry).
const METHODS = [
  { id: "source", label: "Build from source" },
  { id: "docker", label: "Docker" },
  { id: "compose", label: "Docker Compose" },
  { id: "kubernetes", label: "Kubernetes" },
  { id: "helm", label: "Helm" },
  { id: "openshift", label: "OpenShift" },
];

/** Inline command text that may wrap only after "=" and ":" (never at the hyphens of a flag). */
const flag = (text: string) =>
  text
    .split(/(?<=[=:])/)
    .map((part) => `<span class="nowrap">${part.replace(/&/g, "&amp;").replace(/</g, "&lt;")}</span>`)
    .join("<wbr>");

// Exactly COUNTS.cloudTemplates entries (src/data/site.ts): the home page counts them. Hugging Face
// Spaces is an evaluation Dockerfile, not a cloud template, so it has its own row below.
const CLOUD = [
  { name: "AWS CloudFormation", detail: "One EC2 instance running the container." },
  { name: "Google Cloud Deployment Manager", detail: "One Compute Engine VM." },
  { name: "DigitalOcean Terraform", detail: "One Droplet." },
];
if (CLOUD.length !== COUNTS.cloudTemplates)
  throw new Error(`InstallOptions: ${CLOUD.length} cloud templates listed, COUNTS.cloudTemplates is ${COUNTS.cloudTemplates}.`);
---

<Section id="options" labelledby="options-title">
  <div data-reveal>
    <SectionIntro eyebrow="From one container to a cluster." title="Install options" id="options-title" />
  </div>
  <div class="opts" data-tabs data-tabs-hash data-install>

    <div
      class="opts__tabs"
      role="tablist"
      aria-label="Install method"
      aria-orientation="vertical"
      hidden
      data-row="install-tabs"
      data-install-tabs
    >
      {
        METHODS.map((m, i) => (
          <button
            type="button"
            role="tab"
            class="opts__tab"
            id={`t-${m.id}`}
            aria-controls={`p-${m.id}`}
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? undefined : "-1"}
          >
            <span class="opts__tab-label">{m.label}</span>
            <Icon name="arrow-right" size={20} class="opts__tab-icon" />
          </button>
        ))
      }
    </div>

    <div class="opts__panels" data-reveal="2">
      <!-- Build from source -->
      <div class="panel" role="tabpanel" id="p-source" aria-labelledby="t-source">
        <div class="panel__head">
          <h3 class="h3">Build from source</h3>
          <p class="body">Build the image yourself from the repository. This is the supported path today.</p>
        </div>
        <CodeBlock label="Terminal" lang={sourceBuild.lang} code={sourceBuild.code} />
        <p class="body panel__prose">
          Then run it with the <a href="#p-docker">Docker command</a>, using <code>mission-llm:latest</code> as the image
          name. Or build and run with Compose from the repository:
        </p>
        <CodeBlock label="Terminal" lang={sourceCompose.lang} code={sourceCompose.code} />
        <p class="panel__next">Then open <code>{LOCAL_URL}</code></p>
        <ul class="dot-list panel__notes" role="list">
          <li>
            The build downloads packages from the internet. For a disconnected site, build on a connected machine and move
            the image across with your approved transfer process.
          </li>
        </ul>
      </div>

      <!-- Docker -->
      <div class="panel" role="tabpanel" id="p-docker" aria-labelledby="t-docker">
        <div class="panel__head">
          <h3 class="h3">Docker</h3>
          <p class="body">One container and one storage folder. Your data persists across image updates.</p>
        </div>
        <div class="os" data-tabs>
          <div class="os__switch" role="tablist" aria-label="Operating system" hidden data-row="os-switch">
            <button type="button" role="tab" class="os__tab" id="t-docker-unix" aria-controls="p-docker-unix" aria-selected="true">Linux or macOS</button>
            <button type="button" role="tab" class="os__tab" id="t-docker-windows" aria-controls="p-docker-windows" aria-selected="false" tabindex="-1">Windows</button>
          </div>
          <div role="tabpanel" id="p-docker-unix" aria-labelledby="t-docker-unix" class="os__panel">
            <CodeBlock label="Linux or macOS" lang={dockerUnix.lang} code={dockerUnix.code} />
          </div>
          <div role="tabpanel" id="p-docker-windows" aria-labelledby="t-docker-windows" class="os__panel">
            <CodeBlock label="Windows (PowerShell)" lang={dockerWindows.lang} code={dockerWindows.code} />
          </div>
        </div>
        <p class="panel__next">Then open <code>{LOCAL_URL}</code></p>
        <ul class="dot-list panel__notes" role="list">
          <li>To turn off telemetry from the first start, add <code>-e DISABLE_TELEMETRY="true"</code> before the image name.</li>
          <li>
            Model runtime on the same machine: in Mission LLM, use <code>http://host.docker.internal:PORT</code> instead of <code>localhost</code>. On Linux, also add <code class="code-flag" set:html={flag("--add-host=host.docker.internal:host-gateway")} /> to the run command.
          </li>
        </ul>
      </div>

      <!-- Docker Compose -->
      <div class="panel" role="tabpanel" id="p-compose" aria-labelledby="t-compose">
        <div class="panel__head">
          <h3 class="h3">Docker Compose</h3>
          <p class="body">The same container as a managed service that restarts automatically.</p>
        </div>
        <div class="panel__code">
          <CodeBlock label="docker-compose.yml" lang={composeFile.lang} code={composeFile.code} />
          <CodeBlock label="Terminal" lang={composeUp.lang} code={composeUp.code} />
        </div>
        <p class="panel__next">Then open <code>{LOCAL_URL}</code></p>
        <ul class="dot-list panel__notes" role="list">
          <li>Any setting from <code>docker/.env.example</code> can go in the <code>environment</code> list.</li>
        </ul>
      </div>

      <!-- Kubernetes -->
      <div class="panel" role="tabpanel" id="p-kubernetes" aria-labelledby="t-kubernetes">
        <div class="panel__head">
          <h3 class="h3">Kubernetes</h3>
          <p class="body">An example manifest with a persistent volume, deployment, service and ingress.</p>
        </div>
        <ol class="panel__steps" role="list">
          <li>
            <span class="panel__num tnum">1</span>
            <p>Set <code>image</code> to the image in your registry.</p>
          </li>
          <li>
            <span class="panel__num tnum">2</span>
            <p>Replace the volume placeholder with storage that fits your cluster. The example uses an AWS EBS volume.</p>
          </li>
          <li>
            <span class="panel__num tnum">3</span>
            <div class="panel__step-body">
              <p>Apply it:</p>
              <CodeBlock label="Terminal" lang={k8sApply.lang} code={k8sApply.code} />
            </div>
          </li>
        </ol>
      </div>

      <!-- Helm -->
      <div class="panel" role="tabpanel" id="p-helm" aria-labelledby="t-helm">
        <div class="panel__head">
          <h3 class="h3">Helm</h3>
          <p class="body">
            A chart with ConfigMap settings, Secret references, persistent storage, and Ingress and Gateway API support.
            Telemetry is off by default in the chart.
          </p>
        </div>
        <div class="panel__code">
          <CodeBlock label="values-secret.yaml" lang={helmValues.lang} code={helmValues.code} />
          <CodeBlock label="Terminal" lang={helmInstall.lang} code={helmInstall.code} />
        </div>
        <ul class="dot-list panel__notes" role="list">
          <li>
            Keep API keys and other secrets in Kubernetes Secrets. The chart's <code>config</code> values render to a
            ConfigMap, which is not encrypted.
          </li>
        </ul>
      </div>

      <!-- OpenShift -->
      <div class="panel" role="tabpanel" id="p-openshift" aria-labelledby="t-openshift">
        <div class="panel__head">
          <h3 class="h3">OpenShift</h3>
          <p class="body">
            A dedicated image for restricted security context constraints, arbitrary user IDs and GID 0. The template is
            community-maintained.
          </p>
        </div>
        <CodeBlock label="Terminal" lang={openshiftCmds.lang} code={openshiftCmds.code} />
      </div>
    </div>
  </div>

  <div class="more">
    <div class="more__row">
      <h3 class="h3 more__title" id="cloud-title">Cloud templates</h3>
      <div class="more__body">
        <dl class="cloud" aria-labelledby="cloud-title">
          {
            CLOUD.map((t) => (
              <div>
                <dt>{t.name}</dt>
                <dd>{t.detail}</dd>
              </div>
            ))
          }
        </dl>
        <p class="note more__note">
          Each template pulls the image you name and serves HTTP on port 3001 without TLS. Add TLS and a password before
          you expose it.
        </p>
      </div>
    </div>
    <div class="more__row">
      <h3 class="h3 more__title">For evaluation</h3>
      <div class="more__body">
        <p class="body measure">
          A Hugging Face Spaces Dockerfile runs the image you name in a Space. Keep the Space private until you set a
          password or turn on multi-user mode.
        </p>
      </div>
    </div>
    <div class="more__row">
      <h3 class="h3 more__title">Without containers</h3>
      <div class="more__body">
        <p class="body measure">
          Running directly on Node.js 18 or later with Yarn 1.x is documented for reference only and is not a supported
          deployment method.
        </p>
      </div>
    </div>
  </div>
</Section>

<script>
  import "../../../scripts/tabs.ts";

  // Deep links (/download#p-helm) and in-page links (#p-docker): once tabs.ts has shown the
  // panel, scroll to the method list (not the panel) so the selected tab stays in view on phones.
  // The browser cannot do this itself: the panel was hidden, or the list sits above it.
  const root = document.querySelector<HTMLElement>("[data-install]");
  const panelFor = (hash: string) => {
    if (!root || !/^#p-[a-z]+$/.test(hash)) return null;
    const el = document.getElementById(hash.slice(1));
    return el && root.contains(el) && el.getAttribute("role") === "tabpanel" ? el : null;
  };
  const scrollToList = () => {
    const pad = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
    window.scrollTo(0, root!.getBoundingClientRect().top + window.scrollY - pad);
  };
  const landed = panelFor(location.hash);
  if (landed) {
    // After load, so the browser's own jump to the fragment does not override this one. The
    // fragment jump also focuses the panel, which would draw a focus ring on arrival; drop that
    // (the sequential focus starting point stays at the panel for keyboard users).
    const go = () =>
      requestAnimationFrame(() => {
        if (document.activeElement === landed) landed.blur();
        scrollToList();
      });
    if (document.readyState === "complete") go();
    else window.addEventListener("load", go, { once: true });
  }
  window.addEventListener("hashchange", () => {
    const panel = panelFor(location.hash);
    if (!panel) return;
    requestAnimationFrame(() => {
      const top = panel.getBoundingClientRect().top;
      if (top < 0 || top > window.innerHeight * 0.6) scrollToList();
    });
  });
</script>

<style>
  /* ---------- Frame: method list and panel ---------- */
  .opts {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-6);
    margin-top: var(--gap-h2-content);
  }
  .opts__tabs,
  .opts__panels {
    min-width: 0;
  }

  /* Below 1024: a grid of 44px controls, 2-up on phones and 3-up from 640. */
  .opts__tabs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }
  @media (min-width: 640px) {
    .opts__tabs {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .opts__tab {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding-inline: var(--space-3);
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px var(--color-line);
    font-family: var(--font-sans);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-medium);
    white-space: nowrap;
    color: var(--color-heading);
  }
  /* Transitions only while hovered: the two layouts swap styles at 1024, and a full-page capture
     (which briefly resizes the viewport) must not catch a tab mid-fade. */
  .opts__tab:hover {
    background: rgb(11 20 48 / 0.04);
    transition:
      color var(--dur-hover) var(--ease-standard),
      background-color var(--dur-hover) var(--ease-standard);
  }
  .opts__tab[aria-selected="true"] {
    background: var(--navy-950);
    box-shadow: none;
    color: #ffffff;
  }
  .opts__tab :global(.opts__tab-icon) {
    display: none;
  }
  .opts__tab:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* From 1024: the reference's accordion rows beside the panel. Not sticky (owner, 2026-09-27: no page
     chrome that follows the reader over the sections). */
  @media (min-width: 1024px) {
    .opts {
      grid-template-columns: minmax(0, 5fr) minmax(0, 12fr);
      column-gap: var(--split-gap);
      align-items: start;
    }
    .opts__tabs {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .opts__tab {
      justify-content: space-between;
      gap: var(--space-4);
      height: auto;
      min-height: 60px;
      padding: 18px 0;
      border-radius: 0;
      border-bottom: 1px solid var(--color-line);
      box-shadow: none;
      font-family: var(--font-display);
      font-size: var(--fs-acc);
      line-height: var(--lh-acc);
      font-weight: var(--fw-acc);
      text-align: left;
      color: var(--color-text-muted);
    }
    .opts__tab:hover {
      background: none;
      color: var(--color-heading);
    }
    .opts__tab:hover .opts__tab-label {
      text-decoration: underline;
      text-decoration-thickness: 1px;
      text-underline-offset: 5px;
    }
    .opts__tab[aria-selected="true"] {
      background: none;
      color: var(--color-heading);
    }
    .opts__tab :global(.opts__tab-icon) {
      display: inline-block;
      visibility: hidden;
    }
    .opts__tab[aria-selected="true"] :global(.opts__tab-icon) {
      visibility: visible;
    }
    .opts__tab:focus-visible {
      outline-offset: 4px;
      border-radius: var(--radius-sm);
    }
  }

  /* ---------- Panel ---------- */
  .panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-5);
    min-width: 0;
  }
  .panel:focus-visible {
    outline-offset: 8px;
    border-radius: var(--radius-lg);
  }
  /* Without JS every panel shows in order: separate them. */
  .panel + .panel {
    margin-top: var(--space-8);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-line);
  }
  :global(.js) .panel + .panel {
    margin-top: 0;
    padding-top: 0;
    border-top: 0;
  }
  .panel__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-2);
    max-width: var(--measure);
    margin-bottom: var(--space-2);
  }
  .panel__head .body {
    color: var(--color-text-muted);
  }
  .panel__code {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    min-width: 0;
  }
  .panel__prose {
    max-width: var(--measure);
    color: var(--color-text-muted);
  }
  .panel__next {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2) var(--space-3);
    padding-block: var(--space-4);
    border-bottom: 1px solid var(--color-line);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-medium);
    color: var(--color-heading);
  }
  .panel__next code {
    font-size: 0.95em;
  }
  @media (min-width: 640px) {
    /* Keep flags and URLs on one line where the column is wide enough. */
    .panel__notes code,
    .panel__prose code {
      white-space: nowrap;
      overflow-wrap: normal;
    }
  }
  .panel__notes {
    max-width: var(--measure);
  }
  .panel__notes > li {
    color: var(--color-text-muted);
  }
  .panel__steps {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-width: 0;
  }
  .panel__steps li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: var(--space-4);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-line);
    color: var(--color-text-muted);
  }
  .panel__steps li:last-child {
    padding-bottom: 0;
  }
  .panel__num {
    font-size: var(--fs-h4);
    line-height: var(--lh-body);
    color: var(--mist-500);
  }
  .panel__step-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    min-width: 0;
  }

  /* ---------- Operating system switch inside the Docker panel ---------- */
  .os {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4);
    min-width: 0;
  }
  .os__switch {
    display: inline-grid;
    grid-template-columns: repeat(2, minmax(0, max-content));
    justify-self: start;
    gap: var(--space-2);
  }
  .os__tab {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 44px;
    padding-inline: var(--space-5);
    border-radius: var(--radius-sm);
    box-shadow: inset 0 0 0 1px var(--color-line);
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-medium);
    white-space: nowrap;
    color: var(--color-heading);
    transition:
      color var(--dur-hover) var(--ease-standard),
      background-color var(--dur-hover) var(--ease-standard);
  }
  .os__tab:hover {
    background: rgb(11 20 48 / 0.04);
  }
  .os__tab[aria-selected="true"] {
    background: var(--navy-950);
    box-shadow: none;
    color: #ffffff;
  }
  .os__tab:focus-visible {
    outline: 2px solid var(--color-focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }

  /* ---------- Cloud templates and Without containers ---------- */
  .more {
    margin-top: var(--space-24);
  }
  .more__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    row-gap: var(--space-5);
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-line);
  }
  .more__row:last-child {
    padding-bottom: 0;
  }
  .more__title,
  .more__body {
    min-width: 0;
  }
  @media (min-width: 1024px) {
    .more__row {
      grid-template-columns: minmax(0, 5fr) minmax(0, 12fr);
      column-gap: var(--split-gap);
    }
  }
  /* The three templates: one row of three from 768 (never two plus an orphan), stacked below. */
  .cloud {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-4) var(--card-gap);
  }
  @media (min-width: 768px) {
    .cloud {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  .cloud > div {
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-line);
  }
  .cloud dt {
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-semibold);
    color: var(--color-heading);
  }
  .cloud dd {
    margin-top: var(--space-1);
    color: var(--color-text-muted);
  }
  .more__note {
    max-width: none;
    margin-top: var(--space-6);
  }
  .more__body .body {
    color: var(--color-text-muted);
  }
</style>

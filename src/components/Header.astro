---
/*
 * Site header, after the reference (anythingllm.com):
 * - From 1024: a 68px bar with a 1px mist-300 bottom rule on the mist-200 tone. Emblem and wordmark
 *   inset 80px from the left; the nav sits right; the last element is a full-height dark "Download"
 *   block (178px wide, #070F26, white label) flush with the right edge of the window.
 * - Below 1024: a 64px bar on the page tone with the emblem and wordmark at 20px and a three-line menu
 *   button at the right (no Download in the bar, as in the reference). The menu opens a full-height
 *   panel under the bar: large nav rows and the same dark Download block across the bottom.
 * Sticky at the top. Menu: aria-expanded, Escape closes and returns focus, Tab from the last item
 * returns to the button, page scroll is locked while open, links close it.
 * Without JS the nav shows as a wrapping row under the bar on small screens, so every link works.
 * Nav entries whose destination is still a TODO ("#") render as muted text with a "Soon" tag, not as
 * links; they become links when the destination exists (src/data/site.ts). Today the nav has the
 * reference's three links; Docs is left out until a docs site exists.
 */
import { NAV, DOWNLOAD_HREF, SITE, isPlaceholder } from "../data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => !href.includes("#") && href !== "/" && path === href.replace(/\/$/, "");
---

<header class="site-header" data-site-header>
  <div class="site-header__bar">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}>
      <img class="brand__emblem" src="/mission-llm-emblem.svg" width="28" height="28" alt="" />
      <span class="brand__word">{SITE.name}</span>
    </a>

    <nav class="site-nav" id="site-nav" aria-label="Primary" data-site-nav>
      <ul role="list" class="site-nav__list">
        {
          NAV.map((item) => (
            <li>
              {isPlaceholder(item.href) ? (
                /* TODO: becomes a link when the destination exists (see src/data/site.ts). */
                <span class="site-nav__link site-nav__link--soon" aria-disabled="true" data-todo={item.todo}>
                  {item.label}
                  <span class="soon-tag">Soon</span>
                </span>
              ) : (
                <a class="site-nav__link" href={item.href} aria-current={isCurrent(item.href) ? "page" : undefined}>
                  {item.label}
                </a>
              )}
            </li>
          ))
        }
      </ul>
      <a class="site-nav__download" href={DOWNLOAD_HREF}>Download</a>
    </nav>

    <a class="header-download" href={DOWNLOAD_HREF}>Download</a>

    <button type="button" class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="site-nav" aria-label="Menu" hidden>
      <svg class="menu-toggle__open" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M1 5h22M1 12h22M1 19h22" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" fill="none"></path>
      </svg>
      <svg class="menu-toggle__close" width="24" height="24" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path d="M4 4l16 16M20 4L4 20" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" fill="none"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-menu-toggle]");
  const nav = header?.querySelector<HTMLElement>("[data-site-nav]");
  if (header && toggle && nav) {
    const desktop = window.matchMedia("(min-width: 1024px)");
    toggle.hidden = false;
    const isOpen = () => toggle.getAttribute("aria-expanded") === "true";
    const focusables = () => [...nav.querySelectorAll<HTMLAnchorElement>("a[href]")];
    const setOpen = (open: boolean, { restoreFocus = false, focusFirst = false } = {}) => {
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? "Close menu" : "Menu");
      header.toggleAttribute("data-menu-open", open);
      document.documentElement.classList.toggle("menu-lock", open);
      if (open && focusFirst) focusables()[0]?.focus();
      if (!open && restoreFocus) toggle.focus();
    };
    toggle.addEventListener("click", () => setOpen(!isOpen(), { focusFirst: true }));
    // Tab from the last item cycles back to the menu button instead of leaving the open panel.
    nav.addEventListener("keydown", (e) => {
      if (e.key !== "Tab" || e.shiftKey || !isOpen() || desktop.matches) return;
      const all = focusables();
      if (document.activeElement === all[all.length - 1]) {
        e.preventDefault();
        toggle.focus();
      }
    });
    header.addEventListener("focusout", (e) => {
      const next = e.relatedTarget as Node | null;
      if (isOpen() && next && !header.contains(next)) setOpen(false);
    });
    nav.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("a")) setOpen(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && isOpen()) setOpen(false, { restoreFocus: true });
    });
    desktop.addEventListener("change", () => setOpen(false));
  }
</script>

<style>
  :global(html.menu-lock) {
    overflow: hidden;
  }
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--mist-50);
    border-bottom: 1px solid var(--mist-300);
  }
  .site-header__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    min-height: var(--header-h);
    padding-left: var(--header-pad-x);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 4px; /* reference: 7px of air from the emblem ink to the wordmark ink */
    height: var(--header-h);
    margin-right: auto;
    color: var(--ink);
    text-decoration: none;
  }
  .brand__emblem {
    width: 28px;
    height: 28px;
  }
  .brand__word {
    font-family: var(--font-display);
    font-size: 1.25rem; /* 20 */
    line-height: 1;
    font-weight: var(--fw-medium);
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  /* ---------- Nav (desktop row) ---------- */
  .site-nav__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    column-gap: var(--space-8);
  }
  .site-nav__link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 44px;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-regular);
    letter-spacing: -0.025em; /* reference: "Product" 58px, "Resources" 76px at 16px */
    white-space: nowrap;
    color: var(--mist-700);
    text-decoration: none;
  }
  a.site-nav__link:hover {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 6px;
  }
  .site-nav__link[aria-current="page"] {
    color: var(--ink);
    font-weight: var(--fw-medium);
  }
  .site-nav__link--soon {
    color: var(--mist-600);
    cursor: default;
  }
  .soon-tag {
    display: inline-flex;
    align-items: center;
    height: 22px;
    padding-inline: 6px;
    border: 1px dashed #9aa7c2;
    border-radius: 4px;
    font-size: var(--fs-small);
    line-height: 1;
    font-weight: var(--fw-medium);
    color: var(--mist-600);
  }

  /* The dark Download block: full bar height, flush right. */
  .header-download {
    display: none;
    align-items: center;
    justify-content: center;
    align-self: stretch;
    width: var(--download-block-w);
    background: var(--navy-950);
    color: #ffffff;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    font-weight: var(--fw-medium);
    letter-spacing: -0.025em;
    text-decoration: none;
    transition: background-color var(--dur-hover) var(--ease-standard);
  }
  .header-download:hover {
    background: var(--navy-800);
    color: #ffffff;
  }
  .header-download:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -4px;
    border-radius: 0;
  }
  .site-nav__download {
    display: none;
  }

  /* ---------- Menu button (below 1024) ---------- */
  .menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: 14px;
    color: var(--ink);
    border-radius: var(--radius-sm);
  }
  .menu-toggle:hover {
    background: rgb(11 20 48 / 0.05);
  }
  .menu-toggle__close,
  .menu-toggle[aria-expanded="true"] .menu-toggle__open {
    display: none;
  }
  .menu-toggle[aria-expanded="true"] .menu-toggle__close {
    display: block;
  }

  @media (max-width: 1023.98px) {
    /* Without JS: the nav wraps into a row under the bar. */
    .site-nav {
      order: 3;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      column-gap: var(--space-6);
      flex-basis: 100%;
      padding: 0 var(--header-pad-x) var(--space-3) 0;
    }
    .site-nav__list {
      column-gap: var(--space-6);
    }
    .site-nav__download {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      font-weight: var(--fw-semibold);
      color: var(--ink);
    }

    /* With JS: a full-height panel under the bar. */
    :global(.js) .site-nav {
      display: none;
      position: fixed;
      top: calc(var(--header-h) + 1px);
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 49;
      flex-direction: column;
      flex-wrap: nowrap;
      align-items: stretch;
      padding: var(--space-2) 0 0;
      background: var(--mist-50);
      overflow-y: auto;
      overscroll-behavior: contain;
    }
    :global(.js) .site-header[data-menu-open] .site-nav {
      display: flex;
    }
    :global(.js) .site-nav__list {
      flex-direction: column;
      align-items: stretch;
      padding-inline: var(--header-pad-x);
    }
    :global(.js) .site-nav__list li {
      border-bottom: 1px solid var(--mist-300);
    }
    :global(.js) .site-nav__link {
      display: flex;
      width: 100%;
      min-height: 64px;
      font-family: var(--font-display);
      font-size: 1.5rem;
      line-height: 2rem;
      font-weight: var(--fw-medium);
      letter-spacing: 0;
      color: var(--ink);
    }
    :global(.js) .site-nav__link--soon {
      color: var(--mist-500);
    }
    :global(.js) .site-nav__download {
      display: flex;
      align-items: center;
      justify-content: center;
      flex: none;
      min-height: 64px;
      margin-top: auto;
      background: var(--navy-950);
      color: #ffffff;
      font-size: var(--fs-body);
      line-height: var(--lh-body);
      font-weight: var(--fw-semibold);
      text-decoration: none;
    }
    :global(.js) .site-nav__download:focus-visible {
      outline: 2px solid var(--accent);
      outline-offset: -4px;
      border-radius: 0;
    }
  }

  @media (min-width: 1024px) {
    .site-header {
      background: var(--mist-200);
    }
    .site-header__bar {
      flex-wrap: nowrap;
      align-items: stretch;
      height: var(--header-h);
    }
    .site-nav {
      display: flex;
      align-items: center;
      margin-right: 36px;
    }
    .header-download {
      display: flex;
    }
    .menu-toggle {
      display: none;
    }
  }
</style>

---
/*
 * Site header (DESIGN-SPEC section 6, with HERO-REVISION.md: bigger logo, one fixed size).
 * Behavior lives in src/scripts/nav.ts (a bundled module; no inline script).
 *
 * - ONE bar, ONE size, ONE shape: a full-width bar pinned to the top, --nav-h tall. Its height, width,
 *   position, padding, radius and logo size never change with scroll, on any page, at any width. There
 *   is no scrolled state (no shrink, no floating or inset bar, no logo scaling). --nav-h steps with the
 *   width only (tokens.css: 64 below 640, 68 from 640, 72 from 1024, 76 from 1536, 80 from 1920; F5).
 *   Body gets padding-top: var(--nav-h) (global.css), so the page never shifts (CLS 0).
 * - Row: the inline lockup (--lockup-h, half of --nav-h: 32 / 34 / 36 / 38 / 40px, the mark 36px at
 *   1024 to 1440 and 40px at 1920+, so the logo keeps its clear space of half the mark height above and
 *   below), then from 1024 the "Who it's for" menu,
 *   Security, Editions, Contact and Download; below 1024 the lockup, Download and the menu
 *   button. The nav links, the menu trigger and the menu button are all 44px and centered on the logo.
 *   The Download button matches AnythingLLM's: a big, flat, accent-blue block welded to the top-right
 *   corner, the full nav height with square corners, wide padding and a plain "Download" label (no icon),
 *   the most prominent control in the bar; it shows at every width (HERO-REVISION.md, F1).
 * - ONE constant color: the bar is a single solid near-white band (mist-50) at every scroll position and
 *   over every section (owner rule: the nav must not change color from section to section). It has a
 *   permanent bottom hairline and the constant nav shadow, so it stands apart over the dark navy hero
 *   (light on dark) and, via the hairline and shadow, over the light sections too. There is no
 *   per-section tone switch, no cross-fade and no scrolled state; the logo, links and text are the same
 *   navy on the light bar everywhere.
 * - The logo node: the ML mark carries exactly one node (the accent rhombus in the M's V, part of the
 *   lockup). It is static: there is no separate indicator, no rise-on-load and no slide to the links.
 * - Audience menu (from 1024): a white 560px panel 12px under the nav, five thumbnail rows and a
 *   footer row. Opens on click, on hover with a fine pointer, and with ArrowDown; arrows move between
 *   rows; Escape closes and returns focus; it closes when focus or a click leaves it.
 * - Sheet (below 1024): white, under the bar (which keeps its one light skin while it is open).
 *   One row style: "Who it's for" and "More". One column below 640 with Contact and Download pinned at
 *   the bottom; two columns from 640 with the buttons after the grid. Focus trap, Escape, scroll lock; a
 *   tap opens it without a focus ring on the first row, the keyboard focuses the first row.
 * - Without JS: the header is fixed only from 1024; below it the sheet is a normal block under the bar.
 *   The menu trigger is a link to /#product.
 * Data: NAV, AUDIENCE_MENU, AUDIENCES, SHEET_MORE, MENU_FOOT, DOWNLOAD_HREF in src/data/site.ts.
 */
import Lockup from "./brand/Lockup.astro";
import Mark from "./brand/Mark.astro";
import Icon from "./ui/Icon.astro";
import { NAV, AUDIENCE_MENU, AUDIENCES, SHEET_MORE, MENU_FOOT, DOWNLOAD_HREF, CONTACT_HREF, SITE, isPlaceholder } from "../data/site";

const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const isCurrent = (href: string) => !href.includes("#") && href !== "/" && path === href.replace(/\/$/, "");
const current = (href: string) => (isCurrent(href) ? "page" : undefined);
---

<header class="nav" data-nav>
  <div class="nav__bar" aria-hidden="true"></div>

  <div class="nav__row" data-nav-row>
    <a class="brand" href="/" aria-label={`${SITE.name} home`} data-align="edge:left" data-brand><Lockup /><Mark /></a>

    <nav class="nav__links" aria-label="Primary" data-links>
      <div class="menu-wrap" data-menu-wrap>
        <a class="nav__link nav__menu-link" href={AUDIENCE_MENU.href}>{AUDIENCE_MENU.label}</a>
        <button class="nav__link nav__menu-btn" type="button" aria-expanded="false" aria-controls="aud-menu" data-menu-trigger>
          {AUDIENCE_MENU.label}<Icon set="line" name="caret" size={16} />
        </button>
        <div class="menu" id="aud-menu" data-menu hidden>
          <ul class="menu__list" role="list">
            {
              AUDIENCES.map((a) => (
                <li>
                  <a class="menu__item" href={a.href}>
                    <span class="menu__thumb">
                      <img src={a.thumb} width="100" height="75" alt="" loading="lazy" decoding="async" />
                    </span>
                    <span>
                      <span class="menu__title">{a.title}</span>
                      <span class="menu__desc">{a.desc}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
          <p class="menu__foot">
            <span>{MENU_FOOT.text}</span>
            <a class="arrow" href={MENU_FOOT.link.href}><span>{MENU_FOOT.link.label}</span><Icon set="line" name="arrow" size={18} /></a>
          </p>
        </div>
      </div>
      {
        NAV.map((item) =>
          isPlaceholder(item.href) ? (
            /* TODO: becomes a link when the destination exists (see src/data/site.ts). */
            <span class="nav__link nav__link--soon" aria-disabled="true" data-todo={item.todo}>
              {item.label}
            </span>
          ) : (
            <a class="nav__link" href={item.href} aria-current={current(item.href)}>
              {item.label}
            </a>
          ),
        )
      }
    </nav>

    <a class="btn nav__cta" href={DOWNLOAD_HREF} aria-current={current(DOWNLOAD_HREF)}>
      Download
    </a>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-controls="sheet" aria-label="Open menu" data-sheet-toggle>
      <Icon set="line" name="menu" size={22} class="i-open" />
      <Icon set="line" name="close" size={22} class="i-close" />
    </button>
  </div>

  <nav class="sheet" id="sheet" aria-label="Primary" data-sheet>
    <p class="sheet__label" id="sheet-audiences">{AUDIENCE_MENU.label}</p>
    <ul class="sheet__grid" role="list" aria-labelledby="sheet-audiences">
      {
        AUDIENCES.map((a) => (
          <li>
            <a class="menu__item" href={a.href}>
              <span class="menu__thumb">
                <img src={a.thumb} width="100" height="75" alt="" loading="lazy" decoding="async" />
              </span>
              <span>
                <span class="menu__title">{a.title}</span>
                <span class="menu__desc">{a.sheet ?? a.desc}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="sheet__label" id="sheet-more">More</p>
    <ul class="sheet__grid" role="list" aria-labelledby="sheet-more">
      {
        SHEET_MORE.map((m) => (
          <li>
            <a class="menu__item" href={m.href} aria-current={current(m.href)}>
              <span class="menu__thumb">
                <img src={m.thumb} width="100" height="75" alt="" loading="lazy" decoding="async" />
              </span>
              <span>
                <span class="menu__title">{m.title}</span>
                <span class="menu__desc">{m.desc}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
    <div class="sheet__actions" data-row="sheet-actions">
      <a class="btn btn--secondary" href={CONTACT_HREF} aria-current={current(CONTACT_HREF)}>Contact</a>
      <a class="btn btn--primary" href={DOWNLOAD_HREF} aria-current={current(DOWNLOAD_HREF)}>
        <Icon set="line" name="download" size={20} />Download
      </a>
    </div>
  </nav>
</header>

<script>
  import "../scripts/nav.ts";
</script>

<style>
  /* ---------- The bar: one size, one shape; only the surface tone changes ---------- */
  .nav {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 50;
    height: var(--nav-h);
    /* ONE constant skin at every scroll position and over every section (owner: the nav must not change
       color from section to section). A single solid near-white bar (.nav__bar) with a permanent hairline
       and shadow, so it stands out over the dark hero and, via the shadow, over light sections too. There
       is no per-section tone switch and no scrolled state. */
    --nav-fg: var(--mist-700); /* 9.91:1 on mist-50 */
    --nav-fg-strong: var(--navy-950);
    --nav-ring: rgb(7 15 38 / 0.2);
    --nav-focus: var(--blue-500);
    --lk-ink: var(--navy-950);
    --lk-acc: var(--blue-500);
    /* The Download control: a solid ACCENT-BLUE button on EVERY nav skin (HERO-REVISION.md, F1), so it
       never blends into the navy hero or any dark band and is the single most prominent control in the
       bar. The surface is the accent blue-500 (#2B63E0): 3.59:1 against the navy hero (pops well past
       3:1) and 5.06:1 against the light ground, so it reads as a distinct blue button on both skins. Its
       label is white at AA (5.30:1 on the accent). It never turns navy or translucent, and it stays this
       size and style while scrolling; only the surrounding skin tone cross-fades. (#5B95FF would pop
       harder against navy but drops the white label to 2.9:1, below AA, so blue-500 is used to keep the
       white label accessible while still clearly popping.) A subtle raised finish: a 1px top inset
       highlight and a soft accent-tinted shadow. */
    --cta-bg: var(--blue-500);
    --cta-fg: #ffffff;
    --cta-bg-hover: var(--blue-600);
    --cta-shadow: inset 0 1px 0 rgb(255 255 255 / 0.24), 0 8px 18px -10px rgb(43 99 224 / 0.6), 0 1px 2px rgb(7 15 38 / 0.28);
  }
  /* The bar surface: one solid near-white band with a permanent bottom hairline and the nav shadow, the
     same at every scroll position and over every section. It never shows the page through it, never
     cross-fades, and never changes color; it stands apart over the dark hero (light on dark) and, via the
     hairline and shadow, over light sections too. */
  .nav__bar {
    position: absolute;
    inset: 0 0 auto 0;
    height: var(--nav-h);
    background: var(--mist-50);
    box-shadow:
      inset 0 -1px 0 rgb(7 15 38 / 0.14),
      var(--shadow-nav);
    pointer-events: none;
  }

  .nav__row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    height: var(--nav-h);
    width: var(--wrap);
    margin-inline: auto;
  }
  /* The lockup is --lockup-h tall (half of --nav-h), so it keeps half its height clear above and
     below; the link adds no size of its own. */
  .brand {
    display: inline-flex;
    align-items: center;
    flex: none;
    margin-right: auto;
    border-radius: 6px;
    text-decoration: none;
  }
  .brand:focus-visible {
    outline-color: var(--nav-focus);
    outline-offset: 4px;
  }
  .brand :global(.lockup) {
    height: var(--lockup-h);
  }
  /* On narrow phones the full lockup, the Download button and the menu button do not all fit, so the
     lockup collapses to the ML mark. This keeps the big accent Download button in the bar at every
     width (HERO-REVISION.md, F1) while the menu button stays usable. */
  .brand :global(.mark) {
    display: none;
    height: var(--lockup-h);
    width: auto;
  }
  @media (max-width: 519.98px) {
    .brand :global(.lockup) {
      display: none;
    }
    .brand :global(.mark) {
      display: block;
    }
  }
  .nav__links {
    display: none;
  }
  /* The Download button shows on every width, including phones, so it is always the most prominent
     control in the bar (HERO-REVISION.md, F1). It is only hidden while the sheet is open. */
  .nav__cta {
    display: inline-flex;
  }
  .nav__toggle {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-control);
    color: var(--nav-fg-strong);
    box-shadow: inset 0 0 0 1px var(--nav-ring);
    transition:
      color var(--t-tone) var(--ease),
      box-shadow var(--t-tone) var(--ease);
  }
  :global(.js) .nav__toggle {
    display: inline-grid;
  }
  .nav__toggle :global(.i-close),
  .nav__toggle[aria-expanded="true"] :global(.i-open) {
    display: none;
  }
  .nav__toggle[aria-expanded="true"] :global(.i-close) {
    display: block;
  }
  .nav__toggle:focus-visible,
  .nav__cta:focus-visible {
    outline-color: var(--nav-focus);
  }
  .nav[data-sheet-open] .nav__cta {
    visibility: hidden;
  }
  /* The Download control, matched to AnythingLLM's header Download button: a big, flat, solid block that
     fills the FULL nav height, welded to the top-right corner, with square corners (no radius), wide side
     padding and a plain "Download" label (no icon). Ours keeps the accent blue (--cta-*) so it pops on the
     light bar without reading as the navy hero color (AnythingLLM's is near-black on their light nav - the
     same dark-on-light contrast). Flat: no shadow, no raised finish. It never changes size or shape with
     scroll. */
  .nav__cta {
    align-self: stretch;
    min-height: var(--nav-h);
    padding-inline: clamp(22px, 2.2vw, 40px);
    border-radius: 0;
    font-size: 16px;
    font-weight: var(--fw-medium);
    background: var(--cta-bg);
    color: var(--cta-fg);
    box-shadow: none;
    transition: background-color var(--t-fast) var(--ease);
  }
  @media (hover: hover) {
    .nav__cta:hover {
      background: var(--cta-bg-hover);
      color: var(--cta-fg);
    }
  }

  @media (min-width: 1024px) {
    /* The row is the content wrap, centered, so the Download button keeps a normal right gutter (it does
       not weld into the window's top-right corner). The logo hugs the wrap's left edge, the Download its
       right, the links between. */
    .nav__row {
      width: var(--wrap);
      margin-inline: auto;
      padding-inline: 0;
    }
    .nav__links {
      position: relative;
      display: flex;
      align-items: center;
      gap: clamp(0rem, -0.5rem + 1vw, 0.75rem);
    }
    /* Desktop Download: welded to the top-right corner of the bar, spanning the full nav height with
       square corners and wide padding, exactly like AnythingLLM's header Download button. It is the last
       item in the row, so it sits flush to the wrap's right edge (a gutter from the window edge). */
    .nav__cta {
      margin-left: clamp(0.75rem, -0.5rem + 1.8vw, 1.5rem);
      padding-inline: clamp(32px, 2.6vw, 50px);
    }
    :global(.js) .nav__toggle {
      display: none;
    }
  }

  /* ---------- Links ---------- */
  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    height: 44px;
    padding-inline: 12px;
    border-radius: 8px;
    font: var(--fw-medium) var(--fs-ui) / 1 var(--font-sans);
    color: var(--nav-fg);
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--t-tone) var(--ease);
  }
  .nav__link :global(svg) {
    width: 16px;
    height: 16px;
    transition: transform var(--t-ui) var(--ease);
  }
  .nav__link[aria-expanded="true"] :global(svg) {
    transform: rotate(180deg);
  }
  .nav__link[aria-current="page"],
  .nav__link[aria-expanded="true"] {
    color: var(--nav-fg-strong);
  }
  @media (hover: hover) {
    .nav__link:hover {
      color: var(--nav-fg-strong);
    }
  }
  .nav__link:focus-visible {
    outline-color: var(--nav-focus);
    outline-offset: 0;
    border-radius: 8px;
  }
  .nav__link--soon {
    cursor: default;
  }
  /* Without JS the trigger is a link to the audience section; with JS it is the menu button. */
  .nav__menu-btn {
    display: none;
  }
  :global(.js) .nav__menu-btn {
    display: inline-flex;
  }
  :global(.js) .nav__menu-link {
    display: none;
  }

  /* ---------- Audience menu (desktop) and the shared menu row ---------- */
  .menu-wrap {
    position: relative;
  }
  .menu {
    position: absolute;
    top: calc(100% + (var(--nav-h) - 44px) / 2 + 12px);
    left: calc(-12px + var(--menu-shift, 0px));
    width: min(35rem, calc(100vw - 2 * var(--gutter)));
    max-height: calc(var(--view-h) - 1.5rem);
    overflow: auto;
    overscroll-behavior: contain;
    padding: 8px;
    border-radius: var(--r-card);
    background: #ffffff;
    color: var(--mist-800);
    box-shadow: var(--shadow-pop);
    transform-origin: 40px 0;
    opacity: 0;
    transform: translateY(-4px) scale(0.98);
    visibility: hidden;
    transition:
      opacity 180ms var(--ease),
      transform 180ms var(--ease),
      visibility 0s linear 180ms;
  }
  .menu[data-open] {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition:
      opacity 180ms var(--ease),
      transform 180ms var(--ease),
      visibility 0s;
  }
  .menu__list {
    display: grid;
    gap: 2px;
  }
  .menu__item {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    align-items: center;
    gap: 16px;
    padding: 10px 12px 10px 10px;
    border-radius: 12px;
    color: inherit;
    text-decoration: none;
    transition: background-color var(--t-fast) var(--ease);
  }
  .menu__item:hover,
  .menu__item:focus-visible {
    background: var(--mist-100);
  }
  .menu__item:focus-visible {
    outline-color: var(--blue-500);
    outline-offset: -2px;
  }
  /* Whole drawings in tight 4:3 boxes with 6px of air, strokes held at 1px (public/images/menu). */
  .menu__thumb {
    display: block;
    height: 5.25rem;
    padding: 6px;
    border-radius: 10px;
    background: var(--mist-50);
    box-shadow: inset 0 0 0 1px rgb(7 15 38 / 0.08);
  }
  .menu__thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .menu__title {
    display: block;
    font-weight: var(--fw-semibold);
    font-size: 1.0625rem;
    line-height: 1.35;
    color: var(--navy-950);
  }
  .menu__desc {
    display: block;
    margin-top: 2px;
    font-size: 1rem;
    line-height: 1.45;
    color: var(--mist-600);
  }
  .menu__item[aria-current="page"] .menu__title::after {
    content: "";
    display: inline-block;
    width: 7px;
    height: 7px;
    margin: 0 0 2px 10px;
    background: var(--blue-500);
    transform: rotate(45deg);
  }
  .menu__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 16px;
    margin-top: 6px;
    padding: 12px 12px 6px;
    border-top: 1px solid rgb(7 15 38 / 0.1);
    font-size: 1rem;
    color: var(--mist-600);
  }
  .menu__foot .arrow {
    color: var(--navy-950);
  }
  .menu__foot .arrow:focus-visible {
    outline-color: var(--blue-500);
  }

  /* ---------- Sheet (below 1024) ---------- */
  .sheet {
    display: flex;
    flex-direction: column;
    padding: 8px var(--gutter) calc(16px + env(safe-area-inset-bottom));
    background: #ffffff;
    color: var(--mist-800);
  }
  /* With JS it is a fixed panel under the bar; without JS it is a normal block under the bar. */
  :global(.js) .sheet {
    position: fixed;
    top: var(--nav-h);
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 49;
    overflow-y: auto;
    overscroll-behavior: contain;
    opacity: 0;
    transform: translateY(-8px);
    visibility: hidden;
    transition:
      opacity var(--t-ui) var(--ease),
      transform var(--t-ui) var(--ease),
      visibility 0s linear var(--t-ui);
  }
  :global(.js) .sheet[data-open] {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition:
      opacity var(--t-ui) var(--ease),
      transform var(--t-ui) var(--ease),
      visibility 0s;
  }
  .sheet:focus {
    outline: none;
  }
  .sheet__label {
    padding: 14px 0 6px;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--mist-500);
  }
  .sheet__grid {
    display: grid;
    gap: 2px;
    margin-inline: -10px;
  }
  .sheet .menu__item {
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 14px;
    align-items: start;
  }
  .sheet .menu__thumb {
    height: 4.125rem;
  }
  .sheet__actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: auto;
    padding-top: 24px;
  }
  .sheet__actions .btn {
    width: 100%;
  }
  .sheet__actions .btn--secondary {
    color: var(--navy-950);
    box-shadow: inset 0 0 0 1px rgb(7 15 38 / 0.2);
  }
  .sheet__actions .btn:focus-visible {
    outline-color: var(--blue-500);
  }
  @media (min-width: 640px) {
    .sheet__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 6px 16px;
    }
    .sheet .menu__item {
      grid-template-columns: 7rem minmax(0, 1fr);
      gap: 16px;
    }
    .sheet .menu__thumb {
      height: 5.25rem;
    }
    /* Tablets: the actions follow the grid instead of pinning to the bottom. */
    .sheet__actions {
      margin-top: 32px;
    }
  }
  @media (min-width: 1024px) {
    .sheet {
      display: none;
    }
  }
  /* Without JS, below 1024: the bar is not fixed and the sheet flows under it. */
  @media (max-width: 1023.98px) {
    :global(html:not(.js)) .nav {
      position: relative;
      height: auto;
    }
    :global(html:not(.js)) .sheet {
      padding-bottom: 24px;
      border-bottom: 1px solid var(--color-line);
    }
    :global(html:not(.js)) .sheet__actions {
      margin-top: 24px;
      padding-top: 0;
    }
  }
  :global(html.menu-lock) {
    overflow: hidden;
  }
</style>

---
/*
 * Site footer (DESIGN-SPEC sections 5, 10 and 11), content in .wrap.
 * - tone: the footer's full-bleed ground, set per page by Base's footerTone prop (default "dark").
 *   The whole-page rule (HERO-REVISION.md, third pass) is that no two adjacent bands share a tone, so
 *   the footer is the opposite of each page's last content section: DARK after a page that closes on a
 *   light section (security, editions, download, contact), LIGHT after a page that closes on a dark
 *   section (home's Final CTA, the 404). Every semantic token is remapped by data-tone, so the footer's
 *   own type, links and hairline adapt with the ground; the nav's opposite-tone rule sees whichever
 *   tone is set and skins itself accordingly.
 * - Top: the inline lockup (--lockup-h-footer, 30 to 35px) and the descriptor, then four link columns
 *   (15px uppercase titles, --fs-ui links). Two columns on phones, four from 768; from 1280 the lockup
 *   takes columns 1 to 4 and the link columns 5 to 12.
 * - Fine print (16px, both lines required on every page): the upstream MIT credit and the
 *   non-affiliation line. The owner has not decided to remove the non-affiliation line; keep it.
 * - Bottom row: the copyright left, Privacy and Terms right.
 * Entries whose destination is still a TODO ("#" in src/data/site.ts) render as plain text, not as
 * links (check:copy lists them); they become links when the destination exists.
 */
import Lockup from "./brand/Lockup.astro";
import { FOOTER, FOOTER_LEGAL, FOOTER_DESCRIPTOR, UPSTREAM, NON_AFFILIATION, COPYRIGHT, SITE, isPlaceholder } from "../data/site";

interface Props {
  tone?: "light" | "dark";
}
const { tone = "dark" } = Astro.props;
---

<footer class="footer" data-tone={tone === "dark" ? "dark" : "light"}>
  <div class="wrap">
    <div class="footer__top">
      <div class="footer__brand">
        <a class="footer__lockup" href="/" aria-label={`${SITE.name} home`} data-align="edge:left"><Lockup /></a>
        <p>{FOOTER_DESCRIPTOR}</p>
      </div>
      <nav class="footer__cols" aria-label="Footer">
        {
          FOOTER.map((col) => (
            <div>
              <h2>{col.title}</h2>
              <ul role="list">
                {col.links.map((link) => (
                  <li>
                    {isPlaceholder(link.href) ? (
                      <span class="footer__soon" aria-disabled="true" data-todo={link.todo}>
                        {link.label}
                        <span class="sr-only">(coming soon)</span>
                      </span>
                    ) : (
                      <a href={link.href} rel={link.href.startsWith("http") ? "noopener" : undefined}>
                        {link.label}
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <div class="footer__fine">
      <p>{UPSTREAM.credit}</p>
      <p>{NON_AFFILIATION}</p>
    </div>

    <div class="footer__bottom">
      <p class="tnum">{COPYRIGHT}</p>
      <ul role="list">
        {
          FOOTER_LEGAL.map((link) => (
            <li>
              {isPlaceholder(link.href) ? (
                <span class="footer__soon" aria-disabled="true" data-todo={link.todo}>
                  {link.label}
                  <span class="sr-only">(coming soon)</span>
                </span>
              ) : (
                <a href={link.href}>{link.label}</a>
              )}
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(3rem, 1.5rem + 4svh + 1vw, 6rem) 28px;
    /* A hairline seam at the footer's top edge. The footer tone is always the opposite of the section
       above it (Base's footerTone prop), so the edge is already a crisp dark-to-light boundary; the
       hairline in --color-line (which the tone remaps) just sharpens it in both directions. */
    border-top: 1px solid var(--color-line);
  }
  .footer__top {
    display: grid;
    gap: 40px var(--col-gap);
  }
  .footer__lockup {
    display: inline-flex;
    border-radius: 6px;
    text-decoration: none;
  }
  .footer__lockup :global(.lockup) {
    height: var(--lockup-h-footer);
  }
  .footer__lockup:focus-visible {
    outline-offset: 4px;
  }
  .footer__brand p {
    margin-top: 16px;
    max-width: 24rem;
    color: var(--color-text-muted);
  }
  .footer__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px var(--col-gap);
  }
  .footer__cols h2 {
    font: var(--fw-semibold) var(--fs-small) / var(--lh-small) var(--font-sans);
    letter-spacing: var(--ls-caps);
    text-transform: uppercase;
    color: var(--color-text-quiet);
  }
  .footer__cols ul {
    display: grid;
    gap: 2px;
    margin-top: 12px;
  }
  .footer__cols a,
  .footer__cols .footer__soon {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    font-size: var(--fs-ui);
    line-height: 1.35;
    color: var(--color-text);
    text-decoration: none;
  }
  .footer__cols a:hover {
    color: var(--color-heading);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
  }
  .footer__soon {
    color: var(--color-text-muted);
  }
  /* Each line balanced, so the non-affiliation sentence never leaves "Space Force." alone. */
  .footer__fine {
    display: grid;
    gap: 4px;
    margin-top: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding-top: 24px;
    border-top: 1px solid var(--color-line);
    font-size: 1rem;
    line-height: 1.6;
    color: var(--color-text-quiet);
  }
  .footer__fine p {
    max-width: 56rem;
    text-wrap: balance;
  }
  .footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 32px;
    margin-top: 20px;
    font-size: var(--fs-small);
    line-height: var(--lh-small);
    color: var(--color-text-muted);
  }
  .footer__bottom ul {
    display: flex;
    gap: 28px;
  }
  .footer__bottom a,
  .footer__bottom .footer__soon {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    color: var(--color-text);
    text-decoration: none;
  }
  .footer__bottom a:hover {
    text-decoration: underline;
  }
  @media (min-width: 768px) {
    .footer__cols {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
  @media (min-width: 1280px) {
    .footer__top {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }
    .footer__brand {
      grid-column: 1 / span 4;
    }
    .footer__cols {
      grid-column: 5 / -1;
    }
  }
</style>

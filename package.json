{
  "name": "mission-llm-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mission LLM public product website. Standalone static site; shares no code with the Mission LLM application.",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "images": "node scripts/build-images.mjs",
    "dev": "npm run images && astro dev",
    "build": "npm run images && astro build && node scripts/prune-dist.mjs",
    "preview": "astro preview",
    "check:copy": "node scripts/check-copy.mjs"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "sharp": "^0.35.4"
  }
}
